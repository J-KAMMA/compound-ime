+// Keep only the current line and prevent document text from inserting Zenz control tags.
+// These windows match the model's default 40-character context limit.
+func conversionContext(_ text: String, left: Bool) -> String {
+    let lines = text.components(separatedBy: .newlines)
+    let line = left ? (lines.last ?? "") : (lines.first ?? "")
+    let clean = String(line.unicodeScalars.filter { !(0xEE00...0xEE08).contains($0.value) })
+    return left ? String(clean.suffix(40)) : String(clean.prefix(40))
+}
+
+/// Stateless context API: context belongs to this request and is never stored in config.
+@_cdecl("ConvertTextWithContext")
+public func convertTextWithContext(
+    _ key: UnsafePointer<CChar>?,
+    _ leftContext: UnsafePointer<CChar>?,
+    _ rightContext: UnsafePointer<CChar>?,
+    _ allowLearning: Int32
+) -> UnsafePointer<CChar>? {
+    guard let key = key else { return nil }
+    let keyString = String(cString: key)
+
+    engineLock.lock()
+    defer { engineLock.unlock() }
+
+    guard let conv = converter else { return nil }
+
+    var text = ComposingText()
+    // Use .direct for hiragana input from Mozc (not roman2kana)
+    text.insertAtCursorPosition(keyString, inputStyle: .direct)
+
+    let left = conversionContext(leftContext.map { String(cString: $0) } ?? "", left: true)
+    let right = conversionContext(rightContext.map { String(cString: $0) } ?? "", left: false)
+    var options = getOptions(allowLearning: allowLearning != 0, leftContext: left, rightContext: right)
+    // The neural context is 512 tokens. Long readings retain dictionary conversion in full.
+    // Reserve space for the reading, output, context and model control tokens.
+    if keyString.unicodeScalars.count > 128 {
+        options.zenzaiMode = .off
+    }
+    // A single-shot request starts a new composition even when the reading is unchanged.
+    // Dictionary learning and model memoization remain owned by the converter.
+    conv.stopComposition()
+    let result = conv.requestCandidates(text, options: options)
+    composingText = text
+    currentCandidates = result.mainResults
+    currentTypoCandidates = makeTypoCandidates(for: keyString, existingCandidates: currentCandidates)
+
+    return candidatesJson()
+}
+
+@_cdecl("AppendText")
