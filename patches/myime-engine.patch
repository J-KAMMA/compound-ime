+@_cdecl("Shutdown")
+public func shutdown() {
+    engineLock.lock()
+    defer { engineLock.unlock() }
+
+    initCount = max(0, initCount - 1)
+    if initCount == 0 {
+        converter = nil
+        typoConverter = nil
+        composingText = ComposingText()
+        currentCandidates = []
+        currentTypoCandidates = []
+        cachedTextReplacer = nil
+        zenzaiWarmUpStarted = false
+    }
+}
