+    public func zenzaiModelStatus(modelURL: URL, useGpu: Bool) -> (loaded: Bool, error: String?) {
+        let loaded = self.zenz.map { $0.resourceURL == modelURL && $0.useGpu == useGpu } ?? false
+        let error = self.zenzaiModelLoadError.flatMap {
+            $0.modelURL == modelURL && $0.useGpu == useGpu ? $0.message : nil
+        }
+        return (loaded, error)
+    }
+
+    package func getModel(modelURL: URL, useGpu: Bool = false) -> Zenz? {
+        if let model = self.zenz, model.resourceURL == modelURL, model.useGpu == useGpu {
+            self.zenzaiModelLoadError = nil
+            self.zenzStatus = "load \(modelURL.absoluteString)"
+            return model
+        } else {
+            do {
+                self.zenz = try Zenz.shared(resourceURL: modelURL, useGpu: useGpu)
+                self.zenzaiModelLoadError = nil
+                self.purgeZenzaiMemoizationCache()
+                self.sessions = self.sessions.mapValues { state in
+                    let next = state
+                    next.zenzaiTypoCache.invalidateForModelChange()
+                    return next
+                }
+                self.zenzStatus = "load \(modelURL.absoluteString)"
+                return self.zenz
+            } catch {
+                self.zenzaiModelLoadError = (modelURL, useGpu, error.localizedDescription)
+                self.zenzStatus = "load \(modelURL.absoluteString)    " + error.localizedDescription
+                return nil
+            }
+        }
+    }
