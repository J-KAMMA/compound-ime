+func consumedInputPrefix(_ count: ComposingCount, input: ComposingText) -> String? {
+    func complete(_ count: ComposingCount, text: inout ComposingText) -> Bool {
+        switch count {
+        case .inputCount(let size):
+            guard size >= 0, size <= text.input.count else { return false }
+        case .surfaceCount(let size):
+            guard size >= 0, size <= text.convertTarget.count else { return false }
