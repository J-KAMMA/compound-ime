index 0000000..ef7d484
--- /dev/null
+++ b/src/swift-engine/Tests/AzookeyEngineTests/CandidateMetadataTests.swift
@@ -0,0 +1,106 @@
+import XCTest
+import KanaKanjiConverterModuleWithDefaultDictionary
+@testable import azookey_engine
+
+final class CandidateMetadataTests: XCTestCase {
+    private func input(_ text: String, style: InputStyle = .direct) -> ComposingText {
+        var input = ComposingText()
+        input.insertAtCursorPosition(text, inputStyle: style)
+        return input
+    }
+    private func word(_ value: String, _ ruby: String, cid: Int = 1285) -> DicdataElement {
+        DicdataElement(word: value, ruby: ruby, cid: cid, mid: 501, value: -5)
+    }
+    private func candidate(_ data: [DicdataElement], text: String? = nil,
+                           count: ComposingCount = .surfaceCount(1)) -> Candidate {
+        Candidate(text: text ?? data.map(\.word).joined(), value: -5,
+                  composingCount: count, lastMid: 501, data: data)
+    }
+    func testConsumptionUsesInputSurfaceAndCompositeUnits() {
+        let original = input("わたしは")
+        XCTAssertEqual(consumedInputPrefix(.inputCount(2), input: original), "わた")
+        XCTAssertEqual(consumedInputPrefix(.surfaceCount(3), input: original), "わたし")
+        XCTAssertEqual(consumedInputPrefix(.composite(lhs: .inputCount(1), rhs: .surfaceCount(2)), input: original), "わたし")
+        XCTAssertEqual(original.convertTarget, "わたしは")
+        for count: ComposingCount in [.inputCount(0), .inputCount(-1), .surfaceCount(-1),
+                                      .inputCount(Int.max), .surfaceCount(5),
+                                      .composite(lhs: .inputCount(3), rhs: .surfaceCount(2))] {
+            XCTAssertNil(consumedInputPrefix(count, input: original))
+        }
+    }
+    func testConsumptionPreservesCombiningAndZWJBytes() {
+        let first = "か\u{3099}"
+        let family = "👩‍👩‍👧‍👦"
+        let original = input(first + family + "あ")
+        XCTAssertEqual(original.convertTarget.count, 3)
+        XCTAssertEqual(consumedInputPrefix(.surfaceCount(1), input: original)?.utf8.map { $0 }, Array(first.utf8))
+        XCTAssertEqual(consumedInputPrefix(.inputCount(2), input: original)?.utf8.map { $0 }, Array((first + family).utf8))
+        XCTAssertEqual(consumedInputPrefix(.composite(lhs: .surfaceCount(1), rhs: .inputCount(1)), input: original), first + family)
+    }
+    func testChangedRemainderIsNotReportedAsAnOriginalPrefix() {
+        let original = input("ka", style: .roman2kana)
+        XCTAssertEqual(original.convertTarget, "か")
+        XCTAssertNil(consumedInputPrefix(.inputCount(1), input: original))
+        XCTAssertEqual(consumedInputPrefix(.inputCount(2), input: original), "か")
+    }
+    func testPredictionReadingAndPartialConsumptionAreSeparate() {
+        let prediction = candidate([word("東京", "トウキョウ")], count: .surfaceCount(2))
+        let object = candidateJsonObject(prediction, input: input("とう"))
+        XCTAssertEqual(object["text"] as? String, "東京")
+        XCTAssertEqual(object["correspondingCount"] as? Int, 5)
+        XCTAssertEqual(object["reading"] as? String, "とうきょう")
+        XCTAssertEqual(object["consumedKey"] as? String, "とう")
+        let partial = candidate([word("私", "ワタシ")], count: .surfaceCount(3))
+        XCTAssertEqual(candidateJsonObject(partial, input: input("わたしは"))["consumedKey"] as? String, "わたし")
+    }
+    func testActualClausesAndTrailingFunctionWords() {
+        let data = [word("お", "オ", cid: 6), word("茶", "チャ"), word("を", "ヲ", cid: 54),
+                    word("飲み", "ノミ"), word("ます", "マス", cid: 54)]
+        let segments = candidateSegments(candidate(data))
+        XCTAssertEqual(segments, [
+            ["key": "おちゃを", "value": "お茶を", "contentKey": "おちゃ", "contentValue": "お茶"],
+            ["key": "のみます", "value": "飲みます", "contentKey": "のみ", "contentValue": "飲み"]])
+        let post = candidate([word("を", "ヲ", cid: 54), word("ます", "マス", cid: 54)])
+        XCTAssertEqual(candidateSegments(post)?.first?["contentKey"], "をます")
+        XCTAssertEqual(candidateSegments(post)?.first?["contentValue"], "をます")
+        let asymmetric = DicdataElement(word: "語", ruby: "ゴ", lcid: 54, rcid: 1285, mid: 501, value: -5)
+        let mixed = candidate([asymmetric, word("を", "ヲ", cid: 54)])
+        XCTAssertEqual(candidateSegments(mixed)?.first?["contentValue"], "語")
+    }
+    func testInvalidCIDAndTemplateMismatchOmitOnlySegments() {
+        for cid in [-1, DicdataStore.wordTypes.count, Int.max] {
+            let object = candidateJsonObject(candidate([word("日付", "ヒヅケ", cid: cid)], count: .surfaceCount(3)), input: input("ひづけ"))
+            XCTAssertNil(object["segments"])
+            XCTAssertEqual(object["reading"] as? String, "ひづけ")
+            XCTAssertEqual(object["consumedKey"] as? String, "ひづけ")
+        }
+        let templated = candidate([word("<date>", "ヒヅケ")], text: "2026", count: .surfaceCount(3))
+        let object = candidateJsonObject(templated, input: input("ひづけ"))
+        XCTAssertNil(object["segments"])
+        XCTAssertEqual(object["text"] as? String, "2026")
+        XCTAssertEqual(object["reading"] as? String, "ひづけ")
+        XCTAssertEqual(object["consumedKey"] as? String, "ひづけ")
+        XCTAssertNil(candidateSegments(candidate([])))
+    }
+    func testMetadataNeverTruncatesAtMozcBoundaryByteWidth() {
+        for value in [String(repeating: "あ", count: 85), String(repeating: "あ", count: 85) + "x"] {
+            let object = candidateJsonObject(candidate([word(value, value)], count: .surfaceCount(value.count)), input: input(value))
+            let segments = object["segments"] as? [[String: String]]
+            XCTAssertEqual(segments?.first?["key"]?.utf8.count, value.utf8.count)
+            XCTAssertEqual(segments?.first?["value"]?.utf8.count, value.utf8.count)
+            XCTAssertEqual(object["consumedKey"] as? String, value)
+            // The consumer owns its <=255-byte boundary fallback; producer preserves data.
+        }
+    }
+    func testTypoUsesOriginalFullInputAndPreservesLegacyFields() {
+        let typo = TypoCandidate(text: "学校", value: -5, correspondingCount: 3, correctedReading: "ガッコウ")
+        let object = typoCandidateJsonObject(typo, input: input("がこう"))
+        XCTAssertEqual(object["text"] as? String, "学校")
+        XCTAssertEqual(object["correspondingCount"] as? Int, 3)
+        XCTAssertEqual(object["typoCorrected"] as? Bool, true)
+        XCTAssertEqual(object["correctedReading"] as? String, "ガッコウ")
+        XCTAssertEqual(object["reading"] as? String, "がっこう")
+        XCTAssertEqual(object["consumedKey"] as? String, "がこう")
+        XCTAssertNil(object["segments"])
+    }
+}
