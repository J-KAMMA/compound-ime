+    // 負数や0で Range 生成の fatalError を起こさないよう防御（C ABI 越しの外部入力）
+    guard count > 0 else { return }
+    engineLock.lock()
+    defer { engineLock.unlock() }
+    composingText.deleteBackwardFromCursorPosition(count: Int(count))
+}
