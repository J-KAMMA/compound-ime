+// moving to an adjacent region cannot change the context range itself.
+HRESULT ExpandFollowingRange(ITfRange* range, TfEditCookie cookie) {
+  const TF_HALTCOND halt = {nullptr, TF_ANCHOR_START, TF_HF_OBJECT};
+  for (int i = 0; i < kMaxSurroundingLength; ++i) {
+    wil::com_ptr_nothrow<ITfRange> probe;
+    HRESULT hr = range->Clone(&probe);
+    if (FAILED(hr)) return hr;
+    BOOL no_region = FALSE;
+    hr = probe->ShiftEndRegion(cookie, TF_SD_FORWARD, &no_region);
+    if (FAILED(hr) || !no_region) return hr;
+    LONG shifted = 0;
+    hr = range->ShiftEnd(cookie, 1, &shifted, &halt);
+    if (FAILED(hr) || shifted == 0) return hr;
+  }
+  return S_OK;
+}
