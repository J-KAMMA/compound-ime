+// Copyright 2026 MyIME Project.
+// All rights reserved.
+#ifndef MOZC_CONVERTER_AZOOKEY_ASYNC_CONVERTER_H_
+#define MOZC_CONVERTER_AZOOKEY_ASYNC_CONVERTER_H_
+#include <condition_variable>
+#include <cstdint>
+#include <memory>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <thread>
+#include "converter/azookey_immutable_converter.h"
+
+namespace mozc {
+struct AzooKeyAsyncRequest {
+  std::string key, left_context, right_context;
+};
+struct AzooKeyAsyncResult {
+  uint64_t id;
+  // Failure has no segments. Results are owned by the receiving thread.
+  std::unique_ptr<Segments> segments;
+};
+// One active conversion, one replaceable pending request, one completed result.
+// The converter is exclusively owned and used on the worker; callers must not
+// race object destruction. Cancel does not wait or abort an in-flight DLL call.
+class AzooKeyAsyncConverter final {
+ public:
+  explicit AzooKeyAsyncConverter(
+      std::unique_ptr<const ImmutableConverterInterface> converter);
+  AzooKeyAsyncConverter(
+      std::unique_ptr<const ImmutableConverterInterface> converter,
+      uint64_t last_issued_token);
+  ~AzooKeyAsyncConverter();
+  AzooKeyAsyncConverter(const AzooKeyAsyncConverter&) = delete;
+  AzooKeyAsyncConverter& operator=(const AzooKeyAsyncConverter&) = delete;
+  // Token scope is this worker's lifetime. Zero rejects invalid input or ID
+  // exhaustion without replacing the current request. Normal conversion only,
+  // <=128 UTF-8 scalars; context fields <=1 MiB, valid UTF-8 and no NUL.
+  uint64_t Submit(AzooKeyAsyncRequest request);
+  void Cancel();
+  // Cancel only this token; a stale token cannot discard another caller's job.
+  void Cancel(uint64_t id);
+  // Permanently reject new work and invalidate all outstanding tokens without
+  // waiting for inference. Returns the last issued token for a replacement
+  // worker's seed. Repeated calls return the same value.
+  uint64_t Retire();
+  // A cancelled/superseded token must not be polled indefinitely.
+  bool IsCurrent(uint64_t id);
+  std::optional<AzooKeyAsyncResult> Take(uint64_t id);
+ private:
+  friend struct AzooKeyAsyncConverterTestPeer;
+  struct Job { uint64_t id; AzooKeyAsyncRequest request; };
+  void Run();
+  const std::unique_ptr<const ImmutableConverterInterface> converter_;
+  std::mutex mutex_;
+  std::condition_variable ready_;
+  bool stopping_ = false;
+  uint64_t next_id_ = 0, current_id_ = 0;
+  std::optional<Job> pending_;
+  std::optional<AzooKeyAsyncResult> completed_;
+  std::thread worker_;
+};
+std::unique_ptr<AzooKeyAsyncConverter> CreateAzooKeyAsyncConverter(
+    const AzooKeyConfig& config);
+}  // namespace mozc
+#endif  // MOZC_CONVERTER_AZOOKEY_ASYNC_CONVERTER_H_
