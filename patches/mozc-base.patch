+  for (const uint32_t encoded : entry.inner_segment_boundary()) {
+    const auto length = converter::DecodeLengths(encoded);
+    if (length.key_len == 0 || length.value_len == 0 ||
+        length.content_key_len == 0 || length.content_value_len == 0 ||
+        length.content_key_len > length.key_len ||
+        length.content_value_len > length.value_len ||
+        length.key_len > reading->size() - key_offset ||
+        length.value_len > entry.value().size() - value_offset) return false;
+    const auto key_part = reading->substr(key_offset, length.key_len);
+    const auto value_part = absl::string_view(entry.value()).substr(value_offset, length.value_len);
+    if (!IsValidContextText(key_part) || !IsValidContextText(value_part) ||
+        !IsValidContextText(key_part.substr(0, length.content_key_len)) ||
+        !IsValidContextText(value_part.substr(0, length.content_value_len))) return false;
+    key_offset += length.key_len;
+    value_offset += length.value_len;
+  }
+  return key_offset == reading->size() && value_offset == entry.value().size();
