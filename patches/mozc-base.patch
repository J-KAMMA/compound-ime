+  ASSERT_NO_FATAL_FAILURE(Cancel(same_));
+  ASSERT_NO_FATAL_FAILURE(Convert("different_", different_, false));
+  EXPECT_EQ(initial_text_, cold_different) << "cross-window initial output changed";
+  EXPECT_EQ(Text(), cold_different) << "manual choice must not move to a different window";
+  ASSERT_NO_FATAL_FAILURE(Cancel(different_));
