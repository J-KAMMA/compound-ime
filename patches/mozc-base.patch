+class ScopeMutationTest : public testing::TestWithTempUserProfile {
+ protected:
+  ScopeMutationTest() : matcher_(data_.GetPosMatcherData()), group_(data_.GetPosGroupData()) {}
+  void SetUp() override {
+    config::ConfigHandler::GetDefaultConfig(&config_);
+    config_.set_history_learning_level(config::Config::DEFAULT_HISTORY);
+    config_.set_incognito_mode(false);
+    request_.set_mixed_conversion(false);
+    same_.set_preceding_text("朝ご飯を食べるために"); same_.set_following_text("を使います。");
+    different_.set_preceding_text("昼ご飯を食べるために"); different_.set_following_text("を使います。");
+    rewriter_ = std::make_unique<UserSegmentHistoryRewriter>(matcher_, group_);
+    rewriter_->Clear();
+  }
+  ConversionRequest Request(const commands::Context& context, bool partial = false,
+                            bool internal = false, bool incognito = false) const {
+    ConversionRequest::Options options;
+    options.enable_user_history_for_conversion = true;
+    options.create_partial_candidates = partial;
+    options.used_in_predictor_realtime_conversion = internal;
+    options.incognito_mode = incognito;
+    return ConversionRequestBuilder().SetConfig(config_).SetRequest(request_)
+        .SetContext(context).SetOptions(options).SetRequestType(ConversionRequest::CONVERSION).Build();
+  }
+  void Add(Segments* segments, absl::string_view key, bool history = false) const {
+    auto* segment = segments->add_segment(); segment->set_key(key);
+    segment->set_segment_type(history ? Segment::HISTORY : Segment::FREE);
+    Fill(segment);
+  }
+  void Fill(Segment* segment) const {
+    for (absl::string_view value : {absl::string_view("箸"), absl::string_view("橋")}) {
+      auto* c = segment->add_candidate(); c->key = segment->key(); c->content_key = c->key;
+      c->value = std::string(value); c->content_value = c->value;
+      c->lid = matcher_.GetGeneralNounId(); c->rid = c->lid;
+    }
+  }
+  Segments Input(std::initializer_list<absl::string_view> keys, bool resized = false,
+                 bool history = false) const {
+    Segments segments; if (history) Add(&segments, "まえ", true);
+    for (absl::string_view key : keys) Add(&segments, key);
+    segments.set_resized(resized); return segments;
+  }
+  void Capture(const ConversionRequest& request, Segments* segments) const {
+    rewriter_->Rewrite(request, segments);
+  }
+  static std::string Scope(const Segment& segment) {
+    if (!segment.context_history_scope_initialized()) return "UNINITIALIZED";
+    if (!segment.context_history_scope()) return "LEGACY";
+    return segment.context_history_scope()->empty() ? "BLOCKED" : *segment.context_history_scope();
+  }
+  void Learn(Segments* segments, size_t target, uint64_t owner, bool missing = false) {
+    auto* segment = segments->mutable_segment(target); segment->move_candidate(1, 0);
+    segment->mutable_candidate(0)->attributes |= converter::Attribute::RERANKED;
+    for (Segment& part : segments->conversion_segments()) part.set_segment_type(Segment::FIXED_VALUE);
+    segments->set_revert_id(owner);
+    rewriter_->Finish(Request(missing ? empty_ : same_), *segments);
+  }
+  testing::MockDataManager data_; dictionary::PosMatcher matcher_; dictionary::PosGroup group_;
+  config::Config config_; commands::Request request_; commands::Context same_, different_, empty_;
+  std::unique_ptr<UserSegmentHistoryRewriter> rewriter_;
+};
+// API-contract probes, not proof of a live Session reaching mutated FREE metadata.
+TEST_F(ScopeMutationTest, FreeTargetNeighborReadingChangeDoesNotRecallOldComposition) {
+  auto reused = Input({"はし", "ごはん"}); Capture(Request(same_), &reused);
+  const std::string old_scope = Scope(reused.segment(0));
+  auto training = Input({"はし", "ごはん"}); Capture(Request(same_), &training);
+  Learn(&training, 0, 201);
+  ASSERT_EQ(reused.segment(0).segment_type(), Segment::FREE);
+  reused.mutable_segment(1)->set_key("あめ");
+  auto fresh = Input({"はし", "あめ"}); Capture(Request(same_), &fresh);
+  ASSERT_NE(Scope(fresh.segment(0)), old_scope);
+  ASSERT_EQ(fresh.segment(0).candidate(0).value, "箸");
+  Capture(Request(same_), &reused);
+  RecordProperty("old_scope", old_scope);
+  RecordProperty("actual_scope", Scope(reused.segment(0)));
+  RecordProperty("reference_scope", Scope(fresh.segment(0)));
+  RecordProperty("actual_top", reused.segment(0).candidate(0).value);
+  RecordProperty("expected_top", "箸");
+  EXPECT_TRUE(Scope(reused.segment(0)) == Scope(fresh.segment(0)) ||
+              Scope(reused.segment(0)) == "BLOCKED");
+  EXPECT_EQ(reused.segment(0).candidate(0).value, "箸");
+  Capture(Request(empty_), &reused);
+  EXPECT_EQ(Scope(reused.segment(0)), "BLOCKED");
+  EXPECT_EQ(reused.segment(0).candidate(0).value, "箸");
+  Learn(&reused, 0, 204, true);
+  auto after_finish = Input({"はし", "あめ"}); Capture(Request(same_), &after_finish);
+  EXPECT_EQ(after_finish.segment(0).candidate(0).value, "箸");
+  auto legacy = Input({"はし"}); Capture(Request(empty_), &legacy);
+  EXPECT_EQ(legacy.segment(0).candidate(0).value, "箸");
+}
+TEST_F(ScopeMutationTest, FreeTargetInvalidNeighborDoesNotRecallOldComposition) {
+  const std::array<std::string, 3> keys = {std::string(), std::string("a\0b", 3), std::string("\xc0\xaf", 2)};
+  std::vector<Segments> reused;
+  for (size_t i = 0; i < keys.size(); ++i) {
+    reused.push_back(Input({"はし", "ごはん"})); Capture(Request(same_), &reused.back());
+  }
+  auto training = Input({"はし", "ごはん"}); Capture(Request(same_), &training);
+  Learn(&training, 0, 202);
+  for (size_t i = 0; i < keys.size(); ++i) {
+    SCOPED_TRACE(i);
+    ASSERT_EQ(reused[i].segment(0).segment_type(), Segment::FREE);
+    reused[i].mutable_segment(1)->set_key(keys[i]);
+    auto fresh = Input({"はし", keys[i]}); Capture(Request(same_), &fresh);
+    ASSERT_EQ(Scope(fresh.segment(0)), "BLOCKED");
+    Capture(Request(same_), &reused[i]);
+    RecordProperty(absl::StrCat("actual_scope_", i), Scope(reused[i].segment(0)));
+    RecordProperty(absl::StrCat("actual_top_", i), reused[i].segment(0).candidate(0).value);
+    EXPECT_EQ(Scope(reused[i].segment(0)), "BLOCKED");
+    EXPECT_EQ(reused[i].segment(0).candidate(0).value, "箸");
+  }
+}
+TEST_F(ScopeMutationTest, SameReadingResizeAndFixedManualChoiceRemainStable) {
+  auto resized = Input({"はし", "ごはん"}); Capture(Request(same_), &resized);
+  const std::string old_scope = Scope(resized.segment(0));
+  auto fixed = Input({"はし", "ごはん"}); Capture(Request(same_), &fixed);
+  auto* target = fixed.mutable_segment(0); target->move_candidate(1, 0);
+  target->mutable_candidate(0)->attributes |= converter::Attribute::RERANKED;
+  target->set_segment_type(Segment::FIXED_VALUE);
+  auto training = Input({"はし", "ごはん"}); Capture(Request(same_), &training);
+  Learn(&training, 0, 203);
+  const std::array<uint8_t, 2> sizes = {1, 2};
+  ASSERT_TRUE(resized.Resize(1, sizes));
+  ASSERT_EQ(resized.conversion_segments_size(), 3);
+  ASSERT_EQ(resized.segment(0).segment_type(), Segment::FREE);
+  ASSERT_EQ(resized.segment(1).key(), "ご"); ASSERT_EQ(resized.segment(2).key(), "はん");
+  ASSERT_EQ(Scope(resized.segment(0)), old_scope);
+  // Real immutable conversion fills recreated segments before Rewrite.
+  Fill(resized.mutable_segment(1)); Fill(resized.mutable_segment(2));
+  auto fresh = Input({"はし", "ご", "はん"}); Capture(Request(same_), &fresh);
+  ASSERT_EQ(Scope(fresh.segment(0)), old_scope);
+  Capture(Request(same_), &resized);
+  EXPECT_EQ(Scope(resized.segment(0)), old_scope);
+  EXPECT_EQ(resized.segment(0).candidate(0).value, "橋");
+  Capture(Request(empty_), &resized);
+  EXPECT_EQ(Scope(resized.segment(0)), old_scope);
+  EXPECT_EQ(resized.segment(0).candidate(0).value, "橋");
+  fixed.mutable_segment(1)->set_key("あめ"); Capture(Request(same_), &fixed);
+  EXPECT_EQ(fixed.segment(0).segment_type(), Segment::FIXED_VALUE);
+  EXPECT_EQ(Scope(fixed.segment(0)), old_scope);
+  EXPECT_EQ(fixed.segment(0).candidate(0).value, "橋");
+  fixed.mutable_segment(0)->set_segment_type(Segment::SUBMITTED);
+  Capture(Request(empty_), &fixed);
+  EXPECT_EQ(Scope(fixed.segment(0)), old_scope);
+  EXPECT_EQ(fixed.segment(0).candidate(0).value, "橋");
+  RecordProperty("same_reading_resize_top", resized.segment(0).candidate(0).value);
+  RecordProperty("fixed_manual_top", fixed.segment(0).candidate(0).value);
+}
