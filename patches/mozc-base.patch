+TEST_F(AsyncEngineCandidateTest, FullSpanSameValueDistinctIdCommitsOnceWithoutTrailingSegments) {
+  auto mock = std::make_shared<MockConverter>();
+  EngineConverter engine(mock, request_, config_);
+  engine.SetAsyncConverter(worker_);
+  auto segments = BaseSegments();
+  auto* base = segments.mutable_conversion_segment(0)->mutable_candidate(0);
+  base->value = base->content_value = "補完1";
+  ASSERT_TRUE(Start(engine, *mock, Window(), ConversionPreferences{true, true}, std::move(segments)));
+  ASSERT_TRUE(WaitStarted(1));
+  const auto token = engine.GetAsyncConversionToken();
+  ASSERT_NE(token, 0);
+  Permit(1);
+  EXPECT_EQ(WaitPoll(engine, token), AsyncStatus::kApplied);
+  ASSERT_EQ(GetCandidateList(engine).size(), 2);
+  EXPECT_EQ(GetCandidateList(engine).candidate(0).id(), 0);
+  EXPECT_EQ(GetCandidateList(engine).candidate(1).id(), 1);
+  engine.CandidateNext(*composer_);
+  EXPECT_EQ(GetCandidateList(engine).focused_id(), 1);
+  commands::Output selected;
+  engine.FillOutput(*composer_, &selected);
+  ASSERT_EQ(selected.preedit().segment_size(), 1);
+  EXPECT_EQ(selected.preedit().segment(0).key(), "あい");
+  EXPECT_EQ(selected.preedit().segment(0).value(), "補完1");
+  EXPECT_CALL(*mock, CommitSegmentValue(_, 0, 1))
+      .WillOnce([](Segments* input, size_t index, int id) {
+        // Match actual Converter's Segment movement before Engine reads span.
+        Segment* segment = input->mutable_conversion_segment(index);
+        segment->set_segment_type(Segment::FIXED_VALUE);
+        segment->move_candidate(id, 0);
+        segment->mutable_candidate(0)->attributes |= converter::Attribute::RERANKED;
+        return true;
+      });
+  EXPECT_CALL(*mock, CommitSegmentValue(_, 1, _)).Times(0);
+  EXPECT_CALL(*mock, FinishConversion(_, _)).Times(1);
+  engine.Commit(*composer_, Window());
+  EXPECT_FALSE(engine.IsActive());
+  EXPECT_EQ(GetResult(engine).key(), "あい");
+  EXPECT_EQ(GetResult(engine).value(), "補完1");
+  std::string keys, values;
+  for (const auto& item : GetResult(engine).tokens()) {
+    keys += item.key();
+    values += item.value();
+  }
+  EXPECT_EQ(keys, "あい");
+  EXPECT_EQ(values, "補完1");
+}
