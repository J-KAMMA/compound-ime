+TEST_F(ScopedHistoryChoiceTest, ExistingEightByteStoreIsPreservedAndNotLearnedInto) {
+  rewriter_.reset();
+  ASSERT_TRUE(FileUtil::Unlink(ScopedStorePath()).ok());
+  ASSERT_TRUE(storage::LruStorage::CreateStorageFile(
+      ScopedStorePath().c_str(), 8, 20000, 0xf28defe3));
+  // Capacity/seed match D4; only the previous 8-byte value format differs.
+  storage::LruStorage old_store;
+  ASSERT_TRUE(old_store.Open(ScopedStorePath().c_str()));
+  ASSERT_EQ(old_store.value_size(), 8);
+  const std::array<char, 8> old_value = {1,2,3,4,5,6,7,8};
+  ASSERT_TRUE(old_store.Insert("known-old-D3-row", old_value.data()));
+  ASSERT_EQ(old_store.used_size(), 1);
+  old_store.Close();
+  const auto original = ReadScopedFileBytes();
+  ASSERT_TRUE(original.has_value());
+  ASSERT_EQ(original->size(), 400012);  // 12 + 20000 * (12 + 8).
+  const uint64_t original_file_fingerprint = CityFingerprint(*original);
+  rewriter_ = CreateRewriter();
+  EXPECT_FALSE(rewriter_->Reload());  // D3 format must be rejected, not migrated.
+  const Scope scope("scope-alpha");
+  Select(scope, "橋", "箸", 1401, Request());
+  ExpectOrder(scope, "橋", "箸", "橋", "箸", Request());
+  rewriter_.reset();
+  const auto preserved = ReadScopedFileBytes();
+  ASSERT_TRUE(preserved.has_value());
+  EXPECT_EQ(preserved->size(), original->size());
+  EXPECT_EQ(CityFingerprint(*preserved), original_file_fingerprint);
+  EXPECT_EQ(*preserved, *original);  // Full bytes, stronger than hash alone.
+  ASSERT_TRUE(old_store.Open(ScopedStorePath().c_str()));
+  EXPECT_EQ(old_store.value_size(), 8);
+  EXPECT_EQ(old_store.used_size(), 1);
+  old_store.Close();
+}
