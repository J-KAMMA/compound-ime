+// Ordinary candidate navigation keeps the same speculative request. These
+// tests use the real EngineConverter and a gated provider, without a model.
+class AsyncSessionCandidateNextTest : public AsyncSessionBridgeTest {
+ protected:
+  bool StartCaptured(commands::Command* initial) {
+    auto* context = initial->mutable_input()->mutable_context();
+    context->set_revision(17);
+    context->set_input_field_type(commands::Context::NORMAL);
+    return Start(initial);
+  }
+  commands::Command Next(const commands::Context* context = nullptr) {
+    commands::Command next;
+    next.mutable_input()->set_type(commands::Input::SEND_KEY);
+    next.mutable_input()->mutable_key()->set_special_key(commands::KeyEvent::SPACE);
+    if (context) *next.mutable_input()->mutable_context() = *context;
+    return next;
+  }
+  void ExpectAppend(int context_kind) {
+    commands::Command initial;
+    ASSERT_TRUE(StartCaptured(&initial));
+    ASSERT_TRUE(initial.output().has_callback());
+    const auto callback = initial.output().callback().session_command();
+    const uint64_t token = engine_converter_->GetAsyncConversionToken();
+    ASSERT_NE(token, 0);
+    EXPECT_FALSE(initial.output().has_candidate_window());
+    commands::Context partial;
+    partial.set_preceding_text("synthetic-left");
+    const commands::Context* context = context_kind == 0 ? &initial.input().context()
+                                       : context_kind == 1 ? nullptr : &partial;
+    auto next = Next(context);
+    ASSERT_TRUE(session_->SendKey(&next));
+    ASSERT_TRUE(next.output().has_callback());
+    EXPECT_EQ(next.output().callback().session_command().SerializeAsString(),
+              callback.SerializeAsString());
+    EXPECT_EQ(engine_converter_->GetAsyncConversionToken(), token);
+    ASSERT_TRUE(next.output().has_candidate_window());
+    EXPECT_EQ(next.output().candidate_window().category(), commands::CONVERSION);
+    EXPECT_EQ(PreeditText(next.output()), "橋ご飯");
+    ASSERT_TRUE(next.output().has_all_candidate_words());
+    const auto original = next.output().all_candidate_words();
+    ASSERT_EQ(original.candidates_size(), 2);
+    ASSERT_EQ(original.focused_index(), 1);
+    const int selected_id = original.candidates(original.focused_index()).id();
+    auto pending = Poll(callback);
+    EXPECT_TRUE(pending.output().consumed());
+    EXPECT_EQ(pending.output().preedit().SerializeAsString(),
+              next.output().preedit().SerializeAsString());
+    EXPECT_EQ(pending.output().all_candidate_words().SerializeAsString(),
+              original.SerializeAsString());
+    EXPECT_EQ(pending.output().callback().session_command().SerializeAsString(),
+              callback.SerializeAsString());
+    EXPECT_FALSE(pending.output().has_result());
+    EXPECT_TRUE(gate_->speculative);
+    EXPECT_EQ(gate_->key, "はしごはん");
+    EXPECT_EQ(gate_->left, "synthetic-left");
+    EXPECT_EQ(gate_->right, "synthetic-right");
+    gate_->Release();
+    commands::Command applied;
+    ASSERT_TRUE(Await(callback, &applied));
+    EXPECT_FALSE(applied.output().has_callback());
+    EXPECT_FALSE(applied.output().has_result());
+    EXPECT_EQ(applied.output().preedit().SerializeAsString(),
+              next.output().preedit().SerializeAsString());
+    const auto& words = applied.output().all_candidate_words();
+    ASSERT_EQ(words.candidates_size(), 3);
+    EXPECT_EQ(words.focused_index(), original.focused_index());
+    EXPECT_EQ(words.candidates(words.focused_index()).id(), selected_id);
+    for (int i = 0; i < original.candidates_size(); ++i) {
+      EXPECT_EQ(words.candidates(i).SerializeAsString(),
+                original.candidates(i).SerializeAsString());
+    }
+    EXPECT_EQ(words.candidates(2).value(), "橋と御飯");
+    EXPECT_EQ(words.candidates(2).num_segments_in_candidate(), 2);
+    EXPECT_EQ(engine_converter_->GetAsyncConversionToken(), 0);
+  }
+  void ExpectContextCancellation(int field) {
+    commands::Command initial;
+    ASSERT_TRUE(StartCaptured(&initial));
+    ASSERT_TRUE(initial.output().has_callback());
+    const auto callback = initial.output().callback().session_command();
+    auto context = initial.input().context();
+    switch (field) {
+      case 0: context.set_preceding_text("changed-left"); break;
+      case 1: context.set_following_text("changed-right"); break;
+      case 2: context.set_revision(18); break;
+      case 3: context.set_input_field_type(commands::Context::PASSWORD); break;
+      default: FAIL() << "unknown context fixture";
+    }
+    auto next = Next(&context);
+    ASSERT_TRUE(session_->SendKey(&next));
+    EXPECT_EQ(engine_converter_->GetAsyncConversionToken(), 0);
+    EXPECT_FALSE(next.output().has_callback());
+    gate_->Release();
+    ASSERT_TRUE(gate_->Wait(&BridgeGate::returned));
+    StaleOnly(callback);
+  }
+};
