@@ -0,0 +1,750 @@
+// Copyright 2026 MyIME Project.
+// All rights reserved.
+
+#include "converter/azookey_async_converter.h"
+
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <functional>
+#include <limits>
+#include <memory>
+#include <mutex>
+#include <optional>
+#include <stdexcept>
+#include <string>
+#include <string_view>
+#include <thread>
