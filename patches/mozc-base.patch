+  ASSERT_TRUE(WaitStarted(1));
+  Permit(1);
+  EXPECT_EQ(WaitPoll(engine, engine.GetAsyncConversionToken()), AsyncStatus::kApplied);
+  EXPECT_EQ(mock->rewrite_calls, 1);
+  EXPECT_EQ(Preedit(engine), before);
+  const auto after_ids = Ids(engine);
