+void CandidateList::MoveCandidateToEnd(int id) {
+  const auto it = std::find_if(candidates_.begin(), candidates_.end(),
+                             [id](const Candidate& candidate) {
+                               return !candidate.HasSubcandidateList() && candidate.id() == id;
+                             });
+  if (it == candidates_.end()) return;
+  const size_t index = static_cast<size_t>(it - candidates_.begin());
+  std::rotate(it, it + 1, candidates_.end());
+  if (focused_index_ == index) focused_index_ = candidates_.size() - 1;
+  else if (focused_index_ > index) --focused_index_;
+}
+
+bool CandidateList::MoveCandidateAfterFocused(int id) {
+  if (id < 0 || focused_index_ >= candidates_.size() ||
+      focused_candidate().HasSubcandidateList()) return false;
+  if (const auto iter = alternative_ids_.find(id); iter != alternative_ids_.end())
+    id = iter->second;
+  if (id < 0) return false;
+  const auto begin = candidates_.begin() + focused_index_ + 1;
+  const auto target = std::find_if(begin, candidates_.end(),
+                                 [id](const Candidate& candidate) {
+                                   return !candidate.HasSubcandidateList() &&
+                                          candidate.id() == id;
+                                 });
+  if (target == candidates_.end() || target == begin) return false;
+  std::rotate(begin, target, target + 1);
+  return true;
+}
