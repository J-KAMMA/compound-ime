+// Regression tests for context-scoped user segment history.
+// Input contract: each segment contains exactly two compatible noun candidates.
+// Finish input selects original index 1, moves it to index 0, and marks that
+// selected candidate RERANKED with segment FIXED_VALUE, as the public rewriter
+// interface receives it after candidate selection.  No Session claim is made.
+#include "rewriter/user_segment_history_rewriter.h"
+
+#include <algorithm>
+#include <array>
+#include <bit>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <fstream>
+#include <initializer_list>
+#include <iterator>
+#include <limits>
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "absl/strings/string_view.h"
+#include "absl/time/time.h"
+#include "base/clock_mock.h"
+#include "base/config_file_stream.h"
+#include "base/file_util.h"
+#include "base/hash.h"
+#include "config/config_handler.h"
+#include "converter/attribute.h"
+#include "converter/segments.h"
+#include "data_manager/testing/mock_data_manager.h"
+#include "dictionary/pos_group.h"
+#include "dictionary/pos_matcher.h"
+#include "protocol/commands.pb.h"
+#include "protocol/config.pb.h"
+#include "request/conversion_request.h"
+#include "storage/lru_storage.h"
+#include "testing/gunit.h"
+#include "testing/mozctest.h"
+
+namespace mozc {
+namespace {
+
+using Scope = std::optional<std::string>;
+
+class ScopedHistoryChoiceTest : public testing::TestWithTempUserProfile {
+ protected:
+  ScopedHistoryChoiceTest()
+      : clock_(absl::FromUnixSeconds(1000000)),
+        pos_matcher_(data_.GetPosMatcherData()),
+        pos_group_(data_.GetPosGroupData()) {}
+
+  void SetUp() override {
+    config::ConfigHandler::GetDefaultConfig(&config_);
+    config_.set_history_learning_level(config::Config::DEFAULT_HISTORY);
+    config_.set_incognito_mode(false);
+    rewriter_ = CreateRewriter();
+    rewriter_->Clear();  // TestWithTempUserProfile's private directory only.
+    // ClockMock's default auto advance is zero: every API call has one tick.
+  }
+
+  void TearDown() override { rewriter_.reset(); }
+
+  std::unique_ptr<UserSegmentHistoryRewriter> CreateRewriter() const {
+    return std::make_unique<UserSegmentHistoryRewriter>(pos_matcher_, pos_group_);
+  }
+
+  ConversionRequest Request(bool option_incognito = false,
+                            bool enable_history = true) const {
+    ConversionRequest::Options options;
+    options.incognito_mode = option_incognito;
+    options.enable_user_history_for_conversion = enable_history;
+    return ConversionRequestBuilder()
+        .SetConfig(config_)
+        .SetRequest(request_)
+        .SetOptions(options)
+        .SetRequestType(ConversionRequest::CONVERSION)
+        .Build();
+  }
+
+  Segments Candidates(const Scope& scope, absl::string_view first,
+                      absl::string_view second) const {
+    Segments segments;
+    Segment* segment = segments.add_segment();
+    segment->set_key("はし");
+    if (scope.has_value()) segment->set_context_history_scope(scope);
+    for (const absl::string_view value : {first, second}) {
+      converter::Candidate* candidate = segment->add_candidate();
+      candidate->key = "はし";
+      candidate->content_key = "はし";
+      candidate->value = std::string(value);
+      candidate->content_value = std::string(value);
+      candidate->lid = pos_matcher_.GetGeneralNounId();
+      candidate->rid = pos_matcher_.GetGeneralNounId();
+    }
+    segment->mutable_candidate(0)->attributes |=
+        converter::Attribute::BEST_CANDIDATE;
+    return segments;
+  }
+
+  Segments Select(const Scope& scope, absl::string_view first,
+                  absl::string_view second, uint64_t revert_id,
+                  const ConversionRequest& request) {
+    Segments segments = Candidates(scope, first, second);
+    Segment* segment = segments.mutable_segment(0);
+    segment->move_candidate(1, 0);
+    segment->mutable_candidate(0)->attributes |= converter::Attribute::RERANKED;
+    segment->set_segment_type(Segment::FIXED_VALUE);
+    segments.set_revert_id(revert_id);
+    rewriter_->Finish(request, segments);
+    return segments;
+  }
+
+  void ExpectOrder(const Scope& scope, absl::string_view input_first,
+                   absl::string_view input_second,
+                   absl::string_view expected_first,
+                   absl::string_view expected_second,
+                   const ConversionRequest& request) {
+    Segments segments = Candidates(scope, input_first, input_second);
+    rewriter_->Rewrite(request, &segments);
+    ASSERT_EQ(segments.segments_size(), 1);
+    ASSERT_EQ(segments.segment(0).candidates_size(), 2);
+    EXPECT_EQ(segments.segment(0).key(), "はし");
+    EXPECT_EQ(segments.segment(0).candidate(0).value, expected_first);
+    EXPECT_EQ(segments.segment(0).candidate(1).value, expected_second);
+  }
+
+  enum class CapturedScope { kLegacy, kBlocked, kScoped };
+
+  void ExpectCapturedScope(const commands::Context& context,
+                           absl::string_view reading, CapturedScope expected) {
+    // Only the synthetic reading changes at the length/encoding boundaries.
+    // Surface candidates remain literal Bridge/Chopsticks: this tests metadata
+    // capture, not a linguistic reading-to-surface or model-quality claim.
+    Segments segments = Candidates(std::nullopt, "橋", "箸");
+    Segment* segment = segments.mutable_segment(0);
+    segment->set_key(reading);
+    for (size_t i = 0; i < 2; ++i) {
+      segment->mutable_candidate(i)->key = std::string(reading);
+      segment->mutable_candidate(i)->content_key = std::string(reading);
+    }
+    ASSERT_FALSE(segment->context_history_scope_initialized());
+    ASSERT_FALSE(segment->context_history_scope().has_value());
+    const ConversionRequest request = ConversionRequestBuilder()
+        .SetConfig(config_)
+        .SetRequest(request_)
+        .SetContext(context)
+        .SetRequestType(ConversionRequest::CONVERSION)
+        .Build();
+    rewriter_->Rewrite(request, &segments);  // Public creator, no scope setter.
+    EXPECT_TRUE(segment->context_history_scope_initialized());
+    const Scope& captured = segment->context_history_scope();
+    if (expected == CapturedScope::kLegacy) {
+      EXPECT_FALSE(captured.has_value());
+    } else {
+      ASSERT_TRUE(captured.has_value());
+      if (expected == CapturedScope::kBlocked) {
+        EXPECT_EQ(*captured, "");
+      } else {
+        EXPECT_FALSE(captured->empty());
+        EXPECT_TRUE(std::all_of(captured->begin(), captured->end(),
+                               [](unsigned char c) {
+                                 return c >= 0x21 && c <= 0x7e;
+                               }));
+      }
+    }
+    ASSERT_EQ(segment->candidates_size(), 2);
+    EXPECT_EQ(segment->candidate(0).value, "橋");
+    EXPECT_EQ(segment->candidate(1).value, "箸");
+  }
+
+  static std::string ScopedStorePath() {
+    return ConfigFileStream::GetFileName("user://context_segment.db");
+  }
+
+  struct KnownRow {
+    size_t index = 0;
+    uint64_t key_fingerprint = 0;
+    uint32_t timestamp = 0;
+    std::string value;
+  };
+
+  static ::testing::AssertionResult ReadOnlyRow(const storage::LruStorage& db,
+                                                KnownRow* row) {
+    if (db.value_size() != 16 || db.used_size() != 1) {
+      return ::testing::AssertionFailure() << "Expected one 16-byte row";
+    }
+    std::vector<std::string> values;
+    db.GetAllValues(&values);
+    if (values.size() != 1 || values[0].size() != 16) {
+      return ::testing::AssertionFailure() << "Unexpected logical row count";
+    }
+    size_t matches = 0;
+    for (size_t i = 0; i < db.size(); ++i) {
+      KnownRow candidate;
+      candidate.index = i;
+      db.Read(i, &candidate.key_fingerprint, &candidate.value,
+              &candidate.timestamp);
+      if (candidate.timestamp != 0 && candidate.value == values[0]) {
+        *row = candidate;
+        ++matches;
+      }
+    }
+    return matches == 1 ? ::testing::AssertionSuccess()
+                        : ::testing::AssertionFailure()
+                              << "Expected exactly one matching physical row";
+  }
+
+  static std::optional<std::string> ReadScopedFileBytes() {
+    std::ifstream input(ScopedStorePath(), std::ios::binary);
+    if (!input.is_open()) return std::nullopt;
+    std::string bytes((std::istreambuf_iterator<char>(input)),
+                      std::istreambuf_iterator<char>());
+    return input.bad() ? std::nullopt : std::optional<std::string>(bytes);
+  }
+
+  // Constructed/destructed inside the private profile fixture lifetime.
+  ScopedClockMock clock_;
+  const testing::MockDataManager data_;
+  const dictionary::PosMatcher pos_matcher_;
+  const dictionary::PosGroup pos_group_;
+  config::Config config_;
+  commands::Request request_;
+  std::unique_ptr<UserSegmentHistoryRewriter> rewriter_;
+};
