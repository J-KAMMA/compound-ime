+TEST(RealtimeDecoderTest, DecodeSuffixDocumentContextIsRequestScoped) {
+  MockConverter converter;
+  MockImmutableConverter immutable_converter;
+  const MockRealtimeDecoder decoder(immutable_converter, converter);
+  constexpr uint16_t kPrefixRid = 20;
+  constexpr absl::string_view kSuffix = "さんに";
+  struct TestCase {
+    const char* preceding;
+    const char* following;
+    const char* value;
+  };
+  constexpr TestCase kCases[] = {
+      {" 前 ", " 後 ", "前と後の候補"},
+      {"別の前", " 後 ", "別の前の候補"},
+      {"別の前", "別の後", "別の後の候補"},
+      {"", "", "文脈なしの候補"},
+  };
+  for (const TestCase& test : kCases) {
+    SCOPED_TRACE(test.value);
+    commands::Context context;
+    context.set_preceding_text(test.preceding);
+    context.set_following_text(test.following);
+    const ConversionRequest request =
+        ConversionRequestBuilder()
+            .SetContext(context)
+            .SetRequestType(ConversionRequest::PREDICTION)
+            .Build();
+    const auto expected_context = request.GetSurroundingContext();
+    Result expected;
+    expected.key = std::string(kSuffix);
+    expected.value = test.value;
+    EXPECT_CALL(decoder,
+                Decode(Truly([expected_context, kSuffix](
+                                 const ConversionRequest& req) {
+                  return req.key() == kSuffix &&
+                         req.options().bos_id == kPrefixRid &&
+                         req.GetSurroundingContext() == expected_context;
+                })))
+        .WillOnce(Return(std::vector<Result>{expected}));
+
+    commands::Context normalized_context;
+    normalized_context.set_preceding_text(expected_context.first);
+    normalized_context.set_following_text(expected_context.second);
+    const ConversionRequest normalized_request =
+        ConversionRequestBuilder()
+            .SetConversionRequest(request)
+            .SetContext(normalized_context)
+            .Build();
+    // A new request with equivalent normalized context must hit the cache.
+    // Changing either side, or clearing both, must decode a new result.
+    for (const ConversionRequest* req : {&request, &normalized_request}) {
+      const auto result = decoder.DecodeSuffix(*req, kPrefixRid, kSuffix);
+      ASSERT_TRUE(result.has_value());
+      EXPECT_EQ(result->key, kSuffix);
+      EXPECT_EQ(result->value, test.value);
+    }
+  }
+}
