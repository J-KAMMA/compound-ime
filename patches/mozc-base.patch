+++ b/src/converter/segment_context_scope_test.cc
@@ -0,0 +1,218 @@
+// Private source-only regression QA; do not build until the new Segment API
+// and its dependent production objects are frozen.
+#include "converter/segments.h"
+
+#include <array>
+#include <cstddef>
+#include <optional>
+#include <string>
+#include <type_traits>
+#include <utility>
+
+#include "absl/strings/string_view.h"
+#include "testing/gunit.h"
+
+namespace mozc::converter {
+namespace {
+
+using Scope = std::optional<std::string>;
+static_assert(std::is_same_v<
+              decltype(std::declval<const Segment&>().context_history_scope()),
+              const Scope&>);
+static_assert(std::is_same_v<
+              decltype(std::declval<const Segment&>()
+                           .context_history_scope_initialized()),
+              bool>);
+
+void ExpectScope(const Segment& segment, const Scope& scope, bool initialized) {
+  EXPECT_EQ(segment.context_history_scope(), scope);
+  EXPECT_EQ(segment.context_history_scope_initialized(), initialized);
+}
+
+TEST(SegmentContextScopeTest, CopyAssignmentClearAndReuseAreIndependent) {
+  Segment original;
+  original.set_key("あめ");
+  original.add_candidate()->value = "雨";
+  original.set_context_history_scope(Scope("profile-alpha"));
+  Segment copied(original);
+
+  original.set_key("はし");
+  ExpectScope(original, Scope(""), true);
+  ExpectScope(copied, Scope("profile-alpha"), true);
+  EXPECT_EQ(copied.key(), "あめ");
+  ASSERT_EQ(copied.candidates_size(), 1);
+  EXPECT_EQ(copied.candidate(0).value, "雨");
+  original.mutable_candidate(0)->value = "橋";
+  EXPECT_EQ(copied.candidate(0).value, "雨");
+
+  original.Clear();
+  ExpectScope(original, std::nullopt, false);
+  EXPECT_TRUE(original.key().empty());
+  EXPECT_EQ(original.candidates_size(), 0);
+  original.set_key("次");
+  ExpectScope(original, std::nullopt, false);
+  original.set_context_history_scope(Scope("profile-beta"));
+  original = copied;
+  ExpectScope(original, Scope("profile-alpha"), true);
+  EXPECT_EQ(original.key(), "あめ");
+  ASSERT_EQ(original.candidates_size(), 1);
+  EXPECT_EQ(original.candidate(0).value, "雨");
+
+  copied.Clear();
+  copied.set_key("");
+  ExpectScope(copied, std::nullopt, false);
+  ExpectScope(original, Scope("profile-alpha"), true);
+  original = copied;
+  ExpectScope(original, std::nullopt, false);
+  EXPECT_TRUE(original.key().empty());
+  EXPECT_EQ(original.candidates_size(), 0);
+}
+
+TEST(SegmentContextScopeTest, ExplicitLegacyInitializationSurvivesCopiesOnly) {
+  Segment legacy;
+  legacy.set_key("あめ");
+  legacy.set_context_history_scope(std::nullopt);
+  Segment copied(legacy);
+  Segment assigned;
+  assigned.set_key("古い");
+  assigned.set_context_history_scope(Scope("profile-old"));
+  assigned = legacy;
+  ExpectScope(copied, std::nullopt, true);
+  ExpectScope(assigned, std::nullopt, true);
+
+  legacy.Clear();
+  legacy.set_key("再利用");
+  ExpectScope(legacy, std::nullopt, false);
+  ExpectScope(copied, std::nullopt, true);
+  copied.set_key("あめ");
+  ExpectScope(copied, std::nullopt, false);
+  assigned.clear();
+  assigned.set_key("次");
+  ExpectScope(assigned, std::nullopt, false);
+}
+
+TEST(SegmentContextScopeTest, EveryKeyReplacementInvalidatesStaleScope) {
+  const std::array<absl::string_view, 3> keys = {"あめ", "", "橋と箸"};
+  for (const absl::string_view key : keys) {
+    for (int state = 0; state < 4; ++state) {
+      SCOPED_TRACE(key);
+      SCOPED_TRACE(state);
+      Segment segment;
+      segment.set_key("あめ");
+      if (state == 1) segment.set_context_history_scope(std::nullopt);
+      if (state == 2) segment.set_context_history_scope(Scope(""));
+      if (state == 3) segment.set_context_history_scope(Scope("profile-alpha"));
+      Segment snapshot(segment);
+      segment.set_key(key);
+      EXPECT_EQ(segment.key(), key);
+      ExpectScope(segment, state >= 2 ? Scope("") : Scope(), state >= 2);
+      // Repeating the same assignment cannot restore the previous scope.
+      segment.set_key(key);
+      ExpectScope(segment, state >= 2 ? Scope("") : Scope(), state >= 2);
+      ExpectScope(snapshot, state == 3 ? Scope("profile-alpha")
+                                     : state == 2 ? Scope("") : Scope(),
+                  state != 0);
+      segment.Clear();
+      segment.set_key(key);
+      ExpectScope(segment, std::nullopt, false);
+    }
+  }
+}
+
+TEST(SegmentContextScopeTest, ForwardedStringKeysAlsoInvalidateScope) {
+  Segment segment;
+  const std::string key = "日本語";
+  segment.set_key(key);
+  segment.set_context_history_scope(Scope("profile-alpha"));
+  segment.set_key(key);
+  ExpectScope(segment, Scope(""), true);
+  EXPECT_EQ(segment.key_len(), 3);
+
+  segment.set_context_history_scope(Scope("profile-beta"));
+  segment.set_key(std::string(""));
+  ExpectScope(segment, Scope(""), true);
+  EXPECT_EQ(segment.key_len(), 0);
+  segment.Clear();
+  segment.set_key(std::string("箸"));
+  ExpectScope(segment, std::nullopt, false);
+  EXPECT_EQ(segment.key_len(), 1);
+}
+
+TEST(SegmentContextScopeTest, SegmentsDeepCopyAssignmentAndClearRetainNoAlias) {
+  Segments original;
+  const std::array<Scope, 4> scopes = {
+      std::nullopt, Scope(""), Scope("profile-alpha"), std::nullopt};
+  for (size_t i = 0; i < scopes.size(); ++i) {
+    Segment* segment = original.add_segment();
+    segment->set_key("あめ");
+    segment->add_candidate()->value = "雨";
+    if (i != 0) segment->set_context_history_scope(scopes[i]);
+  }
+  Segments copied(original);
+  Segments assigned;
+  assigned.add_segment()->set_context_history_scope(Scope("profile-old"));
+  assigned = original;
+  ASSERT_EQ(copied.segments_size(), scopes.size());
+  ASSERT_EQ(assigned.segments_size(), scopes.size());
+  for (size_t i = 0; i < scopes.size(); ++i) {
+    SCOPED_TRACE(i);
+    ExpectScope(copied.segment(i), scopes[i], i != 0);
+    ExpectScope(assigned.segment(i), scopes[i], i != 0);
+    ASSERT_EQ(assigned.segment(i).candidates_size(), 1);
+    EXPECT_EQ(assigned.segment(i).candidate(0).value, "雨");
+  }
+  original.mutable_segment(2)->set_key("はし");
+  original.mutable_segment(2)->mutable_candidate(0)->value = "橋";
+  ExpectScope(copied.segment(2), Scope("profile-alpha"), true);
+  EXPECT_EQ(assigned.segment(2).candidate(0).value, "雨");
+
+  copied.Clear();
+  EXPECT_EQ(copied.segments_size(), 0);
+  Segment* reused = copied.add_segment();
+  ExpectScope(*reused, std::nullopt, false);
+  reused->set_key("再利用");
+  ExpectScope(*reused, std::nullopt, false);
+  ExpectScope(assigned.segment(2), Scope("profile-alpha"), true);
+  assigned = copied;
+  ASSERT_EQ(assigned.segments_size(), 1);
+  ExpectScope(assigned.segment(0), std::nullopt, false);
+  EXPECT_EQ(assigned.segment(0).key(), "再利用");
+}
+
+TEST(SegmentContextScopeTest, ReleasedSegmentsAndConversionReuseResetScope) {
+  Segments segments;
+  Segment* first = segments.add_segment();
+  first->set_key("あめ");
+  first->set_context_history_scope(Scope("profile-alpha"));
+  segments.erase_segment(0);
+  EXPECT_EQ(segments.segments_size(), 0);
+  Segment* reused = segments.add_segment();
+  ExpectScope(*reused, std::nullopt, false);
+  reused->set_key("あめ");
+  reused->set_context_history_scope(Scope(""));
+  segments.pop_back_segment();
+  reused = segments.push_front_segment();
+  ExpectScope(*reused, std::nullopt, false);
+
+  reused->set_key("あめ");
+  reused->set_context_history_scope(Scope("profile-beta"));
+  segments.InitForConvert("あめ");
+  ASSERT_EQ(segments.segments_size(), 1);
+  ExpectScope(segments.segment(0), std::nullopt, false);
+  EXPECT_EQ(segments.segment(0).key(), "あめ");
+  segments.mutable_segment(0)->set_context_history_scope(Scope(""));
+  segments.InitForCommit("はし", "箸");
+  ASSERT_EQ(segments.segments_size(), 1);
+  ExpectScope(segments.segment(0), std::nullopt, false);
+  EXPECT_EQ(segments.segment(0).key(), "はし");
+  ASSERT_EQ(segments.segment(0).candidates_size(), 1);
+  EXPECT_EQ(segments.segment(0).candidate(0).value, "箸");
+  segments.Clear();
+  reused = segments.insert_segment(0);
+  ExpectScope(*reused, std::nullopt, false);
+  EXPECT_TRUE(reused->key().empty());
+  EXPECT_EQ(reused->candidates_size(), 0);
+}
+
+}  // namespace
+}  // namespace mozc::converter
