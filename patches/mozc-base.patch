+TEST(AsyncCandidateListBoundaryTest, MoveToEndKeepsIdsAliasesAndFocusedChoice) {
+  for (const int focus : {0, 1, 2}) {
+    CandidateList list;
+    list.AddCandidate(0, "a");
+    list.AddCandidate(1, "b");
+    list.AddCandidate(2, "c");
+    list.AddCandidate(3, "b");  // Alternative ID shares visible candidate 1.
+    ASSERT_TRUE(list.MoveToId(focus));
+    list.MoveCandidateToEnd(1);
+    ASSERT_EQ(list.size(), 3);
+    EXPECT_EQ(list.candidate(0).id(), 0);
+    EXPECT_EQ(list.candidate(1).id(), 2);
+    EXPECT_EQ(list.candidate(2).id(), 1);
+    EXPECT_EQ(list.focused_id(), focus);
+    EXPECT_EQ(list.next_available_id(), 4);
+    EXPECT_TRUE(list.MoveToId(3));
+    EXPECT_EQ(list.focused_id(), 1);
+    list.MoveCandidateToEnd(1);  // Already last: idempotent.
+    list.MoveCandidateToEnd(999);  // Missing ID: no change.
+    EXPECT_EQ(list.focused_id(), 1);
+    EXPECT_EQ(list.candidate(2).id(), 1);
+  }
+  CandidateList empty;
+  empty.MoveCandidateToEnd(0);
+  EXPECT_EQ(empty.size(), 0);
+  CandidateList only;
+  only.AddCandidate(0, "a");
+  only.MoveCandidateToEnd(0);
+  EXPECT_EQ(only.focused_id(), 0);
+  CandidateList with_meta;
+  auto* meta = with_meta.AddSubCandidateList();  // Container's default id is 0.
+  meta->AddCandidate(-1, "meta");
+  with_meta.AddCandidate(0, "command");
+  with_meta.AddCandidate(1, "late");
+  ASSERT_TRUE(with_meta.MoveToId(1));
+  with_meta.MoveCandidateToEnd(0);
+  EXPECT_TRUE(with_meta.candidate(0).HasSubcandidateList());
+  EXPECT_EQ(with_meta.candidate(1).id(), 1);
+  EXPECT_EQ(with_meta.candidate(2).id(), 0);
+  EXPECT_EQ(with_meta.focused_id(), 1);
+}
