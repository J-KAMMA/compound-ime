+bool ValidFullSpanEntry(const FullSpanEntry& entry) {
+  const auto reading = PayloadReading(entry.key());
+  if (entry.key().size() > kFullSpanKeyBytes || !reading || reading->empty() ||
+      !IsValidContextText(*reading) || Util::CharsLen(*reading) > 128 ||
+      entry.value().empty() || entry.value().size() > kFullSpanValueBytes ||
+      !IsValidContextText(entry.value()) || entry.description().size() > 256 ||
+      !IsValidContextText(entry.description()) ||
+      entry.inner_segment_boundary_size() == 0 ||
+      entry.inner_segment_boundary_size() > 128 || entry.removed()) return false;
