+class AsyncSessionBridgeTest : public testing::TestWithTempUserProfile {
+ protected:
+  void SetUp() override {
+    primary_ = std::make_shared<MockConverter>();
+    gate_ = std::make_shared<BridgeGate>();
+    worker_ = std::make_shared<AzooKeyAsyncConverter>(
+        std::make_unique<BridgeProvider>(gate_));
+    EXPECT_CALL(engine_, CreateEngineConverter()).WillOnce([this] {
+      auto converter = std::make_unique<engine::EngineConverter>(primary_);
+      engine_converter_ = converter.get();
+      return std::unique_ptr<engine::EngineConverterInterface>(std::move(converter));
+    });
+    EXPECT_CALL(*primary_, StartConversion(::testing::_, ::testing::_))
+        .WillOnce([](const ConversionRequest& request, Segments* segments) {
+          EXPECT_EQ(request.key(), "はしごはん");
+          segments->Clear();
+          auto* first = segments->add_segment();
+          first->set_key("はし");
+          *first->add_candidate() = BridgeCandidate("はし", "箸");
+          *first->add_candidate() = BridgeCandidate("はし", "橋");
+          auto* next = segments->add_segment();
+          next->set_key("ごはん");
+          *next->add_candidate() = BridgeCandidate("ごはん", "ご飯");
+          return true;
+        });
+    ON_CALL(*primary_, FocusSegmentValue(::testing::_, ::testing::_, ::testing::_))
+        .WillByDefault(::testing::Return(true));
+    ON_CALL(*primary_, CommitSegmentValue(::testing::_, ::testing::_, ::testing::_))
+        .WillByDefault([](Segments* segments, size_t index, int candidate) {
+          if (index >= segments->conversion_segments_size() || candidate < 0 ||
+              candidate >= segments->conversion_segment(index).candidates_size()) return false;
+          segments->mutable_conversion_segment(index)->move_candidate(candidate, 0);
+          return true;
+        });
+    session_ = std::make_unique<Session>(engine_);
+    config::Config config;
+    config.set_session_keymap(config::Config::MSIME);
+    config.set_use_history_suggest(false);
+    session_->SetConfig(config);
+    commands::Request request;
+    request.set_zero_query_suggestion(false);
+    session_->SetRequest(request);
+    // Configuration legitimately cancels before a real job exists.
+    engine_converter_->SetAsyncConverter(worker_);
+  }
+  void TearDown() override {
+    gate_->Release();  // Fatal assertions must not leave the worker gated at join.
+    session_.reset();
+    worker_.reset();
+  }
+  bool Start(commands::Command* initial, bool supports_async = true,
+             bool space_only = false) {
+    auto& context = const_cast<ImeContext&>(session_->context());
+    context.mutable_composer()->SetInputMode(transliteration::HIRAGANA);
+    context.mutable_composer()->InsertCharacterPreedit("はしごはん");
+    context.set_state(ImeContext::COMPOSITION);
+    initial->mutable_input()->set_type(commands::Input::SEND_KEY);
+    initial->mutable_input()->mutable_key()->set_special_key(commands::KeyEvent::SPACE);
+    auto* window = initial->mutable_input()->mutable_context();
+    window->set_preceding_text("synthetic-left");
+    window->set_following_text("synthetic-right");
+    // This direct Composer fixture initializes the context normally captured on
+    // the first precomposition key; conversion-space does not recapture it.
+    if (supports_async && !space_only)
+      window->add_experimental_features("myime_async_conversion_v1");
+    *context.mutable_client_context() = *window;
+    if (space_only) window->add_experimental_features("myime_async_conversion_v1");
+    return session_->SendKey(initial) && session_->context().state() == ImeContext::CONVERSION &&
+           (supports_async && !space_only ? gate_->Wait(&BridgeGate::entered)
+                                          : engine_converter_->GetAsyncConversionToken() == 0);
+  }
+  commands::Command Poll(const commands::SessionCommand& callback) {
+    commands::Command command;
+    command.mutable_input()->set_type(commands::Input::SEND_COMMAND);
+    *command.mutable_input()->mutable_command() = callback;
+    EXPECT_TRUE(session_->SendCommand(&command));
+    return command;
+  }
+  bool Await(const commands::SessionCommand& callback, commands::Command* applied) {
+    const auto limit = std::chrono::steady_clock::now() + std::chrono::seconds(5);
+    do {
+      *applied = Poll(callback);
+      if (!applied->output().consumed()) return false;
+      if (!applied->output().has_callback()) return true;
+      std::this_thread::yield();
+    } while (std::chrono::steady_clock::now() < limit);
+    return false;
+  }
+  std::string PreeditText(const commands::Output& output) {
+    std::string text;
+    for (const auto& segment : output.preedit().segment()) text += segment.value();
+    return text;
+  }
+  commands::Command Command(commands::SessionCommand::CommandType type) {
+    commands::Command command;
+    command.mutable_input()->set_type(commands::Input::SEND_COMMAND);
+    command.mutable_input()->mutable_command()->set_type(type);
+    return command;
+  }
+  void StaleOnly(const commands::SessionCommand& callback) {
+    auto stale = Command(commands::SessionCommand::REQUEST_ASYNC_CONVERSION);
+    *stale.mutable_input()->mutable_command() = callback;
+    stale.mutable_output()->mutable_result()->set_value("synthetic-existing-result");
+    auto expected = stale.output();
+    expected.set_consumed(false);
+    const auto state = session_->context().state();
+    const auto time = session_->last_command_time();
+    EXPECT_TRUE(session_->SendCommand(&stale));
+    EXPECT_EQ(stale.output().SerializePartialAsString(), expected.SerializePartialAsString());
+    EXPECT_EQ(session_->context().state(), state);
+    EXPECT_EQ(session_->last_command_time(), time);
+  }
+  ::testing::NiceMock<MockEngine> engine_;
+  std::shared_ptr<MockConverter> primary_;
+  std::shared_ptr<BridgeGate> gate_;
+  std::shared_ptr<AzooKeyAsyncConverter> worker_;
+  engine::EngineConverter* engine_converter_ = nullptr;
+  std::unique_ptr<Session> session_;
+};
