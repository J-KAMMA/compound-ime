+class UserSegmentHistoryRewriterTestPeer {
+ public:
+  static size_t PayloadCount(const UserSegmentHistoryRewriter& r) {
+    size_t n = 0;
+    if (r.full_span_storage_) r.full_span_storage_->ForEach([&](uint64_t, const auto&) { ++n; return true; });
+    return n;
+  }
+  static size_t Rows(const UserSegmentHistoryRewriter& r) { return r.scoped_storage_->used_size(); }
+  static auto Record(const UserSegmentHistoryRewriter& r, const ConversionRequest& request,
+                     const std::string& reading) {
+    const auto [left, right] = request.GetSurroundingContext();
+    const std::string scope = absl::StrCat("D4F:", CityFingerprint(absl::StrCat(left.size(), ":", left, right.size(), ":", right)));
+    return r.ReadScopedRecord(absl::StrCat(scope.size(), ":", scope, reading.size(), ":", reading));
+  }
+  static bool Replay(const UserSegmentHistoryRewriter& r, const ConversionRequest& request, Segments* segments) {
+    return r.ReplayFullSpan(request, segments);
+  }
+};
+namespace {
+using Peer = UserSegmentHistoryRewriterTestPeer;
+class FullSpanBounds : public testing::TestWithTempUserProfile {
+ protected:
+  FullSpanBounds() : matcher_(data_.GetPosMatcherData()), group_(data_.GetPosGroupData()) {}
+  void SetUp() override {
+    ASSERT_TRUE(IsHermeticTestMode());
+    const char* root = std::getenv("TEST_TMPDIR"); ASSERT_NE(root, nullptr);
+    const auto relative = std::filesystem::u8path(SystemUtil::GetUserProfileDirectory()).lexically_normal()
+        .lexically_relative(std::filesystem::u8path(root).lexically_normal());
+    ASSERT_FALSE(relative.empty()); ASSERT_FALSE(relative.is_absolute());
+    ASSERT_NE(*relative.begin(), std::filesystem::path(".."));
+    config::ConfigHandler::GetDefaultConfig(&config_);
+    config_.set_history_learning_level(config::Config::DEFAULT_HISTORY);
+    config_.set_use_history_suggest(true);
+    context_ = Context("朝"); different_ = Context("昼");
+    r_ = std::make_unique<UserSegmentHistoryRewriter>(matcher_, group_);
+    r_->Clear();
+  }
+  commands::Context Context(const std::string& prefix) const {
+    commands::Context c; c.set_preceding_text(prefix + "ご飯を食べるために"); c.set_following_text("。"); return c;
+  }
+  ConversionRequest Request(const commands::Context& c, bool incognito = false,
+                            bool partial = false, bool internal = false) const {
+    ConversionRequest::Options o; o.enable_user_history_for_conversion = true;
+    o.incognito_mode = incognito; o.create_partial_candidates = partial;
+    o.used_in_predictor_realtime_conversion = internal;
+    return ConversionRequestBuilder().SetConfig(config_).SetRequest(request_)
+        .SetContext(c).SetOptions(o).SetRequestType(ConversionRequest::CONVERSION).Build();
+  }
+  static std::string Repeat(const std::string& s, size_t n) {
+    std::string out; for (size_t i=0;i<n;++i) out += s; return out;
+  }
+  Segments Input(const std::string& reading = "はしをつかいます", size_t count = 2,
+                 size_t candidates = 1) const {
+    Segments s;
+    for (size_t i=0;i<count;++i) {
+      auto* part = s.add_segment();
+      const size_t half = Util::CharsLen(reading) / count;
+      const size_t start = i * half;
+      part->set_key(Util::Utf8SubString(reading, start, i+1==count ? Util::CharsLen(reading)-start : half));
+      part->set_segment_type(Segment::FREE);
+      for (size_t j=0;j<candidates;++j) {
+        auto* c=part->add_candidate(); c->key=c->content_key=part->key();
+        c->value=c->content_value=absl::StrCat("base", i, "-", j);
+        c->lid=c->rid=matcher_.GetGeneralNounId();
+      }
+    }
+    return s;
+  }
+  converter::Candidate Full(const std::string& key, const std::string& value, uint32_t attrs = converter::Attribute::RERANKED) const {
+    converter::Candidate c; c.key=c.content_key=key; c.value=c.content_value=value;
+    c.lid=c.rid=matcher_.GetGeneralNounId(); c.converted_segment_count=2;
+    c.consumed_key_size=Util::CharsLen(key); c.attributes=attrs;
+    const size_t n=std::max((key.size()+254)/255,(value.size()+254)/255);
+    if (!n || n>Util::CharsLen(key) || n>Util::CharsLen(value)) return c;
+    size_t ko=0,vo=0;
+    for (size_t i=0;i<n;++i) {
+      const size_t kc=(Util::CharsLen(key)-ko+n-i-1)/(n-i);
+      const size_t vc=(Util::CharsLen(value)-vo+n-i-1)/(n-i);
+      const auto k=Util::Utf8SubString(key,ko,kc), v=Util::Utf8SubString(value,vo,vc);
+      const auto b=converter::EncodeLengths(k.size(),v.size(),k.size(),v.size());
+      if (!b) { c.inner_segment_boundary.clear(); return c; }
+      c.inner_segment_boundary.push_back(*b); ko+=kc;vo+=vc;
+    }
+    return c;
+  }
+  Segments Commit(const std::string& value, uint64_t owner, const commands::Context& context,
+                  const std::string& reading = "はしをつかいます", uint32_t attrs = converter::Attribute::RERANKED) {
+    auto capture=Input(reading); r_->Rewrite(Request(context), &capture);
+    Segments committed; auto* seg=committed.add_segment(); seg->set_key(reading);
+    seg->set_context_history_scope(capture.conversion_segment(0).context_history_scope());
+    seg->set_segment_type(Segment::FIXED_VALUE); *seg->add_candidate()=Full(reading,value,attrs);
+    committed.set_revert_id(owner); return committed;
+  }
+  void Learn(Segments& commit, const commands::Context& context) { r_->Finish(Request(context),commit); }
+  std::string Replay(const commands::Context& context, const std::string& reading="はしをつかいます") {
+    auto s=Input(reading);r_->Rewrite(Request(context),&s);return s.conversion_segment(0).candidate(0).value;
+  }
+  testing::MockDataManager data_; dictionary::PosMatcher matcher_; dictionary::PosGroup group_;
+  config::Config config_; commands::Request request_; commands::Context context_,different_;
+  std::unique_ptr<UserSegmentHistoryRewriter> r_;
+};
+TEST_F(FullSpanBounds, RestartSameCrossAndSingleSegmentation) {
+  auto commit=Commit("箸を使います",11,context_);Learn(commit,context_);
+  ASSERT_EQ(Peer::Rows(*r_),1);ASSERT_EQ(Peer::PayloadCount(*r_),1);
+  ASSERT_TRUE(r_->Sync());r_.reset();r_=std::make_unique<UserSegmentHistoryRewriter>(matcher_,group_);
+  EXPECT_EQ(Replay(context_),"箸を使います");EXPECT_NE(Replay(different_),"箸を使います");
+  auto single=Input("はしをつかいます",1);r_->Rewrite(Request(context_),&single);
+  EXPECT_EQ(single.conversion_segment(0).candidate(0).value,"箸を使います");
