+  ExpectCapturedScope(context, "はし", CapturedScope::kBlocked);
+  context.set_preceding_text("川");
+  context.set_following_text(" " + std::string(160, 'y') + " \r\ndiscarded");
+  ExpectCapturedScope(context, "はし", CapturedScope::kScoped);
+  context.set_following_text(" " + std::string(161, 'y') + " \r\ndiscarded");
+  ExpectCapturedScope(context, "はし", CapturedScope::kBlocked);
+  std::string multibyte;
+  for (int i = 0; i < 53; ++i) multibyte.append("川");
