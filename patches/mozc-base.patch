+#include <vector>
+
+#include "converter/immutable_converter_interface.h"
+#include "converter/segments.h"
+#include "gtest/gtest.h"
+#include "request/options.h"
+
+namespace mozc {
+
+struct AzooKeyAsyncConverterTestPeer {
+  static void SetNextId(AzooKeyAsyncConverter& worker, uint64_t id) {
+    std::lock_guard<std::mutex> lock(worker.mutex_);
+    worker.next_id_ = id;
+  }
+  static bool HasCompleted(AzooKeyAsyncConverter& worker, uint64_t id) {
+    std::lock_guard<std::mutex> lock(worker.mutex_);
+    return worker.completed_ && worker.completed_->id == id;
+  }
+};
+
+namespace {
+using namespace std::chrono_literals;
+using Clock = std::chrono::steady_clock;
+constexpr auto kWait = 2s;
+constexpr auto kProviderWait = 5s;
+constexpr size_t kContextLimit = 1024 * 1024;
+
+enum class Outcome { kSuccess, kFalse, kThrow };
+struct Call {
+  std::string key, left, right;
+};
+struct ProviderState {
+  std::mutex mutex;
+  std::condition_variable changed;
+  size_t started = 0;
+  size_t finished = 0;
+  size_t active = 0;
+  size_t permitted = 0;
+  bool release_all = false;
+  bool wait_timed_out = false;
+  bool destroyed = false;
+  bool destroyed_while_active = false;
+  std::vector<Outcome> outcomes;
+  std::vector<Call> calls;
+  std::vector<std::string> lifetime_events;
+};
+
+// Gate the real worker's provider, not a replacement scheduler. Every wait has a
+// deadline; fixture cleanup releases the gate before joining, even after ASSERT.
+class PausedConverter final : public ImmutableConverterInterface {
+ public:
+  explicit PausedConverter(std::shared_ptr<ProviderState> state)
+      : state_(std::move(state)) {}
+  ~PausedConverter() override {
+    std::lock_guard<std::mutex> lock(state_->mutex);
+    state_->destroyed = true;
+    state_->destroyed_while_active = state_->active != 0;
+    state_->lifetime_events.push_back("destroy");
+    state_->changed.notify_all();
+  }
+
+  bool Convert(const ConversionOptions& options, Segments* segments) const override {
+    ADD_FAILURE() << "Worker must forward owned contexts via ConvertWithContext";
+    return ConvertWithContext(options, segments, {}, {});
+  }
+
+  bool ConvertWithContext(const ConversionOptions& options, Segments* segments,
+                          std::string_view left,
+                          std::string_view right) const override {
+    EXPECT_EQ(options.request_type, RequestType::CONVERSION);
+    EXPECT_FALSE(options.enable_user_history_for_conversion);
+    EXPECT_TRUE(options.incognito_mode);
+    EXPECT_FALSE(options.create_partial_candidates);
+    EXPECT_FALSE(options.used_in_predictor_realtime_conversion);
+    if (segments == nullptr || segments->conversion_segments_size() != 1) {
+      ADD_FAILURE() << "Provider requires one owned conversion segment";
+      return false;
+    }
+    size_t ordinal;
+    Outcome outcome;
+    Call call;
+    {
+      std::unique_lock<std::mutex> lock(state_->mutex);
+      ordinal = ++state_->started;
+      ++state_->active;
+      outcome = ordinal <= state_->outcomes.size()
+                    ? state_->outcomes[ordinal - 1]
+                    : Outcome::kSuccess;
+      state_->changed.notify_all();
+      if (!state_->changed.wait_until(lock, Clock::now() + kProviderWait, [&] {
+            return state_->release_all || state_->permitted >= ordinal;
+          })) {
+        state_->wait_timed_out = true;
+      }
+      // Read views only after the caller has had a chance to mutate/destroy its
+      // originals. Recording them before the gate would hide a lifetime bug.
+      call = {std::string(segments->conversion_segment(0).key()), std::string(left),
+              std::string(right)};
+      state_->calls.push_back(call);
+    }
+    struct Completion {
+      std::shared_ptr<ProviderState> state;
+      ~Completion() {
+        std::lock_guard<std::mutex> lock(state->mutex);
+        --state->active;
+        ++state->finished;
+        state->lifetime_events.push_back("exit");
+        state->changed.notify_all();
+      }
+    } completion{state_};
+    if (outcome == Outcome::kThrow) {
+      throw std::runtime_error("provider failure");
+    }
+    if (outcome == Outcome::kFalse) {
+      return false;
+    }
+    auto* candidate = segments->mutable_conversion_segment(0)->add_candidate();
+    candidate->key = call.key;
+    candidate->content_key = call.key;
+    candidate->value = call.key + "#" + std::to_string(ordinal);
+    candidate->content_value = candidate->value;
+    return true;
+  }
+
+ private:
+  const std::shared_ptr<ProviderState> state_;
+};
+
+std::string Repeat(std::string_view text, size_t count) {
+  std::string result;
+  for (size_t i = 0; i < count; ++i) {
+    result.append(text);
+  }
+  return result;
+}
+
+class AzooKeyAsyncConverterTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    state_ = std::make_shared<ProviderState>();
+    worker_ = std::make_unique<AzooKeyAsyncConverter>(
+        std::make_unique<PausedConverter>(state_));
+  }
+  void TearDown() override {
+    ReleaseAll();
+    worker_.reset();
+    std::lock_guard<std::mutex> lock(state_->mutex);
+    EXPECT_FALSE(state_->wait_timed_out) << "Provider gate reached its deadline";
+    EXPECT_FALSE(state_->destroyed_while_active);
+  }
+  void ReleaseAll() {
+    std::lock_guard<std::mutex> lock(state_->mutex);
+    state_->release_all = true;
+    state_->changed.notify_all();
+  }
+  void Permit(size_t ordinal) {
+    std::lock_guard<std::mutex> lock(state_->mutex);
+    state_->permitted = ordinal;
+    state_->changed.notify_all();
+  }
+  bool WaitStarted(size_t count) {
+    std::unique_lock<std::mutex> lock(state_->mutex);
+    return state_->changed.wait_until(lock, Clock::now() + kWait,
+                                     [&] { return state_->started >= count; });
+  }
+  bool WaitFinished(size_t count) {
+    std::unique_lock<std::mutex> lock(state_->mutex);
+    return state_->changed.wait_until(lock, Clock::now() + kWait,
+                                     [&] { return state_->finished >= count; });
+  }
+  std::optional<AzooKeyAsyncResult> WaitResult(uint64_t id) {
+    return WaitResult(*worker_, id);
+  }
+  static std::optional<AzooKeyAsyncResult> WaitResult(
+      AzooKeyAsyncConverter& worker, uint64_t id) {
+    const auto deadline = Clock::now() + kWait;
+    do {
+      const bool current = worker.IsCurrent(id);
+      if (auto result = worker.Take(id)) {
+        EXPECT_TRUE(current);  // A ready result remains current until Take.
+        EXPECT_FALSE(worker.IsCurrent(id));
+        return result;
+      }
+      std::this_thread::sleep_for(1ms);
+    } while (Clock::now() < deadline);
+    return std::nullopt;
+  }
+  // If an API blocks, release the provider and join before returning a failure.
+  // This is a bounded liveness check, not a latency benchmark.
+  bool WhileProviderPaused(const std::function<void()>& action) {
+    std::mutex mutex;
+    std::condition_variable changed;
+    bool done = false;
+    std::thread caller([&] {
+      action();
+      std::lock_guard<std::mutex> lock(mutex);
+      done = true;
+      changed.notify_all();
+    });
+    bool returned;
+    {
+      std::unique_lock<std::mutex> lock(mutex);
+      returned = changed.wait_until(lock, Clock::now() + 1s, [&] { return done; });
+    }
+    if (!returned) {
+      ReleaseAll();
+    }
+    caller.join();
+    return returned;
+  }
+  static std::string Value(const AzooKeyAsyncResult& result) {
+    return result.segments->conversion_segment(0).candidate(0).value;
+  }
+  std::shared_ptr<ProviderState> state_;
+  std::unique_ptr<AzooKeyAsyncConverter> worker_;
+};
+
+TEST_F(AzooKeyAsyncConverterTest, RejectsNullProvider) {
+  EXPECT_THROW((void)std::make_unique<AzooKeyAsyncConverter>(nullptr),
+               std::invalid_argument);
+}
+
+TEST_F(AzooKeyAsyncConverterTest, SubmitTakeAndCancelDoNotWaitForInference) {
+  const uint64_t first = worker_->Submit({"あめ", "左", "右"});
+  ASSERT_NE(first, 0);
+  ASSERT_TRUE(WaitStarted(1));
+  uint64_t pending = 0;
+  bool had_result = true;
+  EXPECT_TRUE(WhileProviderPaused([&] {
+    pending = worker_->Submit({"はし", {}, {}});
+    EXPECT_TRUE(worker_->IsCurrent(pending));
+    EXPECT_FALSE(worker_->IsCurrent(first));
+    had_result = worker_->Take(first).has_value();
+    worker_->Cancel();
+    EXPECT_FALSE(worker_->IsCurrent(pending));
+  }));
+  EXPECT_NE(pending, 0);
+  EXPECT_FALSE(had_result);
+  std::lock_guard<std::mutex> lock(state_->mutex);
+  EXPECT_EQ(state_->finished, 0);
+}
+
+TEST_F(AzooKeyAsyncConverterTest, LatestPendingReplacesIntermediateRequest) {
+  const uint64_t first = worker_->Submit({"あめ", {}, {}});
+  ASSERT_TRUE(WaitStarted(1));
+  const uint64_t middle = worker_->Submit({"にほんご", {}, {}});
+  const uint64_t latest = worker_->Submit({"とうきょう", {}, {}});
+  ASSERT_NE(first, 0);
+  ASSERT_NE(middle, 0);
+  ASSERT_NE(latest, 0);
+  EXPECT_LT(first, middle);
+  EXPECT_LT(middle, latest);
+  EXPECT_FALSE(worker_->IsCurrent(first));
+  EXPECT_FALSE(worker_->IsCurrent(middle));
+  EXPECT_TRUE(worker_->IsCurrent(latest));
+  ReleaseAll();
+  auto result = WaitResult(latest);
+  ASSERT_TRUE(result);
+  ASSERT_TRUE(result->segments);
+  EXPECT_EQ(result->id, latest);
+  EXPECT_EQ(Value(*result), "とうきょう#2");
+  EXPECT_FALSE(worker_->Take(first));
+  EXPECT_FALSE(worker_->Take(middle));
+  std::lock_guard<std::mutex> lock(state_->mutex);
+  ASSERT_EQ(state_->calls.size(), 2);
+  EXPECT_EQ(state_->calls[0].key, "あめ");
+  EXPECT_EQ(state_->calls[1].key, "とうきょう");
+}
+
+TEST_F(AzooKeyAsyncConverterTest, SameKeyAbaRejectsOldToken) {
+  const uint64_t old = worker_->Submit({"はし", "橋", {}});
+  ASSERT_TRUE(WaitStarted(1));
+  const uint64_t middle = worker_->Submit({"あめ", {}, {}});
+  const uint64_t latest = worker_->Submit({"はし", "箸", {}});
+  ASSERT_NE(old, latest);
+  EXPECT_FALSE(worker_->Take(old));
+  ReleaseAll();
+  auto result = WaitResult(latest);
+  ASSERT_TRUE(result);
+  ASSERT_TRUE(result->segments);
+  EXPECT_EQ(result->id, latest);
+  EXPECT_EQ(Value(*result), "はし#2");
+  EXPECT_FALSE(worker_->Take(old));
+  EXPECT_FALSE(worker_->Take(middle));
+  std::lock_guard<std::mutex> lock(state_->mutex);
+  ASSERT_EQ(state_->calls.size(), 2);
+  EXPECT_EQ(state_->calls[1].left, "箸");
+}
+
+TEST_F(AzooKeyAsyncConverterTest, RequestAndResultOwnTheirStrings) {
+  uint64_t id;
+  {
+    AzooKeyAsyncRequest request{"あめ", "🌧️ 雨の日", "右の文。"};
+    id = worker_->Submit(request);
+    ASSERT_NE(id, 0);
+    ASSERT_TRUE(WaitStarted(1));
+    request.key.assign(128, 'x');
+    request.left_context.assign(512, 'y');
+    request.right_context.clear();
+  }
+  ReleaseAll();
+  auto first = WaitResult(id);
+  ASSERT_TRUE(first);
+  ASSERT_TRUE(first->segments);
+  EXPECT_EQ(Value(*first), "あめ#1");
+  {
+    std::lock_guard<std::mutex> lock(state_->mutex);
+    ASSERT_EQ(state_->calls.size(), 1);
+    EXPECT_EQ(state_->calls[0].key, "あめ");
+    EXPECT_EQ(state_->calls[0].left, "🌧️ 雨の日");
+    EXPECT_EQ(state_->calls[0].right, "右の文。");
+  }
+  auto second = WaitResult(worker_->Submit({"はし", {}, {}}));
+  ASSERT_TRUE(second);
+  ASSERT_TRUE(second->segments);
+  EXPECT_EQ(Value(*second), "はし#2");
+  worker_.reset();
+  EXPECT_EQ(Value(*first), "あめ#1");
+}
+
+TEST_F(AzooKeyAsyncConverterTest, FalseAndThrowHaveOwnedFailureAndWorkerIsReusable) {
+  {
+    std::lock_guard<std::mutex> lock(state_->mutex);
+    state_->outcomes = {Outcome::kSuccess, Outcome::kFalse, Outcome::kThrow,
+                        Outcome::kSuccess};
+  }
+  ReleaseAll();
+  for (size_t i = 0; i < 4; ++i) {
+    const uint64_t id = worker_->Submit({"あめ", {}, {}});
+    ASSERT_NE(id, 0);
+    auto result = WaitResult(id);
+    ASSERT_TRUE(result) << i;
+    EXPECT_EQ(result->id, id);
+    if (i == 0 || i == 3) {
+      ASSERT_TRUE(result->segments);
+      EXPECT_EQ(Value(*result), i == 0 ? "あめ#1" : "あめ#4");
+    } else {
+      EXPECT_FALSE(result->segments);
+    }
+    EXPECT_FALSE(worker_->Take(id));
+  }
+}
+
+TEST_F(AzooKeyAsyncConverterTest, CancelDropsPendingAndRejectsInFlightResult) {
+  const uint64_t first = worker_->Submit({"あめ", {}, {}});
+  ASSERT_TRUE(WaitStarted(1));
+  const uint64_t pending = worker_->Submit({"捨てる", {}, {}});
+  EXPECT_TRUE(worker_->IsCurrent(pending));
+  worker_->Cancel();
+  worker_->Cancel();
+  EXPECT_FALSE(worker_->IsCurrent(first));
+  EXPECT_FALSE(worker_->IsCurrent(pending));
+  Permit(1);
+  ASSERT_TRUE(WaitFinished(1));
+  EXPECT_FALSE(worker_->Take(first));
+  EXPECT_FALSE(worker_->Take(pending));
+  const uint64_t next = worker_->Submit({"はし", {}, {}});
+  ReleaseAll();
+  auto result = WaitResult(next);
+  ASSERT_TRUE(result);
+  ASSERT_TRUE(result->segments);
+  EXPECT_EQ(Value(*result), "はし#2");
+  std::lock_guard<std::mutex> lock(state_->mutex);
+  ASSERT_EQ(state_->calls.size(), 2);
+  EXPECT_EQ(state_->calls[1].key, "はし");
+}
+
+TEST_F(AzooKeyAsyncConverterTest, WrongAndZeroTokensDoNotConsumeLatestResult) {
+  EXPECT_FALSE(worker_->IsCurrent(0));
+  EXPECT_FALSE(worker_->IsCurrent(1));
+  const uint64_t id = worker_->Submit({"あめ", {}, {}});
+  ASSERT_NE(id, 0);
+  EXPECT_TRUE(worker_->IsCurrent(id));
+  EXPECT_FALSE(worker_->IsCurrent(0));
+  EXPECT_FALSE(worker_->IsCurrent(id + 1));
+  ASSERT_TRUE(WaitStarted(1));
+  ReleaseAll();
+  ASSERT_TRUE(WaitFinished(1));
+  EXPECT_TRUE(worker_->IsCurrent(id));
+  EXPECT_FALSE(worker_->Take(0));
+  EXPECT_FALSE(worker_->Take(id + 1));
+  auto result = WaitResult(id);
+  ASSERT_TRUE(result);
+  ASSERT_TRUE(result->segments);
+  EXPECT_EQ(Value(*result), "あめ#1");
+  EXPECT_FALSE(worker_->Take(id));
+}
+
+TEST_F(AzooKeyAsyncConverterTest, ExhaustedIdDoesNotReplaceCurrentOrWrap) {
+  constexpr uint64_t kMax = std::numeric_limits<uint64_t>::max();
+  AzooKeyAsyncConverterTestPeer::SetNextId(*worker_, kMax - 1);
+  const uint64_t id = worker_->Submit({"あめ", {}, {}});
+  ASSERT_EQ(id, kMax);
+  ASSERT_TRUE(WaitStarted(1));
+  EXPECT_TRUE(worker_->IsCurrent(kMax));
+  EXPECT_EQ(worker_->Submit({"はし", {}, {}}), 0);
+  EXPECT_TRUE(worker_->IsCurrent(kMax));
+  EXPECT_FALSE(worker_->IsCurrent(0));
+  ReleaseAll();
+  auto result = WaitResult(kMax);
+  ASSERT_TRUE(result);
+  ASSERT_TRUE(result->segments);
+  EXPECT_EQ(Value(*result), "あめ#1");
+  EXPECT_FALSE(worker_->IsCurrent(kMax));
+  worker_->Cancel();
+  EXPECT_EQ(worker_->Submit({"とうきょう", {}, {}}), 0);
+  EXPECT_FALSE(worker_->IsCurrent(kMax));
+  EXPECT_FALSE(worker_->Take(0));
+  std::lock_guard<std::mutex> lock(state_->mutex);
+  EXPECT_EQ(state_->started, 1);
+}
+
+TEST_F(AzooKeyAsyncConverterTest, InvalidInputsDoNotReplaceCurrentRequest) {
+  const uint64_t id = worker_->Submit({"あめ", {}, {}});
+  ASSERT_TRUE(WaitStarted(1));
+  const std::string nul("a\0b", 3);
+  const std::vector<std::string> malformed = {
+      "\xC0\xAF", "\xED\xA0\x80", "\xF4\x90\x80\x80", "\xE3\x81"};
+  EXPECT_EQ(worker_->Submit({{}, {}, {}}), 0);
+  EXPECT_EQ(worker_->Submit({nul, {}, {}}), 0);
+  EXPECT_EQ(worker_->Submit({"あめ", nul, {}}), 0);
+  EXPECT_EQ(worker_->Submit({"あめ", {}, nul}), 0);
+  for (const auto& bytes : malformed) {
+    EXPECT_EQ(worker_->Submit({bytes, {}, {}}), 0);
+    EXPECT_EQ(worker_->Submit({"あめ", bytes, {}}), 0);
+    EXPECT_EQ(worker_->Submit({"あめ", {}, bytes}), 0);
+  }
+  EXPECT_EQ(worker_->Submit({Repeat("あ", 129), {}, {}}), 0);
+  EXPECT_EQ(worker_->Submit({"あめ", std::string(kContextLimit + 1, 'a'), {}}), 0);
+  EXPECT_EQ(worker_->Submit({"あめ", {}, std::string(kContextLimit + 1, 'b')}), 0);
+  ReleaseAll();
+  auto result = WaitResult(id);
+  ASSERT_TRUE(result);
+  ASSERT_TRUE(result->segments);
+  EXPECT_EQ(Value(*result), "あめ#1");
+  std::lock_guard<std::mutex> lock(state_->mutex);
+  EXPECT_EQ(state_->started, 1);
+}
+
+TEST_F(AzooKeyAsyncConverterTest, ScalarLimitCountsCombiningAndZwjScalars) {
+  ReleaseAll();
+  const std::vector<std::string> accepted = {
+      Repeat("あ", 128), Repeat("😀", 128), Repeat("é", 64),
+      Repeat("👩‍💻", 42)};
+  for (const auto& key : accepted) {
+    const uint64_t id = worker_->Submit({key, {}, {}});
+    ASSERT_NE(id, 0);
+    auto result = WaitResult(id);
+    ASSERT_TRUE(result);
+    ASSERT_TRUE(result->segments);
+    EXPECT_EQ(result->segments->conversion_segment(0).key(), key);
+  }
+  for (const auto& key : {Repeat("あ", 129), Repeat("😀", 129),
+                          Repeat("é", 65), Repeat("👩‍💻", 43)}) {
+    EXPECT_EQ(worker_->Submit({key, {}, {}}), 0);
+  }
+  std::lock_guard<std::mutex> lock(state_->mutex);
+  EXPECT_EQ(state_->started, accepted.size());
+}
+
+TEST_F(AzooKeyAsyncConverterTest, ContextByteLimitAcceptsExactOneMiB) {
+  const std::string left(kContextLimit, 'a');
+  const std::string right = Repeat("あ", kContextLimit / 3) + "a";
+  ASSERT_EQ(right.size(), kContextLimit);
+  const uint64_t id = worker_->Submit({"あめ", left, right});
+  ASSERT_NE(id, 0);
+  ASSERT_TRUE(WaitStarted(1));
+  EXPECT_EQ(worker_->Submit({"はし", left + "b", right}), 0);
+  EXPECT_EQ(worker_->Submit({"はし", left, right + "b"}), 0);
+  ReleaseAll();
+  auto result = WaitResult(id);
+  ASSERT_TRUE(result);
+  ASSERT_TRUE(result->segments);
+  std::lock_guard<std::mutex> lock(state_->mutex);
+  ASSERT_EQ(state_->calls.size(), 1);
+  EXPECT_EQ(state_->calls[0].left, left);
+  EXPECT_EQ(state_->calls[0].right, right);
+}
+
+TEST_F(AzooKeyAsyncConverterTest, DestructionJoinsBeforeProviderDestruction) {
+  ASSERT_NE(worker_->Submit({"あめ", {}, {}}), 0);
+  ASSERT_TRUE(WaitStarted(1));
+  ASSERT_NE(worker_->Submit({"捨てる", {}, {}}), 0);
+  std::mutex mutex;
+  std::condition_variable changed;
+  bool began = false;
+  bool done = false;
+  std::thread destroyer([&, owned = std::move(worker_)]() mutable {
+    {
+      std::lock_guard<std::mutex> lock(mutex);
+      began = true;
+      changed.notify_all();
+    }
+    owned.reset();
+    std::lock_guard<std::mutex> lock(mutex);
+    done = true;
+    changed.notify_all();
+  });
+  bool observed_begin;
+  bool finished_while_paused;
+  {
+    std::unique_lock<std::mutex> lock(mutex);
+    observed_begin = changed.wait_until(lock, Clock::now() + kWait,
+                                       [&] { return began; });
+    finished_while_paused = changed.wait_for(lock, 100ms, [&] { return done; });
+  }
+  {
+    std::lock_guard<std::mutex> lock(state_->mutex);
+    EXPECT_FALSE(state_->destroyed);
+    EXPECT_EQ(state_->active, 1);
+  }
+  // No assertions can abandon the joinable thread before releasing the gate.
+  ReleaseAll();
+  destroyer.join();
+  EXPECT_TRUE(observed_begin);
+  EXPECT_FALSE(finished_while_paused);
+  std::lock_guard<std::mutex> lock(state_->mutex);
+  EXPECT_TRUE(state_->destroyed);
+  EXPECT_FALSE(state_->destroyed_while_active);
+  EXPECT_EQ(state_->active, 0);
+  EXPECT_EQ(state_->started, 1);
+  EXPECT_EQ(state_->lifetime_events,
+            (std::vector<std::string>{"exit", "destroy"}));
+}
+
+
+TEST_F(AzooKeyAsyncConverterTest, TokenCancelStaleAndZeroPreservePending) {
+  const uint64_t old = worker_->Submit({"あめ", {}, {}});
+  ASSERT_TRUE(WaitStarted(1));
+  const uint64_t current = worker_->Submit({"はし", "別Session", {}});
+  ASSERT_NE(current, 0);
+  EXPECT_TRUE(WhileProviderPaused([&] {
+    worker_->Cancel(old);
+    worker_->Cancel(0);
+  }));
+  EXPECT_TRUE(worker_->IsCurrent(current));
+  ReleaseAll();
+  auto result = WaitResult(current);
+  ASSERT_TRUE(result);
+  ASSERT_TRUE(result->segments);
+  EXPECT_EQ(result->id, current);
+  EXPECT_EQ(Value(*result), "はし#2");
+  std::lock_guard<std::mutex> lock(state_->mutex);
+  ASSERT_EQ(state_->calls.size(), 2);
+  EXPECT_EQ(state_->calls[1].left, "別Session");
+}
+
+TEST_F(AzooKeyAsyncConverterTest, TokenCancelCurrentDropsPendingAndActiveResult) {
+  const uint64_t active = worker_->Submit({"あめ", {}, {}});
+  ASSERT_TRUE(WaitStarted(1));
+  const uint64_t pending = worker_->Submit({"捨てる", {}, {}});
+  ASSERT_NE(pending, 0);
+  EXPECT_TRUE(WhileProviderPaused([&] { worker_->Cancel(pending); }));
+  EXPECT_FALSE(worker_->IsCurrent(pending));
+  EXPECT_FALSE(worker_->IsCurrent(active));
+  Permit(1);
+  ASSERT_TRUE(WaitFinished(1));
+  EXPECT_FALSE(worker_->Take(active));
+  EXPECT_FALSE(worker_->Take(pending));
+  const uint64_t next = worker_->Submit({"はし", {}, {}});
+  ReleaseAll();
+  auto result = WaitResult(next);
+  ASSERT_TRUE(result);
+  ASSERT_TRUE(result->segments);
+  EXPECT_EQ(Value(*result), "はし#2");
+  std::lock_guard<std::mutex> lock(state_->mutex);
+  ASSERT_EQ(state_->calls.size(), 2);
+  EXPECT_EQ(state_->calls[1].key, "はし");
+}
+
+TEST_F(AzooKeyAsyncConverterTest, TokenCancelCurrentDropsCompleted) {
+  ReleaseAll();
+  const uint64_t id = worker_->Submit({"あめ", {}, {}});
+  ASSERT_NE(id, 0);
+  const auto deadline = Clock::now() + kWait;
+  while (!AzooKeyAsyncConverterTestPeer::HasCompleted(*worker_, id) &&
+         Clock::now() < deadline) std::this_thread::sleep_for(1ms);
+  ASSERT_TRUE(AzooKeyAsyncConverterTestPeer::HasCompleted(*worker_, id));
+  worker_->Cancel(0);
+  EXPECT_TRUE(worker_->IsCurrent(id));
+  EXPECT_TRUE(AzooKeyAsyncConverterTestPeer::HasCompleted(*worker_, id));
+  worker_->Cancel(id);
+  worker_->Cancel(id);
+  EXPECT_FALSE(worker_->IsCurrent(id));
+  EXPECT_FALSE(AzooKeyAsyncConverterTestPeer::HasCompleted(*worker_, id));
+  EXPECT_FALSE(worker_->Take(id));
+  auto next = WaitResult(worker_->Submit({"はし", {}, {}}));
+  ASSERT_TRUE(next);
+  ASSERT_TRUE(next->segments);
+  EXPECT_EQ(Value(*next), "はし#2");
+}
+
+TEST_F(AzooKeyAsyncConverterTest, TokenCancelSameKeyAbaPreservesNewestCompletion) {
+  const uint64_t old = worker_->Submit({"はし", "橋", {}});
+  ASSERT_TRUE(WaitStarted(1));
+  const uint64_t middle = worker_->Submit({"あめ", {}, {}});
+  const uint64_t current = worker_->Submit({"はし", "箸", {}});
+  ASSERT_NE(old, current);
+  EXPECT_TRUE(WhileProviderPaused([&] {
+    worker_->Cancel(old);
+    worker_->Cancel(middle);
+  }));
+  EXPECT_TRUE(worker_->IsCurrent(current));
+  ReleaseAll();
+  const auto deadline = Clock::now() + kWait;
+  while (!AzooKeyAsyncConverterTestPeer::HasCompleted(*worker_, current) &&
+         Clock::now() < deadline) std::this_thread::sleep_for(1ms);
+  ASSERT_TRUE(AzooKeyAsyncConverterTestPeer::HasCompleted(*worker_, current));
+  worker_->Cancel(old);
+  worker_->Cancel(middle);
+  EXPECT_TRUE(worker_->IsCurrent(current));
+  auto result = WaitResult(current);
+  ASSERT_TRUE(result);
+  ASSERT_TRUE(result->segments);
+  EXPECT_EQ(result->id, current);
+  EXPECT_EQ(Value(*result), "はし#2");
+  std::lock_guard<std::mutex> lock(state_->mutex);
+  ASSERT_EQ(state_->calls.size(), 2);
+  EXPECT_EQ(state_->calls[1].left, "箸");
+}
+
+TEST_F(AzooKeyAsyncConverterTest, RetireDoesNotWaitAndDropsActiveAndPending) {
+  const uint64_t active = worker_->Submit({"あめ", {}, {}});
+  ASSERT_NE(active, 0);
+  ASSERT_TRUE(WaitStarted(1));
+  const uint64_t pending = worker_->Submit({"捨てる", {}, {}});
+  ASSERT_GT(pending, active);
+  uint64_t retired = 0;
+  EXPECT_TRUE(WhileProviderPaused([&] { retired = worker_->Retire(); }));
+  EXPECT_EQ(retired, pending);
+  EXPECT_EQ(worker_->Retire(), pending);
+  EXPECT_EQ(worker_->Submit({"はし", {}, {}}), 0);
+  EXPECT_FALSE(worker_->IsCurrent(active));
+  EXPECT_FALSE(worker_->IsCurrent(pending));
+  EXPECT_FALSE(worker_->Take(active));
+  EXPECT_FALSE(worker_->Take(pending));
+  {
+    std::lock_guard<std::mutex> lock(state_->mutex);
+    EXPECT_EQ(state_->finished, 0);
+    EXPECT_FALSE(state_->destroyed);
+  }
+  ReleaseAll();
+  ASSERT_TRUE(WaitFinished(1));
+  EXPECT_FALSE(AzooKeyAsyncConverterTestPeer::HasCompleted(*worker_, active));
+  EXPECT_FALSE(worker_->Take(active));
+  worker_.reset();
+  std::lock_guard<std::mutex> lock(state_->mutex);
+  EXPECT_EQ(state_->started, 1);
+  EXPECT_EQ(state_->lifetime_events,
+            (std::vector<std::string>{"exit", "destroy"}));
+}
+
+TEST_F(AzooKeyAsyncConverterTest, RetireDropsCompletedResultPermanently) {
+  ReleaseAll();
+  const uint64_t id = worker_->Submit({"あめ", {}, {}});
+  ASSERT_NE(id, 0);
+  const auto deadline = Clock::now() + kWait;
+  while (!AzooKeyAsyncConverterTestPeer::HasCompleted(*worker_, id) &&
+         Clock::now() < deadline) std::this_thread::sleep_for(1ms);
+  ASSERT_TRUE(AzooKeyAsyncConverterTestPeer::HasCompleted(*worker_, id));
+  EXPECT_EQ(worker_->Retire(), id);
+  EXPECT_FALSE(AzooKeyAsyncConverterTestPeer::HasCompleted(*worker_, id));
+  EXPECT_FALSE(worker_->IsCurrent(id));
+  EXPECT_FALSE(worker_->Take(id));
+  worker_->Cancel();
+  worker_->Cancel(id);
+  EXPECT_EQ(worker_->Retire(), id);
+  EXPECT_EQ(worker_->Submit({"はし", {}, {}}), 0);
+}
+
+TEST_F(AzooKeyAsyncConverterTest, ReplacementSeedRejectsOldTokensWithoutReuse) {
+  const uint64_t active = worker_->Submit({"はし", "橋", {}});
+  ASSERT_NE(active, 0);
+  ASSERT_TRUE(WaitStarted(1));
+  const uint64_t pending = worker_->Submit({"はし", "箸", {}});
+  ASSERT_GT(pending, active);
+  const uint64_t seed = worker_->Retire();
+  ASSERT_EQ(seed, pending);
+  auto replacement_state = std::make_shared<ProviderState>();
+  replacement_state->release_all = true;
+  AzooKeyAsyncConverter replacement(
+      std::make_unique<PausedConverter>(replacement_state), seed);
+  const uint64_t next = replacement.Submit({"はし", "新Session", {}});
+  ASSERT_EQ(next, seed + 1);
+  EXPECT_FALSE(replacement.IsCurrent(active));
+  EXPECT_FALSE(replacement.IsCurrent(pending));
+  EXPECT_FALSE(replacement.Take(active));
+  EXPECT_FALSE(replacement.Take(pending));
+  replacement.Cancel(active);
+  replacement.Cancel(pending);
+  EXPECT_TRUE(replacement.IsCurrent(next));
+  auto result = WaitResult(replacement, next);
+  ASSERT_TRUE(result);
+  ASSERT_TRUE(result->segments);
+  EXPECT_EQ(result->id, next);
+  EXPECT_EQ(Value(*result), "はし#1");
+  EXPECT_EQ(worker_->Submit({"はし", {}, {}}), 0);
+  ReleaseAll();
+  ASSERT_TRUE(WaitFinished(1));
+  EXPECT_FALSE(worker_->Take(active));
+  EXPECT_FALSE(worker_->Take(pending));
+}
+
+TEST_F(AzooKeyAsyncConverterTest, SeededTokenExhaustionNeverWraps) {
+  constexpr uint64_t kMax = std::numeric_limits<uint64_t>::max();
+  for (const uint64_t seed : {kMax - 1, kMax}) {
+    auto state = std::make_shared<ProviderState>();
+    state->release_all = true;
+    AzooKeyAsyncConverter worker(std::make_unique<PausedConverter>(state), seed);
+    const uint64_t id = worker.Submit({"あめ", {}, {}});
+    EXPECT_EQ(id, seed == kMax ? 0 : kMax);
+    if (id) {
+      auto result = WaitResult(worker, id);
+      ASSERT_TRUE(result);
+      ASSERT_TRUE(result->segments);
+      EXPECT_EQ(result->id, kMax);
+      EXPECT_EQ(Value(*result), "あめ#1");
+    }
+    EXPECT_EQ(worker.Submit({"はし", {}, {}}), 0);
+    EXPECT_FALSE(worker.IsCurrent(0));
+    EXPECT_FALSE(worker.Take(0));
+    EXPECT_EQ(worker.Retire(), kMax);
+    EXPECT_EQ(worker.Retire(), kMax);
+    EXPECT_EQ(worker.Submit({"はし", {}, {}}), 0);
+    std::lock_guard<std::mutex> lock(state->mutex);
+    EXPECT_EQ(state->started, seed == kMax ? 0 : 1);
+    EXPECT_FALSE(state->wait_timed_out);
+  }
+}
+
+}  // namespace
+}  // namespace mozc
