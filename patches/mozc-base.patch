+  STDMETHODIMP SetGravity(TfEditCookie, TfGravity, TfGravity) override {
+    return E_NOTIMPL;
+  }
+  STDMETHODIMP Clone(ITfRange** range) override {
+    ++clone_calls;
+    if (range == nullptr) {
+      return E_INVALIDARG;
+    }
+    *range = nullptr;
+    if (FAILED(clone_result) || null_clone) {
+      return clone_result;
+    }
+    auto copy = MakeComPtr<FakeRange>(document_, start_, end_);
+    if (copy == nullptr) {
+      return E_OUTOFMEMORY;
+    }
+    *range = copy.detach();
+    return clone_result;
+  }
+  STDMETHODIMP GetContext(ITfContext**) override { return E_NOTIMPL; }
+
+  LONG start() const { return start_; }
+  LONG end() const { return end_; }
+  HRESULT clone_result = S_OK;
+  bool null_clone = false;
+  int clone_calls = 0;
+
+ private:
+  std::wstring_view document_;
+  LONG start_;
+  LONG end_;
+};
+
+class FakeCompositionView final
+    : public ComImplements<ComImplementsTraits, ITfCompositionView> {
+ public:
+  explicit FakeCompositionView(ITfRange* range) : range_(range) {}
+
+  STDMETHODIMP GetOwnerClsid(CLSID*) override { return E_NOTIMPL; }
+  STDMETHODIMP GetRange(ITfRange** range) override {
+    ++get_range_calls;
+    if (range == nullptr) {
+      return E_INVALIDARG;
+    }
+    *range = nullptr;
+    if (FAILED(get_range_result) || null_range) {
+      return get_range_result;
+    }
+    *range = range_.get();
+    if (*range != nullptr) {
+      (*range)->AddRef();
+    }
+    return get_range_result;
+  }
+
+  HRESULT get_range_result = S_OK;
+  bool null_range = false;
+  int get_range_calls = 0;
+
+ private:
+  wil::com_ptr_nothrow<ITfRange> range_;
+};
+
+void ExpectSurroundingContext(ITfRange* selection,
+                              ITfCompositionView* composition,
+                              bool exclude_composition,
+                              const std::wstring& preceding,
+                              const std::wstring& following) {
+  wil::com_ptr_nothrow<ITfRange> range;
+  ASSERT_EQ(TipSurroundingTextUtil::GetContextRange(
+                selection, composition, exclude_composition, range.put()),
+            S_OK);
+  ASSERT_NE(range, nullptr);
+  // Match the production reader: clone each side, collapse at its boundary,
+  // extend by at most 20 UTF-16 units, then read without moving the source range.
+  const TF_HALTCOND halt = {nullptr, TF_ANCHOR_START, TF_HF_OBJECT};
+  for (const bool left : {true, false}) {
+    wil::com_ptr_nothrow<ITfRange> side;
+    ASSERT_EQ(range->Clone(side.put()), S_OK);
+    ASSERT_EQ(side->Collapse(0, left ? TF_ANCHOR_START : TF_ANCHOR_END), S_OK);
+    LONG shifted = 0;
+    ASSERT_EQ(left ? side->ShiftStart(0, -20, &shifted, &halt)
+                   : side->ShiftEnd(0, 20, &shifted, &halt),
+              S_OK);
+    wchar_t buffer[64] = {};
+    ULONG fetched = 0;
+    ASSERT_EQ(side->GetText(0, TF_TF_MOVESTART, buffer, 64, &fetched), S_OK);
+    EXPECT_EQ(std::wstring(buffer, fetched), left ? preceding : following);
+  }
+}
