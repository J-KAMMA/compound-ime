+  const Segments chosen = Select(scope, "橋", "箸", 2102, request);
+  ExpectOrder(scope, "橋", "箸", "箸", "橋", request);
+  rewriter_->Revert(chosen);
+  ExpectOrder(scope, "箸", "橋", "箸", "橋", request);
+  rewriter_.reset();
+
+  ASSERT_TRUE(probe.Open(ScopedStorePath().c_str()));
+  ASSERT_EQ(probe.value_size(), 16);
+  EXPECT_EQ(probe.used_size(), 0);  // Invalid previous owner is missing, not saved.
+  probe.GetAllValues(&values);
+  EXPECT_TRUE(values.empty());
+  probe.Close();
+}
