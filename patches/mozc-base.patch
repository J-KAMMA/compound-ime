+void TrimIncompleteSurrogates(std::wstring& text) {
+  if (!text.empty() && text.front() >= 0xdc00 && text.front() <= 0xdfff) {
+    text.erase(0, 1);
+  }
+  if (!text.empty() && text.back() >= 0xd800 && text.back() <= 0xdbff) {
+    text.pop_back();
+  }
