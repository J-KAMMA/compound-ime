+struct BridgeGate {
+  std::mutex mutex;
+  std::condition_variable ready;
+  bool entered = false, released = false, returned = false, speculative = false;
+  std::string key, left, right;
+  void Release() {
+    std::lock_guard lock(mutex);
+    released = true;
+    ready.notify_all();
+  }
+  bool Wait(bool BridgeGate::*field) {
+    std::unique_lock lock(mutex);
+    return ready.wait_for(lock, std::chrono::seconds(5), [&] { return this->*field; });
+  }
+};
+
+converter::Candidate BridgeCandidate(const std::string& key,
+                                     const std::string& value) {
+  converter::Candidate candidate;
+  candidate.key = candidate.content_key = key;
+  candidate.value = candidate.content_value = value;
+  candidate.consumed_key_size = Util::CharsLen(key);
+  candidate.inner_segment_boundary = {
+      converter::EncodeLengths(key.size(), value.size(), key.size(), value.size()).value()};
+  return candidate;
+}
+
+class BridgeProvider final : public ImmutableConverterInterface {
+ public:
+  explicit BridgeProvider(std::shared_ptr<BridgeGate> gate) : gate_(std::move(gate)) {}
+  bool Convert(const ConversionOptions& options, Segments* segments) const override {
+    return ConvertWithContext(options, segments, {}, {});
+  }
+  bool ConvertWithContext(const ConversionOptions& options, Segments* segments,
+                          std::string_view left, std::string_view right) const override {
+    std::unique_lock lock(gate_->mutex);
+    gate_->key = std::string(segments->conversion_segment(0).key());
+    gate_->left = left;
+    gate_->right = right;
+    gate_->speculative = !options.enable_user_history_for_conversion && options.incognito_mode;
+    gate_->entered = true;
+    gate_->ready.notify_all();
+    if (!gate_->ready.wait_for(lock, std::chrono::seconds(5),
+                               [&] { return gate_->released; })) {
+      return false;
+    }
+    if (gate_->key != "はしごはん") return false;
+    auto candidate = BridgeCandidate("はしごはん", "橋と御飯");
+    candidate.inner_segment_boundary = {
+        converter::EncodeLengths(6, 6, 6, 6).value(),
+        converter::EncodeLengths(9, 6, 9, 6).value()};
+    *segments->mutable_conversion_segment(0)->add_candidate() = std::move(candidate);
+    gate_->returned = true;
+    gate_->ready.notify_all();
+    return true;
+  }
+ private:
+  const std::shared_ptr<BridgeGate> gate_;
+};
