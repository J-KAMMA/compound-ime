+  for (uint32_t encoded : candidate.inner_segment_boundary) {
+    const auto length = converter::DecodeLengths(encoded);
+    if (!length.key_len || !length.value_len || !length.content_key_len ||
+        !length.content_value_len || length.content_key_len > length.key_len ||
+        length.content_value_len > length.value_len ||
+        length.key_len > key.size() - key_offset ||
+        length.value_len > candidate.value.size() - value_offset ||
+        !AsyncText(key.substr(key_offset, length.key_len)) ||
+        !AsyncText(key.substr(key_offset, length.content_key_len)) ||
+        !AsyncText(std::string_view(candidate.value).substr(value_offset, length.value_len)) ||
+        !AsyncText(std::string_view(candidate.value).substr(value_offset, length.content_value_len)))
