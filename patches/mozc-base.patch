+TEST(TipSurroundingTextUtilTest, CompositionOutsideContextIgnoresCaretPosition) {
+  const std::wstring left = Utf8ToWide("左𠮷、");
+  const std::wstring composing = Utf8ToWide("は😀し");
+  const std::wstring right = Utf8ToWide("。右😀");
+  const std::wstring document = left + composing + right;
+  const LONG start = static_cast<LONG>(left.size());
+  const LONG end = start + static_cast<LONG>(composing.size());
+  ASSERT_EQ(composing.size(), 4);
+  const LONG carets[] = {start, start + 3, end};
+  for (const LONG caret : carets) {
+    SCOPED_TRACE(caret);
+    auto selection = MakeComPtr<FakeRange>(document, caret, caret);
+    auto span = MakeComPtr<FakeRange>(document, start, end);
+    auto composition = MakeComPtr<FakeCompositionView>(span.get());
+    ExpectSurroundingContext(selection.get(), composition.get(), true, left,
+                             right);
+    EXPECT_EQ(selection->clone_calls, 0);
+    EXPECT_EQ(composition->get_range_calls, 1);
+    EXPECT_EQ(span->start(), start);
+    EXPECT_EQ(span->end(), end);
+    EXPECT_EQ(selection->start(), caret);
+    EXPECT_EQ(selection->end(), caret);
+  }
+}
