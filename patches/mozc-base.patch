+commands::Output PendingOutput() {
+  commands::Output output;
+  output.set_consumed(true);
+  auto* preedit = output.mutable_preedit();
+  preedit->set_cursor(1);
+  auto* segment = preedit->add_segment();
+  segment->set_annotation(commands::Preedit::Segment::HIGHLIGHT);
+  segment->set_value("橋");
+  segment->set_value_length(1);
+  segment->set_key("はし");
+  auto* window = output.mutable_candidate_window();
+  window->set_size(1);
+  window->set_position(0);
+  window->set_focused_index(0);
+  window->set_category(commands::CONVERSION);
+  auto* candidate = window->add_candidate();
+  candidate->set_index(0);
+  candidate->set_id(7);
+  candidate->set_value("橋");
+  auto* words = output.mutable_all_candidate_words();
+  words->set_category(commands::CONVERSION);
+  words->set_focused_index(0);
+  auto* word = words->add_candidates();
+  word->set_id(7);
+  word->set_index(0);
+  word->set_key("はし");
+  word->set_value("橋");
+  auto* callback = output.mutable_callback();
+  callback->set_delay_millisec(20);
+  callback->mutable_session_command()->set_type(
+      commands::SessionCommand::REQUEST_ASYNC_CONVERSION);
+  callback->mutable_session_command()->set_text("18446744073709551615");
+  return output;
+}
+
+TEST(TipAsyncConversionCallbackTest, DecimalTokenBoundsRemainOpaque) {
+  for (const auto* token : {"1", "4294967296", "18446744073709551615"}) {
+    EXPECT_TRUE(IsAsyncConversionToken(token)) << token;
+  }
+  for (const auto* token : {"", "0", "01", "+1", "-1", " 1", "1 ", "1:2",
+                            "18446744073709551616", "999999999999999999999",
+                            "１"}) {
+    EXPECT_FALSE(IsAsyncConversionToken(token)) << token;
+  }
+  EXPECT_FALSE(IsAsyncConversionToken(std::string("1\0", 2)));
+  const auto output = PendingOutput();
+  ASSERT_TRUE(IsAsyncConversionCallback(output));
+  commands::SessionCommand command = output.callback().session_command();
+  EXPECT_EQ(command.text(), "18446744073709551615");
+  EXPECT_EQ(command.type(), commands::SessionCommand::REQUEST_ASYNC_CONVERSION);
+}
+
+TEST(TipAsyncConversionCallbackTest, MissingCommandMetadataCannotSchedule) {
+  auto output = PendingOutput();
+  output.clear_callback();
+  EXPECT_FALSE(IsAsyncConversionCallback(output));
+  output = PendingOutput();
+  output.mutable_callback()->clear_session_command();
+  EXPECT_FALSE(IsAsyncConversionCallback(output));
+  output = PendingOutput();
+  output.mutable_callback()->mutable_session_command()->clear_type();
+  EXPECT_FALSE(IsAsyncConversionCallback(output));
+  output = PendingOutput();
+  output.mutable_callback()->mutable_session_command()->set_type(
+      commands::SessionCommand::REQUEST_TYPO_SUGGESTION);
+  EXPECT_FALSE(IsAsyncConversionCallback(output));
+  output = PendingOutput();
+  output.mutable_callback()->mutable_session_command()->clear_text();
+  EXPECT_FALSE(IsAsyncConversionCallback(output));
+  output.mutable_callback()->mutable_session_command()->set_text("");
+  EXPECT_FALSE(IsAsyncConversionCallback(output));
+  output = PendingOutput();
+  output.mutable_callback()->clear_delay_millisec();
+  EXPECT_FALSE(IsAsyncConversionCallback(output));
+}
+
+TEST(TipAsyncConversionCallbackTest, DelayHasBothLowerAndUpperBounds) {
+  auto output = PendingOutput();
+  for (uint32_t delay : {1u, 20u, 1000u}) {
+    output.mutable_callback()->set_delay_millisec(delay);
+    EXPECT_TRUE(IsAsyncConversionCallback(output)) << delay;
+  }
+  for (uint32_t delay : {0u, 1001u, std::numeric_limits<uint32_t>::max()}) {
+    output.mutable_callback()->set_delay_millisec(delay);
+    EXPECT_FALSE(IsAsyncConversionCallback(output)) << delay;
+  }
+}
+
+TEST(TipAsyncConversionCallbackTest, FirstConversionPollsWithHiddenWindow) {
+  auto output = PendingOutput();
+  output.clear_candidate_window();
+  EXPECT_TRUE(IsAsyncConversionCallback(output));
+  output.mutable_all_candidate_words()->set_category(commands::SUGGESTION);
+  EXPECT_FALSE(IsAsyncConversionCallback(output));
+  output = PendingOutput();
+  output.clear_candidate_window();
+  output.mutable_all_candidate_words()->Clear();  // No explicit category.
+  EXPECT_FALSE(IsAsyncConversionCallback(output));
+}
+
+TEST(TipAsyncConversionCallbackTest, OnlyActiveConversionPreeditCanPoll) {
+  auto output = PendingOutput();
+  output.clear_all_candidate_words();
+  EXPECT_FALSE(IsAsyncConversionCallback(output));
+  output = PendingOutput();
+  output.mutable_all_candidate_words()->clear_category();
+  EXPECT_FALSE(IsAsyncConversionCallback(output));
+  output = PendingOutput();
+  output.mutable_all_candidate_words()->set_category(commands::SUGGESTION);
+  EXPECT_FALSE(IsAsyncConversionCallback(output));
+  output = PendingOutput();
+  output.mutable_candidate_window()->set_category(commands::SUGGESTION);
+  EXPECT_FALSE(IsAsyncConversionCallback(output));
+  output = PendingOutput();
+  output.clear_preedit();
+  EXPECT_FALSE(IsAsyncConversionCallback(output));
+  output = PendingOutput();
+  output.mutable_preedit()->clear_segment();
+  EXPECT_FALSE(IsAsyncConversionCallback(output));
+  output = PendingOutput();
+  output.mutable_preedit()->mutable_segment(0)->set_value("");
+  EXPECT_FALSE(IsAsyncConversionCallback(output));
+}
+
+TEST(TipAsyncConversionCallbackTest, ContinuationMustKeepOriginalToken) {
+  auto original = PendingOutput();
+  const commands::SessionCommand command = original.callback().session_command();
+  original.mutable_callback()->mutable_session_command()->set_text("1");
+  auto response = PendingOutput();
+  EXPECT_TRUE(IsAsyncConversionContinuation(response, command.text()));
+  response.mutable_callback()->mutable_session_command()->set_text("1");
+  EXPECT_FALSE(IsAsyncConversionContinuation(response, command.text()));
+  response = PendingOutput();
+  response.mutable_callback()->set_delay_millisec(0);
+  EXPECT_FALSE(IsAsyncConversionContinuation(response, command.text()));
+  response = PendingOutput();
+  response.mutable_callback()->clear_session_command();
+  EXPECT_FALSE(IsAsyncConversionContinuation(response, command.text()));
+  response.clear_callback();
+  EXPECT_TRUE(IsAsyncConversionContinuation(response, command.text()));
+  EXPECT_FALSE(IsAsyncConversionCallback(response));  // Terminal, no re-arm.
+}
+
+TEST(TipAsyncConversionCallbackTest, OriginFocusAndFullOutputRejectStaleCallback) {
+  int first = 0, second = 0;
+  const auto output = PendingOutput();
+  const std::string snapshot = output.SerializeAsString();
+  TipIdleResuggestRequest request;
+  request.Arm(&first, 9, snapshot);
+  EXPECT_TRUE(request.IsCurrent(&first, 9, snapshot));
+  EXPECT_FALSE(request.IsCurrent(&second, 9, snapshot));
+  EXPECT_FALSE(request.IsCurrent(&first, 10, snapshot));
+  auto changed = output;
+  changed.mutable_callback()->mutable_session_command()->set_text("1");
+  EXPECT_FALSE(request.IsCurrent(&first, 9, changed.SerializeAsString()));
+  changed = output;
+  changed.mutable_candidate_window()->mutable_candidate(0)->set_value("箸");
+  EXPECT_FALSE(request.IsCurrent(&first, 9, changed.SerializeAsString()));
+  changed = output;
+  changed.mutable_preedit()->mutable_segment(0)->set_value("箸");
+  EXPECT_FALSE(request.IsCurrent(&first, 9, changed.SerializeAsString()));
+}
+
+TEST(TipAsyncConversionCallbackTest, CancelOrReentrantRearmInvalidatesPoll) {
+  int context = 0;
+  const std::string snapshot = PendingOutput().SerializeAsString();
+  TipIdleResuggestRequest live;
+  live.Arm(&context, 9, snapshot);
+  const auto pending = live;
+  live.Reset();  // Timer cancels before sending; keep its independent revision.
+  const uint64_t revision = live.revision();
+  EXPECT_TRUE(pending.IsCurrent(&context, 9, snapshot));
+  EXPECT_TRUE(live.IsCurrentRevision(revision));
+  live.Reset();  // Candidate selection/Submit/Revert or focus/key reentry.
+  EXPECT_FALSE(live.IsCurrentRevision(revision));
+  live.Arm(&context, 9, snapshot);  // Same output/context cannot revive old poll.
+  EXPECT_FALSE(live.IsCurrentRevision(revision));
+  EXPECT_TRUE(live.IsCurrent(&context, 9, snapshot));
+}
+}  // namespace
+}  // namespace mozc::win32::tsf
