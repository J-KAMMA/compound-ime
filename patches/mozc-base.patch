+TEST_F(AsyncFullSpanHistory, ManualFullSpanScopeAndSameCrossContext) {
+  ASSERT_NO_FATAL_FAILURE(Convert("cold_same_", same_, true));
+  const std::string cold_same = Text();
+  ASSERT_NE(cold_same, kManual) << "manual fixture equals cold same-context baseline";
+  ASSERT_NO_FATAL_FAILURE(Cancel(same_));
+  ASSERT_NO_FATAL_FAILURE(Convert("cold_different_", different_, true));
+  const std::string cold_different = Text();
+  ASSERT_NE(cold_different, kManual) << "manual fixture equals cold cross-context baseline";
+  ASSERT_NO_FATAL_FAILURE(Cancel(different_));
+  Close();
+  Rows baseline_scoped, baseline_legacy, baseline_boundary;
+  std::vector<std::string> baseline_global;
+  ASSERT_NO_FATAL_FAILURE(GlobalAfterClose(&baseline_global));
+  ASSERT_TRUE(baseline_global.empty());
+  ASSERT_NO_FATAL_FAILURE(RowsAfterClose("boundary.db", 4, &baseline_boundary, 5000, 0x761fea81));
+  ASSERT_NO_FATAL_FAILURE(RowsAfterClose("context_segment.db", 16, &baseline_scoped));
+  ASSERT_NO_FATAL_FAILURE(RowsAfterClose("segment.db", 4, &baseline_legacy));
+  ASSERT_TRUE(baseline_scoped.empty());
+  ASSERT_NO_FATAL_FAILURE(Build());
+  ASSERT_NO_FATAL_FAILURE(Convert("training_", same_, true));
+  EXPECT_EQ(Text(), cold_same);
+  const auto before = Copy();
+  const std::string trained_scope = Scope(before.conversion_segment(0));
+  ASSERT_TRUE(trained_scope.starts_with("D4M:"));
+  const auto words = command_.output().all_candidate_words();
+  int id = -1, ordinal = -1, matches = 0;
+  for (int i = 0; i < words.candidates_size(); ++i) {
+    if (words.candidates(i).value() == kManual) {
+      ASSERT_TRUE(words.candidates(i).has_id());
+      id = words.candidates(i).id(); ordinal = i; ++matches;
+    }
+  }
+  ASSERT_EQ(matches, 1); ASSERT_GT(ordinal, 0); ASSERT_GE(id, 0);
+  command_.Clear();
+  command_.mutable_input()->set_type(commands::Input::SEND_COMMAND);
+  auto* selection = command_.mutable_input()->mutable_command();
+  selection->set_type(commands::SessionCommand::SELECT_CANDIDATE);
+  selection->set_id(id);
+  ASSERT_TRUE(session_->SendCommand(&command_));
+  ASSERT_EQ(Text(), kManual);
+  EXPECT_EQ(Scope(Copy().conversion_segment(0)), trained_scope);
+  RecordProperty("selected_id", id); RecordProperty("selected_ordinal", ordinal);
+  // Omitted Enter context must use the scope frozen on conversion.
+  ASSERT_TRUE(Send("Enter", same_, false));
+  ASSERT_TRUE(command_.output().has_result());
+  ASSERT_EQ(command_.output().result().key(), kReading);
+  ASSERT_EQ(command_.output().result().value(), kManual);
+  ASSERT_FALSE(command_.output().has_preedit());
+  const auto committed = Copy();
+  int committed_matches = 0;
+  for (const auto& segment : committed.history_segments()) {
+    if (segment.candidates_size() && segment.candidate(0).value == kManual) {
+      ++committed_matches;
+      RecordProperty("committed_scope", Scope(segment));
+      RecordProperty("committed_key", std::string(segment.key()));
+      RecordProperty("committed_attributes", std::to_string(segment.candidate(0).attributes));
+      EXPECT_TRUE(segment.candidate(0).attributes & converter::Attribute::RERANKED);
+      EXPECT_TRUE(segment.context_history_scope() && !segment.context_history_scope()->empty())
+          << "full-span Finish must keep a valid manual-learning scope";
+    }
+  }
+  ASSERT_EQ(committed_matches, 1);
+  ASSERT_TRUE(Send("Enter", same_)); EXPECT_FALSE(command_.output().has_result());
+  Close();
+  Rows trained_scoped, trained_legacy, trained_boundary;
+  std::vector<std::string> trained_global;
+  ASSERT_NO_FATAL_FAILURE(GlobalAfterClose(&trained_global));
+  ASSERT_NO_FATAL_FAILURE(RowsAfterClose("boundary.db", 4, &trained_boundary, 5000, 0x761fea81));
+  EXPECT_EQ(trained_global, baseline_global) << "context-only fullspan leaked to global UHP";
+  EXPECT_EQ(trained_boundary, baseline_boundary) << "context-only fullspan leaked to global boundary";
+  ASSERT_NO_FATAL_FAILURE(RowsAfterClose("context_segment.db", 16, &trained_scoped));
+  ASSERT_NO_FATAL_FAILURE(RowsAfterClose("segment.db", 4, &trained_legacy));
+  RecordProperty("scoped_rows_before", static_cast<int>(baseline_scoped.size()));
+  RecordProperty("scoped_rows_after", static_cast<int>(trained_scoped.size()));
+  EXPECT_GT(trained_scoped.size(), baseline_scoped.size()) << "manual scoped winner missing";
+  EXPECT_EQ(trained_legacy, baseline_legacy) << "scoped full-span must not fall back globally";
+  ASSERT_NO_FATAL_FAILURE(Build());
+  ASSERT_NO_FATAL_FAILURE(Convert("same_", same_, false));
+  EXPECT_EQ(initial_text_, kManual) << "manual preference must be in INITIAL output before late append";
