@@ -0,0 +1,55 @@
+// Copyright 2026 MyIME Project. All rights reserved.
+#ifndef MOZC_WIN32_TIP_TIP_ASYNC_CONVERSION_CALLBACK_H_
+#define MOZC_WIN32_TIP_TIP_ASYNC_CONVERSION_CALLBACK_H_
+
+#include <algorithm>
+#include <cstdint>
+#include <string_view>
+
+#include "protocol/commands.pb.h"
+
+namespace mozc::win32::tsf {
+inline constexpr uint32_t kMaxAsyncConversionPollDelayMs = 1000;
+
+// Keep the worker token opaque: validate decimal uint64 grammar without
+// narrowing through WPARAM/LPARAM, size_t, or a process-local pointer.
+inline bool IsAsyncConversionToken(std::string_view token) {
+  constexpr std::string_view kMax = "18446744073709551615";
+  return !token.empty() && token.size() <= kMax.size() && token.front() != '0' &&
+         std::all_of(token.begin(), token.end(),
+                     [](char c) { return c >= '0' && c <= '9'; }) &&
+         (token.size() < kMax.size() || token <= kMax);
+}
+
+inline bool IsAsyncConversionCallback(const commands::Output& output) {
+  if (!output.has_callback() || !output.callback().has_session_command() ||
+      !output.callback().session_command().has_type() ||
+      output.callback().session_command().type() !=
+          commands::SessionCommand::REQUEST_ASYNC_CONVERSION ||
+      !output.callback().session_command().has_text() ||
+      !IsAsyncConversionToken(output.callback().session_command().text()) ||
+      !output.callback().has_delay_millisec() ||
+      output.callback().delay_millisec() == 0 ||
+      output.callback().delay_millisec() > kMaxAsyncConversionPollDelayMs ||
+      !output.has_all_candidate_words() ||
+      !output.all_candidate_words().has_category() ||
+      output.all_candidate_words().category() != commands::CONVERSION ||
+      (output.has_candidate_window() &&
+       output.candidate_window().category() != commands::CONVERSION) ||
+      !output.has_preedit()) {
+    return false;
+  }
+  return std::any_of(output.preedit().segment().begin(),
+                     output.preedit().segment().end(),
+                     [](const auto& segment) { return !segment.value().empty(); });
+}
+
+// No callback is terminal. A continuation must retain the exact worker token.
+inline bool IsAsyncConversionContinuation(const commands::Output& output,
+                                         std::string_view token) {
+  return !output.has_callback() ||
+         (IsAsyncConversionCallback(output) &&
+          std::string_view(output.callback().session_command().text()) == token);
+}
+}  // namespace mozc::win32::tsf
+#endif  // MOZC_WIN32_TIP_TIP_ASYNC_CONVERSION_CALLBACK_H_
