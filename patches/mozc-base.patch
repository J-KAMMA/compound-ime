+using JsonFields = std::vector<std::pair<std::string, absl::string_view>>;
+
+// Keep completed fields even on truncated legacy input. Optional metadata is
+// trusted only when the complete candidate object was parsed.
+bool ParseJsonObjectFields(absl::string_view json, size_t* pos,
+                           JsonFields* fields) {
+  if (*pos >= json.size() || json[*pos] != '{') return false;
+  ++*pos;
+  SkipJsonWhitespace(json, pos);
+  if (*pos < json.size() && json[*pos] == '}') {
+    ++*pos;
+    return true;
+  }
+  while (*pos < json.size()) {
+    std::string name;
+    if (!ParseJsonStringToken(json, pos, &name)) return false;
+    SkipJsonWhitespace(json, pos);
+    if (*pos >= json.size() || json[(*pos)++] != ':') return false;
+    SkipJsonWhitespace(json, pos);
+    const size_t start = *pos;
+    if (!SkipJsonValue(json, pos)) return false;
+    fields->emplace_back(
+        std::move(name),
+        absl::StripAsciiWhitespace(json.substr(start, *pos - start)));
+    SkipJsonWhitespace(json, pos);
+    if (*pos >= json.size()) return false;
+    if (json[*pos] == '}') {
+      ++*pos;
+      return true;
+    }
+    if (json[(*pos)++] != ',') return false;
+    SkipJsonWhitespace(json, pos);
+  }
+  return false;
+}
+
+std::optional<std::string> JsonStringField(const JsonFields& fields,
+                                           absl::string_view name) {
+  std::optional<std::string> result;
+  for (const auto& [key, value] : fields) {
+    if (key != name) continue;
+    size_t pos = 0;
+    std::string text;
+    result = ParseJsonStringToken(value, &pos, &text) && pos == value.size()
+                 ? std::optional<std::string>(std::move(text))
+                 : std::nullopt;
+  }
+  return result;
+}
+
+std::vector<AzooKeyClauseInfo> ParseClauses(absl::string_view json) {
+  std::vector<AzooKeyClauseInfo> clauses;
+  size_t pos = 0;
+  if (json.empty() || json[pos++] != '[') return {};
+  SkipJsonWhitespace(json, &pos);
+  if (pos < json.size() && json[pos] == ']') return {};
+  while (pos < json.size()) {
+    JsonFields fields;
+    if (!ParseJsonObjectFields(json, &pos, &fields)) return {};
+    auto key = JsonStringField(fields, "key");
+    auto value = JsonStringField(fields, "value");
+    auto content_key = JsonStringField(fields, "contentKey");
+    auto content_value = JsonStringField(fields, "contentValue");
+    if (!key || !value || !content_key || !content_value) return {};
+    clauses.push_back({std::move(*key), std::move(*value),
+                       std::move(*content_key), std::move(*content_value)});
+    SkipJsonWhitespace(json, &pos);
+    if (pos >= json.size()) return {};
+    if (json[pos] == ']')
+      return pos + 1 == json.size() ? clauses
+                                    : std::vector<AzooKeyClauseInfo>{};
+    if (json[pos++] != ',') return {};
+    SkipJsonWhitespace(json, &pos);
+  }
+  return {};
+}
+
+bool ValidMetadataString(absl::string_view value) {
+  return !value.empty() && value.find('\0') == absl::string_view::npos &&
+         Util::IsValidUtf8(value);
+}
+
+bool HasConsumptionMetadata(const AzooKeyCandidateInfo& info,
+                            absl::string_view typed_key) {
+  return ValidMetadataString(info.reading) && ValidMetadataString(info.text) &&
+         ValidMetadataString(info.consumed_key) &&
+         ValidMetadataString(typed_key) &&
+         typed_key.substr(0, info.consumed_key.size()) == info.consumed_key;
+}
+
+void PopulateClauseMetadata(const AzooKeyCandidateInfo& info,
+                            converter::Candidate* candidate) {
+  if (info.segments.empty() ||
+      info.reading.size() > std::numeric_limits<uint32_t>::max() ||
+      info.text.size() > std::numeric_limits<uint32_t>::max())
+    return;
+  converter::InnerSegmentBoundaryBuilder builder;
+  size_t key_offset = 0;
+  size_t value_offset = 0;
+  for (const auto& clause : info.segments) {
+    for (const auto* text : {&clause.key, &clause.value, &clause.content_key,
+                             &clause.content_value}) {
+      if (!ValidMetadataString(*text) ||
+          text->size() > std::numeric_limits<uint8_t>::max())
+        return;
+    }
+    if (clause.key.compare(0, clause.content_key.size(), clause.content_key) !=
+            0 ||
+        clause.value.compare(0, clause.content_value.size(),
+                             clause.content_value) != 0 ||
+        absl::string_view(info.reading).substr(key_offset, clause.key.size()) !=
+            clause.key ||
+        absl::string_view(info.text).substr(
+            value_offset, clause.value.size()) != clause.value)
+      return;
+    key_offset += clause.key.size();
+    value_offset += clause.value.size();
+    builder.Add(clause.key.size(), clause.value.size(),
+                clause.content_key.size(), clause.content_value.size());
+  }
+  if (key_offset != info.reading.size() || value_offset != info.text.size())
+    return;
+  auto boundary = builder.Build(info.reading, info.text);
+  if (boundary.empty()) return;
+  const auto& last = info.segments.back();
+  candidate->content_key = info.reading.substr(
+      0, info.reading.size() - last.key.size() + last.content_key.size());
+  candidate->content_value = info.text.substr(
+      0, info.text.size() - last.value.size() + last.content_value.size());
+  candidate->inner_segment_boundary = std::move(boundary);
+}
