+  const auto& scope = first->context_history_scope();
+  if (first->segment_type() != Segment::FREE || !scope || scope->empty() ||
+      first->candidates_size() == 0 ||
+      segments->conversion_segments_size() > std::numeric_limits<uint32_t>::max()) return false;
+  const std::string full_scope = FullSpanScope(*scope);
+  std::string reading;
+  for (const Segment& part : segments->conversion_segments()) {
+    if (part.candidates_size() == 0 || part.segment_type() != Segment::FREE || !part.context_history_scope() ||
