+TEST_F(AsyncEngineCandidateTest, Byte255And256InnerBoundariesSelectAndCommitFullText) {
+  const auto text = [](size_t bytes) {
+    std::string value;
+    for (int i = 0; i < 85; ++i) value += "漢";
+    if (bytes == 256) value += 'v';
+    return value;
+  };
+  gate_->mutations = {
+    [text](auto& candidate) {
+      candidate.value = candidate.content_value = text(255);
+      candidate.inner_segment_boundary = {*converter::EncodeLengths(6, 255, 6, 255)};
+    },
+    [text](auto& candidate) {
+      candidate.value = candidate.content_value = text(255);
+      candidate.inner_segment_boundary = {*converter::EncodeLengths(3, 126, 3, 126),
+                                          *converter::EncodeLengths(3, 129, 3, 129)};
+    },
+    [text](auto& candidate) {
+      candidate.value = candidate.content_value = text(256);
+      candidate.inner_segment_boundary = {*converter::EncodeLengths(3, 126, 3, 126),
+                                          *converter::EncodeLengths(3, 130, 3, 130)};
+    },
+  };
+  size_t ordinal = 0;
+  for (const size_t bytes : {size_t{255}, size_t{255}, size_t{256}}) {
+    SCOPED_TRACE(bytes);
+    SCOPED_TRACE(ordinal);
+    auto mock = std::make_shared<MockConverter>();
+    EngineConverter engine(mock, request_, config_);
+    engine.SetAsyncConverter(worker_);
+    ASSERT_TRUE(Start(engine, *mock));
+    ASSERT_TRUE(WaitStarted(++ordinal));
+    const auto token = engine.GetAsyncConversionToken();
+    ASSERT_NE(token, 0);
+    Permit(ordinal);
+    EXPECT_EQ(WaitPoll(engine, token), AsyncStatus::kApplied);
+    ASSERT_EQ(GetSegments(engine).conversion_segment(0).candidates_size(), 2);
+    const auto& added = GetSegments(engine).conversion_segment(0).candidate(1);
+    EXPECT_EQ(added.inner_segment_boundary.size(), ordinal == 1 ? 1 : 2);
+    EXPECT_EQ(added.value, text(bytes));
+    EXPECT_EQ(added.consumed_key_size, 2);
+    engine.CandidateMoveToId(1, *composer_);
+    commands::Output output;
+    engine.FillOutput(*composer_, &output);
+    ASSERT_EQ(output.preedit().segment_size(), 1);
+    EXPECT_EQ(output.preedit().segment(0).value(), text(bytes));
+    EXPECT_CALL(*mock, CommitSegmentValue(_, 0, 1))
+        .WillOnce([](Segments* input, size_t index, int id) {
+          auto* segment = input->mutable_conversion_segment(index);
+          segment->set_segment_type(Segment::FIXED_VALUE);
+          segment->move_candidate(id, 0);
+          segment->mutable_candidate(0)->attributes |= converter::Attribute::RERANKED;
+          return true;
+        });
+    EXPECT_CALL(*mock, CommitSegmentValue(_, 1, _)).Times(0);
+    EXPECT_CALL(*mock, FinishConversion(_, _)).Times(1);
+    engine.Commit(*composer_, Window());
+    EXPECT_EQ(GetResult(engine).key(), "あい");
+    EXPECT_EQ(GetResult(engine).value(), text(bytes));
+    std::string keys, values;
+    for (const auto& item : GetResult(engine).tokens()) {
+      keys += item.key();
+      values += item.value();
+    }
+    EXPECT_EQ(keys, "あい");
+    EXPECT_EQ(values, text(bytes));
+  }
+}
