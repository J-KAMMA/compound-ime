+std::optional<UserSegmentHistoryRewriter::ScopedRecord>
+UserSegmentHistoryRewriter::ReadScopedRecord(absl::string_view key) const {
+  if (key.empty() || !scoped_storage_ ||
+      scoped_storage_->value_size() != sizeof(ScopedRecord)) return std::nullopt;
+  const char* data = scoped_storage_->Lookup(key);
+  if (!data) return std::nullopt;
+  ScopedRecord record;
+  std::memcpy(record.data(), data, sizeof(record));
+  return record[1] != 0 ? std::optional<ScopedRecord>(record) : std::nullopt;
+}
+
+bool UserSegmentHistoryRewriter::WriteScopedRecord(
+    absl::string_view key, const ScopedRecord& record) {
+  if (key.empty() || record[1] == 0 || !scoped_storage_ ||
+      scoped_storage_->value_size() != sizeof(record)) return false;
+  char data[sizeof(record)];
+  std::memcpy(data, record.data(), sizeof(record));
+  return scoped_storage_->Insert(key, data);
+}
+
+void UserSegmentHistoryRewriter::RememberScopedWinner(
+    const Segment& segment, uint64_t owner,
+    std::vector<ScopedRevertEntry>& revert_entries) {
+  const auto& scope = segment.context_history_scope();
+  const auto& candidate = segment.candidate(0);
+  if (owner == 0 || !scope || scope->empty() || candidate.value.empty() ||
+      !IsValidContextText(candidate.value) || IsPunctuation(segment, candidate)) {
+    return;
+  }
+  const std::string key = ScopedHistoryKey(*scope, segment.key());
+  const auto previous = ReadScopedRecord(key);
+  const ScopedRecord written = {CityFingerprint(candidate.value), owner};
+  if (WriteScopedRecord(key, written)) {
+    revert_entries.push_back({key, previous, written});
+  }
+}
