+  bool Send(const std::string& key, const commands::Context& context, bool attach = true) {
+    command_.Clear();
+    command_.mutable_input()->set_type(commands::Input::SEND_KEY);
+    if (attach) *command_.mutable_input()->mutable_context() = context;
+    if (!KeyParser::ParseKey(key, command_.mutable_input()->mutable_key())) return false;
+    return session_->SendKey(&command_);
+  }
+  Segments Copy() const { return engine::EngineConverterTest::Copy(session_->context().converter()); }
+  std::string Text() const {
+    std::string text;
+    for (const auto& part : command_.output().preedit().segment()) text += part.value();
+    return text;
+  }
+  static std::string Scope(const Segment& segment) {
+    if (!segment.context_history_scope_initialized()) return "UNINITIALIZED";
+    if (!segment.context_history_scope()) return "LEGACY";
+    return segment.context_history_scope()->empty() ? "BLOCKED" : *segment.context_history_scope();
+  }
+  void Convert(const std::string& stage, const commands::Context& context, bool require_multi) {
+    if (gate_) gate_->Release();
+    gate_ = std::make_shared<Gate>();
+    worker_ = std::make_shared<AzooKeyAsyncConverter>(std::make_unique<FullCandidate>(gate_));
+    engine_converter_->SetAsyncConverter(worker_);
+    for (const char key : std::string(kRoman)) ASSERT_TRUE(Send(std::string(1, key), context));
+    ASSERT_EQ(session_->context().composer().GetQueryForConversion(), kReading);
+    ASSERT_TRUE(Send("Space", context));
+    ASSERT_EQ(session_->context().state(), session::ImeContext::CONVERSION);
+    ASSERT_FALSE(command_.output().has_result());
+    ASSERT_TRUE(command_.output().has_callback());
+    const auto callback = command_.output().callback().session_command();
+    ASSERT_EQ(callback.type(), commands::SessionCommand::REQUEST_ASYNC_CONVERSION);
+    ASSERT_TRUE(gate_->Wait());
+    auto segments = Copy();
+    if (require_multi) ASSERT_GE(segments.conversion_segments_size(), 2);
+    ASSERT_GT(segments.conversion_segments_size(), 0);
+    ASSERT_GT(segments.conversion_segment(0).candidates_size(), 0);
+    std::string reading;
+    for (const auto& segment : segments.conversion_segments()) reading.append(segment.key());
+    ASSERT_EQ(reading, kReading);
+    const auto& first = segments.conversion_segment(0);
+    const std::string initial_scope = Scope(first);
+    RecordProperty(stage + "segments", static_cast<int>(segments.conversion_segments_size()));
+    RecordProperty(stage + "first_key", std::string(first.key()));
+    RecordProperty(stage + "scope_initial", initial_scope);
+    RecordProperty(stage + "preedit_initial", Text());
+    initial_text_ = Text();
+    const auto preedit = command_.output().preedit().SerializeAsString();
+    const auto words = command_.output().all_candidate_words();
+    {
+      std::lock_guard lock(gate_->mutex);
+      gate_->lid = first.candidate(0).lid;
+      gate_->rid = first.candidate(0).rid;
+      ASSERT_TRUE(gate_->speculative);
+    }
+    gate_->Release();
+    const auto limit = std::chrono::steady_clock::now() + std::chrono::seconds(5);
+    do {
+      command_.Clear();
+      command_.mutable_input()->set_type(commands::Input::SEND_COMMAND);
+      *command_.mutable_input()->mutable_command() = callback;
+      ASSERT_TRUE(session_->SendCommand(&command_));
+      ASSERT_TRUE(command_.output().consumed());
+      if (!command_.output().has_callback()) break;
+      std::this_thread::yield();
+    } while (std::chrono::steady_clock::now() < limit);
+    ASSERT_FALSE(command_.output().has_callback()) << "bounded async completion failed";
+    EXPECT_EQ(command_.output().preedit().SerializeAsString(), preedit);
+    const auto& appended = command_.output().all_candidate_words();
+    ASSERT_GE(appended.candidates_size(), words.candidates_size());
+    // A word-register command returns to the UI tail after append; its ordinal
+    // may change while its ID and metadata stay stable.
+    std::vector<int> original_ids, retained_ids;
+    for (const auto& word : words.candidates()) {
+      ASSERT_TRUE(word.has_id());
+      original_ids.push_back(word.id());
+    }
+    for (const auto& word : appended.candidates()) {
+      const auto prior = std::find_if(words.candidates().begin(), words.candidates().end(),
+                                     [&](const auto& old) { return old.id() == word.id(); });
+      if (prior == words.candidates().end()) continue;
+      retained_ids.push_back(word.id());
+      auto old_metadata = *prior;
+      auto new_metadata = word;
+      old_metadata.clear_index();
+      new_metadata.clear_index();
+      EXPECT_EQ(new_metadata.SerializeAsString(), old_metadata.SerializeAsString());
+    }
+    EXPECT_EQ(retained_ids, original_ids);
+    ASSERT_TRUE(words.has_focused_index());
+    ASSERT_TRUE(appended.has_focused_index());
+    ASSERT_LT(words.focused_index(), words.candidates_size());
+    ASSERT_LT(appended.focused_index(), appended.candidates_size());
+    EXPECT_EQ(appended.candidates(appended.focused_index()).id(),
+              words.candidates(words.focused_index()).id());
+    EXPECT_EQ(Scope(Copy().conversion_segment(0)), initial_scope);
+    RecordProperty(stage + "preedit_after_append", Text());
+    int matches = 0;
+    const auto completed = Copy();
+    for (const auto& candidate : completed.conversion_segment(0).candidates()) {
+      if (candidate->value == kManual && candidate->key == kReading &&
+          candidate->effective_converted_segment_count() == segments.conversion_segments_size()) ++matches;
+    }
+    ASSERT_EQ(matches, 1) << "full-span candidate absent/duplicate; fixture not evaluated";
+  }
+  void Cancel(const commands::Context& context) {
