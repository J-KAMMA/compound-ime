+constexpr size_t kFullSpanBytes = 256 * 1024;
+constexpr size_t kFullSpanKeyBytes = 768;
+constexpr size_t kFullSpanValueBytes = 64 * 1024;
+using FullSpanEntry = prediction::UserHistoryStorage::Entry;
+
+std::optional<uint64_t> ParseUnsigned(absl::string_view text) {
+  if (text.empty() || (text.size() > 1 && text.front() == '0')) return std::nullopt;
+  uint64_t value = 0;
+  const auto [end, error] = std::from_chars(text.data(), text.data() + text.size(), value);
+  if (error != std::errc() || end != text.data() + text.size()) return std::nullopt;
+  return value;
+}
+
+std::string FullSpanScope(absl::string_view scope) {
+  if (scope.starts_with("D4:")) scope.remove_prefix(3);
+  else if (scope.starts_with("D4M:")) {
+    scope.remove_prefix(4);
+    scope = scope.substr(0, scope.find(':'));
+  } else return "";
+  return ParseUnsigned(scope) ? absl::StrCat("D4F:", scope) : "";
+}
+
+std::string PayloadKey(absl::string_view scope, absl::string_view reading,
+                       const std::array<uint64_t, 2>& record) {
+  return absl::StrCat(scope.size(), ":", scope, reading.size(), ":", reading,
+                      record[1], ":", record[0]);
+}
+
+std::optional<absl::string_view> PayloadReading(absl::string_view key) {
+  auto frame = [&key]() -> std::optional<absl::string_view> {
+    const size_t colon = key.find(':');
+    if (colon == absl::string_view::npos) return std::nullopt;
+    const auto length = ParseUnsigned(key.substr(0, colon));
+    key.remove_prefix(colon + 1);
+    if (!length || *length > key.size()) return std::nullopt;
+    const auto result = key.substr(0, *length);
+    key.remove_prefix(*length);
+    return result;
+  };
+  const auto scope = frame();
+  const auto reading = frame();
+  if (!scope || !scope->starts_with("D4F:") ||
+      !ParseUnsigned(scope->substr(4)) || !reading) return std::nullopt;
+  const size_t colon = key.find(':');
+  if (colon == absl::string_view::npos) return std::nullopt;
+  const auto owner = ParseUnsigned(key.substr(0, colon));
+  if (!owner || *owner == 0 || !ParseUnsigned(key.substr(colon + 1))) return std::nullopt;
+  return reading;
+}
