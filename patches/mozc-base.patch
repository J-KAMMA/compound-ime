+namespace {
+class AsyncRewriteProbeConverter : public MockConverter {
+ public:
+  std::function<void(const ConversionRequest&, Segments*)> rewrite;
+  mutable size_t rewrite_calls = 0;
+  void RewriteAsyncCandidates(const ConversionRequest& request,
+                              Segments* segments) const override {
+    ++rewrite_calls;
+    if (rewrite) rewrite(request, segments);
+  }
+};
