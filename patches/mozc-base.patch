@@ -0,0 +1,70 @@
+// Copyright 2026. All rights reserved.
+#include "win32/tip/tip_idle_resuggest_request.h"
+#include <cstdint>
+#include <iostream>
+#include <limits>
+#include <stdexcept>
+#include <string>
+namespace mozc::win32::tsf {
+struct TipIdleResuggestRequestTestPeer {
+  static void SetRevision(TipIdleResuggestRequest& request, uint64_t value) {
+    request.revision_ = value;
+  }
+};
+}
+int main() {
+  using mozc::win32::tsf::TipIdleResuggestRequest;
+  int first = 0, second = 0, checks = 0;
+  const std::string output("preedit\0candidate0", 18);
+  auto check = [&](bool ok) {
+    ++checks;
+    if (!ok) throw std::runtime_error("stale idle request accepted");
+  };
+  TipIdleResuggestRequest request;
+  check(!request.IsCurrent(nullptr, 0, ""));
+  check(!request.IsCurrent(&first, 0, ""));
+  request.Arm(&first, 1, output);
+  check(request.IsCurrent(&first, 1, output));
+  check(!request.IsCurrent(&second, 1, output));
+  check(!request.IsCurrent(&first, 2, output));
+  check(!request.IsCurrent(&first, 3, output));  // A -> B -> A focus.
+  check(!request.IsCurrent(&first, 1, "preedit"));
+  check(!request.IsCurrent(&first, 1, std::string("preedit\0candidate1", 18)));
+  auto pending = request;
+  request.Reset();
+  check(!request.IsCurrent(&first, 1, output));
+  check(pending.IsCurrent(&first, 1, output));
+  check(!request.IsCurrentRevision(pending.revision()));
+  const auto canceled_revision = request.revision();
+  check(request.IsCurrentRevision(canceled_revision));
+  request.Reset();
+  check(!request.IsCurrentRevision(canceled_revision));
+  request.Arm(&second, 4, "new output");
+  check(!request.IsCurrent(&first, 1, output));
+  check(request.IsCurrent(&second, 4, "new output"));
+  for (int32_t revision : {std::numeric_limits<int32_t>::min(), 0,
+                           std::numeric_limits<int32_t>::max()}) {
+    request.Arm(&first, revision, output);
+    check(request.IsCurrent(&first, revision, output));
+    check(!request.IsCurrent(&first, revision, output.substr(0,17)));
+    request.Reset();  // Focus wrap and context address reuse must cancel.
+    check(!request.IsCurrent(&first, revision, output));
+  }
+  request.Arm(nullptr, 5, output);
+  check(!request.IsCurrent(nullptr, 5, output));
+  const std::string large(1 << 20, 'x');
+  request.Arm(&first, 6, large);
+  check(request.IsCurrent(&first, 6, large));
+  auto changed = large; changed.back() = 'y';
+  check(!request.IsCurrent(&first, 6, changed));
+  const auto max = std::numeric_limits<uint64_t>::max();
+  mozc::win32::tsf::TipIdleResuggestRequestTestPeer::SetRevision(request, max-1);
+  request.Reset();
+  check(request.revision() == max);
+  check(!request.IsCurrentRevision(max));
+  request.Arm(&first, 6, output);
+  check(!request.IsCurrent(&first, 6, output));
+  request.Reset();
+  check(request.revision() == max);
+  std::cout << checks << " checks PASS\n";
+}
