+  const auto composition = CompositionFingerprint(segments, segment);
+  if (!composition) return std::string();
+  return absl::StrCat("D4M:", CityFingerprint(absl::StrCat(
+      left.size(), ":", left, right.size(), ":", right)), ":", *composition);
+}
