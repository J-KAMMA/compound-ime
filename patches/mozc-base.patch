+      rule->set_group(group);
+      rule->set_preedit_character_form(config::Config::FULL_WIDTH);
+      rule->set_conversion_character_form(form);
+    }
+    config::CharacterFormManager::GetCharacterFormManager()->ReloadConfig(settings);
+    return settings;
+  }
+  static Segments Supplement(const std::string& value, uint32_t attributes = 0) {
+    Segments segments;
+    auto* segment = segments.add_segment();
+    segment->set_key("あい");
+    auto* candidate = segment->add_candidate();
+    candidate->key = candidate->content_key = "あい";
+    candidate->value = candidate->content_value = value;
+    candidate->consumed_key_size = 2;
+    candidate->attributes = attributes | Attribute::NO_HISTORY_LEARNING;
+    candidate->cost = 42;
+    candidate->wcost = 13;
+    candidate->structure_cost = 9;
+    candidate->lid = candidate->rid = 10;
+    const auto boundary = EncodeLengths(6, value.size(), 6, value.size());
+    CHECK(boundary.has_value());
+    candidate->inner_segment_boundary = {*boundary};
+    return segments;
+  }
+};
