+#include "base/strings/unicode.h"
+
+namespace mozc {
+namespace {
+bool ValidField(const std::string& field) {
+  if (field.size() > (1u << 20) || field.find('\0') != std::string::npos)
+    return false;
+  const Utf8AsUnicodeChar chars(field);
+  return std::all_of(chars.begin(), chars.end(), [](const UnicodeChar c) {
+    return c.ok() && c.char32() <= 0x10ffff &&
+           (c.char32() < 0xd800 || c.char32() > 0xdfff);
+  });
+}
+}
+AzooKeyAsyncConverter::AzooKeyAsyncConverter(
+    std::unique_ptr<const ImmutableConverterInterface> converter)
+    : AzooKeyAsyncConverter(std::move(converter), 0) {}
+AzooKeyAsyncConverter::AzooKeyAsyncConverter(
+    std::unique_ptr<const ImmutableConverterInterface> converter,
+    uint64_t last_issued_token)
+    : converter_(std::move(converter)), next_id_(last_issued_token) {
+  if (!converter_) throw std::invalid_argument("Missing AzooKey converter");
+  worker_ = std::thread([this] { Run(); });
+}
+AzooKeyAsyncConverter::~AzooKeyAsyncConverter() {
+  Retire();
+  // No operation/DLL lock is held while joining. converter_ dies after join.
+  worker_.join();
+}
+uint64_t AzooKeyAsyncConverter::Retire() {
+  uint64_t last;
+  {
+    const std::lock_guard<std::mutex> lock(mutex_);
+    stopping_ = true;
+    current_id_ = 0;
+    pending_.reset();
+    completed_.reset();
+    last = next_id_;
+  }
+  ready_.notify_one();
+  return last;
+}
+uint64_t AzooKeyAsyncConverter::Submit(AzooKeyAsyncRequest request) {
+  if (request.key.empty() || !ValidField(request.key) ||
+      Util::CharsLen(request.key) > 128 || !ValidField(request.left_context) ||
+      !ValidField(request.right_context)) return 0;
+  const std::lock_guard<std::mutex> lock(mutex_);
+  if (stopping_ || next_id_ == std::numeric_limits<uint64_t>::max()) return 0;
+  current_id_ = ++next_id_;
+  pending_ = Job{current_id_, std::move(request)};
+  completed_.reset();
+  ready_.notify_one();
+  return current_id_;
+}
+void AzooKeyAsyncConverter::Cancel() {
+  const std::lock_guard<std::mutex> lock(mutex_);
+  current_id_ = 0;
+  pending_.reset();
+  completed_.reset();
+}
+void AzooKeyAsyncConverter::Cancel(uint64_t id) {
+  const std::lock_guard<std::mutex> lock(mutex_);
+  if (!id || current_id_ != id) return;
+  current_id_ = 0;
+  pending_.reset();
+  completed_.reset();
+}
+bool AzooKeyAsyncConverter::IsCurrent(uint64_t id) {
+  const std::lock_guard<std::mutex> lock(mutex_);
+  return id != 0 && id == current_id_;
+}
+std::optional<AzooKeyAsyncResult> AzooKeyAsyncConverter::Take(uint64_t id) {
+  const std::lock_guard<std::mutex> lock(mutex_);
+  if (!id || id != current_id_ || !completed_) return std::nullopt;
+  auto result = std::move(completed_);
+  completed_.reset();
+  current_id_ = 0;
+  return result;
+}
+void AzooKeyAsyncConverter::Run() {
+  std::unique_lock<std::mutex> lock(mutex_);
+  for (;;) {
+    ready_.wait(lock, [this] { return stopping_ || pending_.has_value(); });
+    if (stopping_) return;
+    Job job = std::move(*pending_);
+    pending_.reset();
+    lock.unlock();
+    AzooKeyAsyncResult result{job.id, nullptr};
+    try {
+      auto segments = std::make_unique<Segments>();
+      segments->add_segment()->set_key(job.request.key);
+      ConversionOptions options;
+      options.request_type = RequestType::CONVERSION;
+      // Background candidate generation must never record speculative learning.
+      options.enable_user_history_for_conversion = false;
+      options.incognito_mode = true;
+      if (converter_->ConvertWithContext(options, segments.get(),
+            job.request.left_context, job.request.right_context) &&
+          segments->conversion_segments_size() == 1 &&
+          segments->conversion_segment(0).candidates_size() != 0) {
+        result.segments = std::move(segments);
+      }
+    } catch (...) {
+      // Publish a failed request; keep the worker available for later input.
+    }
+    lock.lock();
+    if (!stopping_ && current_id_ == job.id) completed_ = std::move(result);
+  }
+}
+std::unique_ptr<AzooKeyAsyncConverter> CreateAzooKeyAsyncConverter(
+    const AzooKeyConfig& config) {
+  auto converter = CreateAzooKeyImmutableConverter(config);
+  if (!converter) return nullptr;
+  return std::make_unique<AzooKeyAsyncConverter>(std::move(converter));
+}
+}  // namespace mozc
