+      IsNumberSegment(segment)) {
+    return std::nullopt;
+  }
+  // Preserve the original D4 key for one conversion segment, resized or not.
+  if (segments.conversion_segments_size() == 1) {
+    return absl::StrCat("D4:", CityFingerprint(absl::StrCat(
+        left.size(), ":", left, right.size(), ":", right)));
