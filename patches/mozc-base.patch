+using Status=engine::EngineConverterInterface::AsyncConversionStatus;
+class ProbeConverter final : public engine::EngineConverter {
+ public:
+  explicit ProbeConverter(std::shared_ptr<const ConverterInterface> converter)
+      : engine::EngineConverter(std::move(converter)) {}
+  Status PollAsyncConversion(uint64_t token) override {
+    ++polls; observed_token=token; return status;
+  }
+  void CancelAsyncConversion() override { ++cancels; token=0; }
+  uint64_t GetAsyncConversionToken() const override { return token; }
+  void PopOutput(const composer::Composer&,commands::Output* output) override {
+    ++outputs; output->mutable_preedit()->set_cursor(0);
+  }
+  void set_selection_shortcut(config::Config::SelectionShortcut) override {
+    ++shortcut_changes;
+  }
+  void Commit(const composer::Composer&,const commands::Context&) override {}
+  void Cancel() override {}
+  void Reset() override {}
+  uint64_t token=42,observed_token=0;
+  Status status=Status::kPending;
+  int polls=0,cancels=0,outputs=0,shortcut_changes=0;
+};
