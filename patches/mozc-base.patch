+}
+TEST_F(FullSpanBounds, CapacityProtectsLiveAndUndoThenEvictsUnreferencedOnly) {
+  Segments oldest;
+  for (uint64_t i=1;i<=256;++i) {auto c=Commit(absl::StrCat("winner",i),i,Context(absl::StrCat(i)));Learn(c,Context(absl::StrCat(i)));if(i==1)oldest=c;}
