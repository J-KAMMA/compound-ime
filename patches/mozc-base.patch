+TEST_F(CandidateListTest, OneCandidateFollowsFocusWithoutChangingOtherOrder) {
+  for (const int focus : {0, 1, 2, 3, 4}) {
+    SCOPED_TRACE(focus);
+    CandidateList list;
+    for (int id = 0; id < 5; ++id) list.AddCandidate(id, std::to_string(id));
+    ASSERT_TRUE(list.MoveToId(focus));
+    const auto focused_index = list.focused_index();
+    EXPECT_EQ(list.MoveCandidateAfterFocused(3), focus < 2);
+    const std::vector<int> expected = focus == 0 ? std::vector<int>{0, 3, 1, 2, 4}
+        : focus == 1 ? std::vector<int>{0, 1, 3, 2, 4}
+        : std::vector<int>{0, 1, 2, 3, 4};
