+TEST_F(ConverterTest, DocumentContextIsRequestScoped) {
+  std::pair<std::string, std::string> observed;
+  int calls = 0;
+  class ContextConverter final : public ImmutableConverterInterface {
+   public:
+    ContextConverter(std::pair<std::string, std::string>& context, int& calls)
+        : context_(context), calls_(calls) {}
+
+    bool Convert(const ConversionOptions&, Segments*) const override {
+      ADD_FAILURE() << "Context entry point was bypassed";
+      return false;
+    }
+
+    bool ConvertWithContext(const ConversionOptions& options,
+                            Segments* segments, std::string_view left,
+                            std::string_view right) const override {
+      EXPECT_EQ(options.request_type, ConversionRequest::CONVERSION);
+      context_ = {std::string(left), std::string(right)};
+      ++calls_;
+      Segment* segment = segments->mutable_conversion_segment(0);
+      Candidate* candidate = segment->add_candidate();
+      candidate->key = segment->key();
+      candidate->content_key = candidate->key;
+      candidate->value = "雨";
+      candidate->content_value = candidate->value;
+      return true;
+    }
+
+   private:
+    std::pair<std::string, std::string>& context_;
+    int& calls_;
+  };
+  Converter converter(
+      engine::Modules::Create(std::make_unique<testing::MockDataManager>())
+          .value(),
+      [&](const engine::Modules&) {
+        return std::make_unique<ContextConverter>(observed, calls);
+      },
+      [](const engine::Modules&, const ConverterInterface&,
+         const ImmutableConverterInterface&) {
+        return std::make_unique<StubPredictor>();
+      },
+      [](const engine::Modules&) { return std::make_unique<StubRewriter>(); });
+
+  struct TestCase {
+    const char* preceding;
+    const char* following;
+    const char* expected_left;
+    const char* expected_right;
+  };
+  constexpr TestCase kCases[] = {
+      {"前の行\r\n 午後から１２時 ", " が降ります。\r\n次の行",
+       "午後から12時", "が降ります。"},
+      {"", " 室内です。 ", "", "室内です。"},
+      {" 明日は ", "", "明日は", ""},
+      {"", "", "", ""},
+  };
+  Segments segments;
+  for (const TestCase& test : kCases) {
+    SCOPED_TRACE(calls);
+    commands::Context context;
+    context.set_preceding_text(test.preceding);
+    context.set_following_text(test.following);
+    const ConversionRequest request =
+        ConversionRequestBuilder()
+            .SetContext(context)
+            .SetRequestType(ConversionRequest::CONVERSION)
+            .SetKey("あめ")
+            .Build();
+    ASSERT_TRUE(converter.StartConversion(request, &segments));
+    EXPECT_EQ(observed.first, test.expected_left);
+    EXPECT_EQ(observed.second, test.expected_right);
+    ASSERT_EQ(segments.conversion_segments_size(), 1);
+    EXPECT_EQ(segments.conversion_segment(0).candidate(0).value, "雨");
+  }
+  EXPECT_EQ(calls, std::size(kCases));
+}
