+  for (auto level : {config::Config::NO_HISTORY,config::Config::READ_ONLY}) {
+    config_.set_history_learning_level(level);auto c=Commit("manual",5,context_);Learn(c,context_);EXPECT_EQ(Peer::Rows(*r_),0);
+  }
+  config_.set_history_learning_level(config::Config::DEFAULT_HISTORY);
+  auto zero=Commit("zero-owner",0,context_);Learn(zero,context_);EXPECT_EQ(Peer::Rows(*r_),0);
+  auto c=Commit("manual",6,context_);Learn(c,context_);
+  auto query=Input();r_->Rewrite(Request(context_,true),&query);EXPECT_NE(query.conversion_segment(0).candidate(0).value,"manual");
+  query=Input();r_->Rewrite(Request(password),&query);EXPECT_NE(query.conversion_segment(0).candidate(0).value,"manual");
+  for (bool internal : {false,true}) {query=Input();r_->Rewrite(Request(context_,false,!internal,internal),&query);EXPECT_NE(query.conversion_segment(0).candidate(0).value,"manual");}
+  config_.set_history_learning_level(config::Config::NO_HISTORY);EXPECT_NE(Replay(context_),"manual");
+  config_.set_history_learning_level(config::Config::READ_ONLY);EXPECT_EQ(Replay(context_),"manual");
+}
+TEST_F(FullSpanBounds, LatestOwnerUndoDeleteAndClear) {
+  auto a=Commit("first",21,context_);Learn(a,context_);
+  auto b=Commit("second",22,context_);Learn(b,context_);EXPECT_EQ(Replay(context_),"second");
+  r_->Revert(b);EXPECT_EQ(Replay(context_),"first");
+  auto c=Commit("first",23,context_);Learn(c,context_);auto d=Commit("first",24,context_);Learn(d,context_);
+  r_->Revert(c);EXPECT_EQ((*Peer::Record(*r_,Request(context_),"はしをつかいます"))[1],24);
+  ASSERT_TRUE(r_->ClearHistoryEntry(d,0,0));r_->Revert(d);EXPECT_NE(Replay(context_),"first");
