+TEST_F(AsyncSessionBridgeTest, DictionaryPendingAppendSelectAndCommitFullSpanOnce) {
+  commands::Command initial;
+  ASSERT_TRUE(Start(&initial));
+  ASSERT_TRUE(initial.output().has_callback());
+  const auto callback = initial.output().callback().session_command();
+  EXPECT_EQ(callback.type(), commands::SessionCommand::REQUEST_ASYNC_CONVERSION);
+  ASSERT_FALSE(callback.text().empty());
+  ASSERT_TRUE(initial.output().has_preedit());
+  EXPECT_EQ(PreeditText(initial.output()), "箸ご飯");
+  EXPECT_TRUE(gate_->speculative);
+  EXPECT_EQ(gate_->left, "synthetic-left");
+  EXPECT_EQ(gate_->right, "synthetic-right");
+  const auto original = initial.output().all_candidate_words();
+  ASSERT_EQ(original.candidates_size(), 2);
+  auto pending = Poll(callback);
+  EXPECT_TRUE(pending.output().consumed());
+  EXPECT_EQ(pending.output().preedit().SerializeAsString(), initial.output().preedit().SerializeAsString());
+  EXPECT_EQ(pending.output().all_candidate_words().SerializeAsString(), original.SerializeAsString());
+  EXPECT_EQ(pending.output().callback().session_command().SerializeAsString(), callback.SerializeAsString());
+  EXPECT_FALSE(pending.output().has_result());
+  gate_->Release();
+  commands::Command applied;
+  ASSERT_TRUE(Await(callback, &applied));
+  EXPECT_EQ(applied.output().preedit().SerializeAsString(), initial.output().preedit().SerializeAsString());
+  EXPECT_FALSE(applied.output().has_result());
+  const auto& words = applied.output().all_candidate_words();
+  ASSERT_EQ(words.candidates_size(), 3);
+  EXPECT_EQ(words.focused_index(), original.focused_index());
+  EXPECT_EQ(words.candidates(0).id(), 0);
+  EXPECT_EQ(words.candidates(1).id(), 2);
+  EXPECT_EQ(words.candidates(2).id(), 1);
+  for (const auto& before : original.candidates()) {
+    const auto after = std::find_if(
+        words.candidates().begin(), words.candidates().end(),
+        [&](const auto& word) { return word.id() == before.id(); });
+    ASSERT_NE(after, words.candidates().end());
+    auto actual = *after;
+    auto expected = before;
+    actual.clear_index();
+    expected.clear_index();
+    EXPECT_EQ(actual.SerializeAsString(), expected.SerializeAsString());
+  }
+  EXPECT_EQ(words.candidates(1).key(), "はしごはん");
+  EXPECT_EQ(words.candidates(1).value(), "橋と御飯");
+  EXPECT_EQ(words.candidates(1).num_segments_in_candidate(), 2);
+  commands::Command select;
+  select.mutable_input()->set_type(commands::Input::SEND_KEY);
+  select.mutable_input()->mutable_key()->set_special_key(commands::KeyEvent::SPACE);
+  ASSERT_TRUE(session_->SendKey(&select));
+  ASSERT_TRUE(select.output().has_all_candidate_words());
+  const auto& selected_words = select.output().all_candidate_words();
+  ASSERT_GE(selected_words.focused_index(), 0);
+  ASSERT_LT(selected_words.focused_index(), selected_words.candidates_size());
+  EXPECT_EQ(selected_words.candidates(selected_words.focused_index()).id(), 2);
+  EXPECT_EQ(PreeditText(select.output()), "橋と御飯");
+  ASSERT_EQ(select.output().preedit().segment_size(), 1);
+  EXPECT_EQ(select.output().preedit().segment(0).key(), "はしごはん");
+  EXPECT_FALSE(select.output().has_result());
+  EXPECT_CALL(*primary_, CommitSegmentValue(::testing::_, 0, 2)).Times(1);
+  EXPECT_CALL(*primary_, FinishConversion(::testing::_, ::testing::_)).Times(1);
+  auto submit = Command(commands::SessionCommand::SUBMIT);
+  ASSERT_TRUE(session_->SendCommand(&submit));
+  ASSERT_TRUE(submit.output().has_result());
+  EXPECT_EQ(submit.output().result().value(), "橋と御飯");
+  EXPECT_EQ(submit.output().result().key(), "はしごはん");
+  EXPECT_FALSE(submit.output().has_preedit());
+  EXPECT_FALSE(submit.output().has_callback());
+  EXPECT_EQ(session_->context().state(), ImeContext::PRECOMPOSITION);
+  for (int i = 0; i < 2; ++i) {
+    commands::Command repeated;
+    repeated.mutable_input()->set_type(commands::Input::SEND_KEY);
+    repeated.mutable_input()->mutable_key()->set_special_key(commands::KeyEvent::ENTER);
+    ASSERT_TRUE(session_->SendKey(&repeated));
+    EXPECT_FALSE(repeated.output().has_result());
+    EXPECT_FALSE(repeated.output().has_preedit());
+    EXPECT_FALSE(repeated.output().has_callback());
+    EXPECT_EQ(session_->context().state(), ImeContext::PRECOMPOSITION);
+  }
+  StaleOnly(callback);
+}
