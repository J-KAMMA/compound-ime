+TEST_F(ScopedHistoryChoiceTest, MalformedStoreLengthsAreRejectedWithoutMutation) {
+  const auto valid = ReadScopedFileBytes();
+  ASSERT_TRUE(valid.has_value());
+  ASSERT_EQ(valid->size(), 560012);  // Declared D4 file: 12 + 20000 * (12 + 16).
+  const std::string header = valid->substr(0, 12);
+  const std::array<size_t, 7> sizes = {0, 7, 8, 11, 12, 560011, 560013};
+  for (const size_t size : sizes) {
+    SCOPED_TRACE(size);
+    rewriter_.reset();
+    std::string malformed(size, '\0');
+    // Preserve the public-created valid header up to the truncation point so
+    // near-valid lengths cannot pass merely because a random header is rejected.
+    std::copy_n(header.begin(), std::min(size, header.size()), malformed.begin());
+    std::ofstream output(ScopedStorePath(), std::ios::binary | std::ios::trunc);
+    ASSERT_TRUE(output.is_open());
+    output.write(malformed.data(), static_cast<std::streamsize>(malformed.size()));
+    output.close();
+    ASSERT_FALSE(output.fail());
+    const auto written = ReadScopedFileBytes();
+    ASSERT_TRUE(written.has_value());
+    ASSERT_EQ(*written, malformed);
+    const uint64_t original_file_fingerprint = CityFingerprint(malformed);
+    rewriter_ = CreateRewriter();
+    EXPECT_FALSE(rewriter_->Reload());
+    const Scope scope("scope-alpha");
+    Select(scope, "橋", "箸", 1501, Request());
+    ExpectOrder(scope, "橋", "箸", "橋", "箸", Request());
+    rewriter_.reset();
+    const auto preserved = ReadScopedFileBytes();
+    ASSERT_TRUE(preserved.has_value());
+    EXPECT_EQ(preserved->size(), size);
+    EXPECT_EQ(CityFingerprint(*preserved), original_file_fingerprint);
+    EXPECT_EQ(*preserved, malformed);
+    // Never call the generic LruStorage::Open on a malformed fixture: D4's
+    // public Reload must perform its own preflight before mapping this file.
+  }
+}
