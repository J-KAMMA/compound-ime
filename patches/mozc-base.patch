+// Private integration contract tests. No DLL/model/Session/IME is executed.
+namespace {
+using AsyncStatus = EngineConverterInterface::AsyncConversionStatus;
+using AsyncClock = std::chrono::steady_clock;
+constexpr auto kAsyncWait = std::chrono::seconds(2);
+struct EngineAsyncGate {
+  std::mutex mutex;
+  std::condition_variable changed;
+  size_t started = 0, permitted = 0;
+  size_t candidates_per_call = 1;
+  bool released = false, timed_out = false;
+  std::vector<std::function<void(converter::Candidate&)>> mutations;
+  std::vector<std::array<std::string, 3>> calls;
+};
+
+// The production worker owns and schedules this provider. The gate only controls
+// completion, so absence of a result is not inferred from an arbitrary sleep.
+class EnginePausedImmutable final : public ImmutableConverterInterface {
+ public:
+  explicit EnginePausedImmutable(std::shared_ptr<EngineAsyncGate> gate)
+      : gate_(std::move(gate)) {}
+  bool Convert(const ConversionOptions&, Segments*) const override {
+    ADD_FAILURE() << "Expected context-aware worker call";
+    return false;
+  }
+  bool ConvertWithContext(const ConversionOptions& options, Segments* segments,
+                          std::string_view left, std::string_view right) const override {
+    EXPECT_EQ(options.request_type, RequestType::CONVERSION);
+    EXPECT_FALSE(options.enable_user_history_for_conversion);
+    EXPECT_TRUE(options.incognito_mode);
+    EXPECT_FALSE(options.create_partial_candidates);
+    EXPECT_FALSE(options.used_in_predictor_realtime_conversion);
+    if (!segments || segments->conversion_segments_size() != 1) {
+      ADD_FAILURE() << "Expected one owned full-reading segment";
+      return false;
+    }
+    size_t ordinal, batch;
+    std::function<void(converter::Candidate&)> mutate;
+    {
+      std::unique_lock<std::mutex> lock(gate_->mutex);
+      ordinal = ++gate_->started;
+      batch = gate_->candidates_per_call;
+      gate_->changed.notify_all();
+      if (!gate_->changed.wait_until(lock, AsyncClock::now() + std::chrono::seconds(5),
+            [&] { return gate_->released || gate_->permitted >= ordinal; })) {
+        gate_->timed_out = true;
+        return false;
+      }
+      gate_->calls.push_back({std::string(segments->conversion_segment(0).key()),
+                              std::string(left), std::string(right)});
+      if (ordinal <= gate_->mutations.size()) mutate = gate_->mutations[ordinal - 1];
+    }
+    for (size_t i = 0; i < batch; ++i) {
+      auto* candidate = segments->mutable_conversion_segment(0)->add_candidate();
+      candidate->key = candidate->content_key = std::string(segments->conversion_segment(0).key());
+      candidate->value = candidate->content_value = "補完" + std::to_string(ordinal) +
+          (batch == 1 ? "" : "-" + std::to_string(i));
+      candidate->consumed_key_size = Util::CharsLen(candidate->key);
+      const auto boundary = converter::EncodeLengths(candidate->key.size(), candidate->value.size(),
+                                                     candidate->key.size(), candidate->value.size());
+      if (!boundary) {
+        ADD_FAILURE() << "Fixture's inner boundary must be representable";
+        return false;
+      }
+      candidate->inner_segment_boundary = {*boundary};
+      if (mutate) mutate(*candidate);
+    }
+    return true;
+  }
+ private:
+  const std::shared_ptr<EngineAsyncGate> gate_;
+};
+}  // namespace
+
+class AsyncEngineCandidateTest : public EngineConverterTest {
+ protected:
+  void SetUp() override {
+    EngineConverterTest::SetUp();
+    gate_ = std::make_shared<EngineAsyncGate>();
+    worker_ = std::make_shared<AzooKeyAsyncConverter>(std::make_unique<EnginePausedImmutable>(gate_));
+  }
+  void TearDown() override {
+    ReleaseAll();
+    worker_.reset();
+    {
+      std::lock_guard<std::mutex> lock(gate_->mutex);
+      EXPECT_FALSE(gate_->timed_out) << "Provider gate timeout invalidates this fixture";
+    }
+    EngineConverterTest::TearDown();
+  }
+  static Segments BaseSegments() {
+    Segments segments;
+    AddSegmentWithSingleCandidate(&segments, "あ", "先頭");
+    AddSegmentWithSingleCandidate(&segments, "い", "末尾");
+    return segments;
+  }
+  static commands::Context Window() {
+    commands::Context context;
+    context.set_preceding_text("前😀");
+    context.set_following_text("後。");
+    context.add_experimental_features("myime_async_conversion_v1");
+    return context;
+  }
+  bool Start(EngineConverter& engine, MockConverter& mock,
+             const commands::Context& context = Window(),
+             const ConversionPreferences& preferences = ConversionPreferences{true, true},
+             Segments segments = BaseSegments()) {
+    composer_->Reset();
+    composer_->InsertCharacterPreedit("あい");
+    EXPECT_CALL(mock, StartConversion(_, _))
+        .WillOnce([segments = std::move(segments)](const ConversionRequest&, Segments* output) {
+          *output = segments;
+          return true;
+        });
+    ON_CALL(mock, FocusSegmentValue(_, _, _)).WillByDefault(Return(true));
+    return engine.Convert(*composer_, context, preferences);
+  }
+  void ReleaseAll() {
+    std::lock_guard<std::mutex> lock(gate_->mutex);
+    gate_->released = true;
+    gate_->changed.notify_all();
+  }
+  void Permit(size_t count) {
+    std::lock_guard<std::mutex> lock(gate_->mutex);
+    gate_->permitted = count;
+    gate_->changed.notify_all();
+  }
+  bool WaitStarted(size_t count) {
+    std::unique_lock<std::mutex> lock(gate_->mutex);
+    return gate_->changed.wait_until(lock, AsyncClock::now() + kAsyncWait,
+                                    [&] { return gate_->started >= count; });
+  }
+  // Only the caller thread touches EngineConverter during this liveness check.
+  // On timeout, unblock the provider and join the caller before test teardown.
+  bool ReturnsWhilePaused(const std::function<void()>& action) {
+    std::mutex mutex;
+    std::condition_variable changed;
+    bool done = false;
+    std::thread caller([&] {
+      try { action(); } catch (...) { ADD_FAILURE() << "Unexpected API exception"; }
+      std::lock_guard<std::mutex> lock(mutex);
+      done = true;
+      changed.notify_all();
+    });
+    bool returned;
+    {
+      std::unique_lock<std::mutex> lock(mutex);
+      returned = changed.wait_until(lock, AsyncClock::now() + kAsyncWait, [&] { return done; });
+    }
+    if (!returned) ReleaseAll();
+    caller.join();
+    return returned;
+  }
+  // Publication occurs after provider return. A bounded waiter repeatedly polls
+  // the public API; the test thread waits on an explicit completion CV. Yield
+  // avoids sleeping or assuming the worker has published after its provider exits.
+  std::optional<AsyncStatus> WaitPoll(EngineConverter& engine, uint64_t token) {
+    std::mutex mutex;
+    std::condition_variable changed;
+    std::atomic<bool> stop{false};
+    bool done = false;
+    std::optional<AsyncStatus> result;
+    std::thread waiter([&] {
+      try {
+      while (!stop.load(std::memory_order_relaxed)) {
+        const auto status = engine.PollAsyncConversion(token);
+        if (status != AsyncStatus::kPending) {
+          std::lock_guard<std::mutex> lock(mutex);
+          result = status;
+          done = true;
+          changed.notify_all();
+          return;
+        }
+        std::this_thread::yield();
+      }
+      } catch (...) {
+        ADD_FAILURE() << "Unexpected Poll exception";
+        std::lock_guard<std::mutex> lock(mutex);
+        done = true;
+        changed.notify_all();
+      }
+    });
+    {
+      std::unique_lock<std::mutex> lock(mutex);
+      changed.wait_until(lock, AsyncClock::now() + kAsyncWait, [&] { return done; });
+    }
+    stop.store(true, std::memory_order_relaxed);
+    waiter.join();
+    return result;
+  }
+  std::string Preedit(EngineConverter& engine) {
+    commands::Output output;
+    engine.FillOutput(*composer_, &output);
+    return output.preedit().SerializeAsString();
+  }
+  static std::vector<int> Ids(const EngineConverter& engine) {
+    std::vector<int> ids;
+    const auto& list = GetCandidateList(engine);
+    for (size_t i = 0; i < list.size(); ++i) ids.push_back(list.candidate(i).id());
+    return ids;
+  }
+  std::shared_ptr<EngineAsyncGate> gate_;
+  std::shared_ptr<AzooKeyAsyncConverter> worker_;
+};
