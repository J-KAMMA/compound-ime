+  context.set_preceding_text(multibyte);
+  context.set_following_text("道");
+  ExpectCapturedScope(context, "はし", CapturedScope::kScoped);
+  context.set_preceding_text(multibyte + "b");  // 55 scalars, 161 bytes.
+  ExpectCapturedScope(context, "はし", CapturedScope::kBlocked);
+}
