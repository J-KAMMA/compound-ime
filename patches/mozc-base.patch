+  void RowsAfterClose(const char* name, uint32_t width, Rows* rows,
+                      uint32_t capacity = 20000, uint32_t seed = 0xf28defe3) {
+    ASSERT_FALSE(primary_); ASSERT_FALSE(session_); ASSERT_FALSE(worker_);
+    const auto profile = std::filesystem::u8path(SystemUtil::GetUserProfileDirectory()).lexically_normal();
+    const std::string path = ConfigFileStream::GetFileName(std::string("user://") + name);
+    ASSERT_EQ(std::filesystem::u8path(path).parent_path().lexically_normal(), profile);
+    InputFileStream input(path, std::ios::binary | std::ios::ate);
+    ASSERT_TRUE(input);
+    ASSERT_EQ(input.tellg(), std::streampos(12 + (width + 12) * capacity));
+    std::array<uint32_t, 3> header;
+    static_assert(sizeof(header) == 12);
+    input.seekg(0);
