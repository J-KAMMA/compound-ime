+// Copyright 2026. All rights reserved.
+#ifndef MOZC_WIN32_TIP_TIP_IDLE_RESUGGEST_REQUEST_H_
+#define MOZC_WIN32_TIP_TIP_IDLE_RESUGGEST_REQUEST_H_
+#include <cstdint>
+#include <limits>
+#include <string>
+#include <string_view>
+#include <utility>
+namespace mozc::win32::tsf {
+// Bind an idle request to one input context and its unchanged output.
+// Context removal and focus/key changes Reset before an address is reused.
+class TipIdleResuggestRequest {
+ public:
+  void Arm(const void* context, int32_t focus_revision, std::string output) {
+    Reset();
+    if (revision_ == std::numeric_limits<uint64_t>::max()) return;
+    context_ = context;
+    focus_revision_ = focus_revision;
+    output_ = std::move(output);
+  }
+  void Reset() {
+    context_ = nullptr;
+    output_.clear();
+    if (revision_ < std::numeric_limits<uint64_t>::max()) ++revision_;
+  }
+  uint64_t revision() const { return revision_; }
+  bool IsCurrentRevision(uint64_t revision) const {
+    return revision_ == revision && revision_ < std::numeric_limits<uint64_t>::max();
+  }
+  bool IsCurrent(const void* context, int32_t focus_revision,
+                 std::string_view output) const {
+    return context_ && context_ == context && focus_revision_ == focus_revision &&
+           output_ == output;
+  }
+ private:
+  friend struct TipIdleResuggestRequestTestPeer;
+  uint64_t revision_ = 0;
+  const void* context_ = nullptr;
+  int32_t focus_revision_ = 0;
+  std::string output_;
+};
+}  // namespace mozc::win32::tsf
+#endif  // MOZC_WIN32_TIP_TIP_IDLE_RESUGGEST_REQUEST_H_
