+
+void UserSegmentHistoryRewriter::ReloadFullSpan() {
+  full_span_storage_.reset();
+  if (!scoped_storage_) return;
+  const std::string filename = ConfigFileStream::GetFileName(kFullSpanFileName);
+  const auto exists = FileUtil::FileExists(filename);
+  if (!exists.ok() && !absl::IsNotFound(exists)) return;
+  if (exists.ok()) {
+    InputFileStream input(filename, std::ios::binary | std::ios::ate);
+    if (!input || input.tellg() < std::streampos(0) ||
+        input.tellg() > std::streampos(kFullSpanBytes + 1024)) return;
+    std::string decoded;
+    user_history_predictor::UserHistory proto;
+    if (!storage::EncryptedStringStorage(filename).Load(&decoded) ||
+        decoded.size() > kFullSpanBytes || !proto.ParseFromString(decoded) ||
+        proto.entries_size() > kFullSpanEntries ||
+        !std::all_of(proto.entries().begin(), proto.entries().end(), ValidFullSpanEntry)) return;
+  }
+  auto storage = std::make_unique<prediction::UserHistoryStorage>(filename);
+  storage->Wait();
+  if (!ValidFullSpanStore(*storage)) return;
+  full_span_storage_ = std::move(storage);
+}
+
+bool UserSegmentHistoryRewriter::SyncFullSpan() const {
+  return !full_span_storage_ ||
+      (ValidFullSpanStore(*full_span_storage_) && full_span_storage_->Save());
+}
+
+
+bool UserSegmentHistoryRewriter::IsFullSpanPayloadProtected(
+    const prediction::UserHistoryStorage::Entry& entry) const {
+  const auto reading = PayloadReading(entry.key());
+  if (!reading) return true;
+  const absl::string_view encoded = entry.key();
+  const size_t colon = encoded.find(':');
+  const size_t size = *ParseUnsigned(encoded.substr(0, colon));
+  const auto scope = encoded.substr(colon + 1, size);
+  const std::string key = ScopedHistoryKey(scope, *reading);
+  auto matches = [&](const ScopedRecord& record) {
+    return PayloadKey(scope, *reading, record) == entry.key();
+  };
+  if (const auto current = ReadScopedRecord(key); current && matches(*current)) return true;
+  for (const auto& cache : scoped_revert_cache_) {
+    for (const auto& undo : cache.value) {
+      if (undo.key == key &&
+          (matches(undo.written) || (undo.previous && matches(*undo.previous)))) return true;
+    }
+  }
+  return false;
+}
+
+bool UserSegmentHistoryRewriter::RememberFullSpan(
+    const Segment& segment, uint64_t owner,
+    std::vector<ScopedRevertEntry>& revert_entries) {
+  const auto& scope = segment.context_history_scope();
+  const auto& candidate = segment.candidate(0);
+  if (!scope || scope->empty() || !full_span_storage_ || owner == 0 ||
+      (candidate.attributes & (converter::Attribute::PARTIALLY_KEY_CONSUMED |
+                               converter::Attribute::COMMAND_CANDIDATE))) return false;
+  const std::string full_scope = FullSpanScope(*scope);
+  const std::string key = ScopedHistoryKey(full_scope, segment.key());
+  if (key.empty() || candidate.key != segment.key()) return false;
+  const auto previous = ReadScopedRecord(key);
+  // Ordinary single-segment D4 learning is unchanged. A recalled full reading
+  // can update its existing full-span winner even if dictionary layout is single.
+  if (candidate.effective_converted_segment_count() <= 1 && !previous) return false;
+  const ScopedRecord written = {CityFingerprint(candidate.value), owner};
+  FullSpanEntry entry;
+  entry.set_key(PayloadKey(full_scope, segment.key(), written));
+  entry.set_value(candidate.value);
+  if (candidate.description.size() <= 256 && IsValidContextText(candidate.description))
+    entry.set_description(candidate.description);
+  for (const uint32_t boundary : candidate.inner_segment_boundary)
+    entry.add_inner_segment_boundary(boundary);
+  if (!ValidFullSpanEntry(entry)) return false;
+  // Remove only unreferenced oldest payloads when the declared cap is reached.
+  // Current authorities and both ends of retained Undo entries are protected.
+  std::vector<std::pair<uint64_t, size_t>> evictable;
+  size_t count = 0, bytes = entry.ByteSizeLong() + 8;
+  full_span_storage_->ForEach([&](uint64_t fp, const FullSpanEntry& stored) {
+    ++count;
+    const size_t size = stored.ByteSizeLong() + 8;
+    bytes += size;
+    if (!IsFullSpanPayloadProtected(stored)) evictable.emplace_back(fp, size);
+    return true;
+  });
+  std::vector<uint64_t> erased;
+  while (!evictable.empty() && (count >= kFullSpanEntries || bytes > kFullSpanBytes)) {
+    const auto [fp, size] = evictable.back(); evictable.pop_back();
+    erased.push_back(fp); --count; bytes -= size;
+  }
+  // Plan all removals before mutation. A full store of current/Undo-protected
+  // winners rejects this learning operation without changing any existing row.
+  if (count >= kFullSpanEntries || bytes > kFullSpanBytes) return false;
+  full_span_storage_->Erase(erased);
+  full_span_storage_->Insert(std::move(entry));
+  // Payload publication precedes authority publication. A failed encrypted
+  // save cannot authorize a missing/old value on the next process restart.
+  if (!SyncFullSpan() || !WriteScopedRecord(key, written)) return false;
+  revert_entries.push_back({key, previous, written});
+  return true;
+}
