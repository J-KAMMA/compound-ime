+TEST_F(AsyncVariantsConverterTest, MultiClauseWidthKeepsMergedContentPrefix) {
+  auto converter = CreateStubbedConverter();
+  for (bool trailing_function : {false, true}) {
+    for (uint32_t attributes : {
+             uint32_t{0}, uint32_t{Attribute::SPELLING_CORRECTION},
+             uint32_t{Attribute::NO_VARIANTS_EXPANSION},
+             uint32_t{Attribute::NO_EXTRA_DESCRIPTION}}) {
+      Segments supplement = Supplement("私はかな(", attributes);
+      auto* segment = supplement.mutable_conversion_segment(0);
+      segment->set_key("わたしはかな(");
+      auto* candidate = segment->mutable_candidate(0);
+      candidate->key = candidate->content_key = "わたしはかな(";
+      candidate->content_value = trailing_function ? "私はかな" : "私はかな(";
+      if (trailing_function) candidate->content_key = "わたしはかな";
+      candidate->consumed_key_size = Util::CharsLen(candidate->key);
+      InnerSegmentBoundaryBuilder builder;
+      builder.Add(std::string("わたしは").size(), std::string("私は").size(),
+                  std::string("わたし").size(), std::string("私").size());
+      builder.Add(std::string("かな(").size(), std::string("かな(").size(),
+                  std::string(trailing_function ? "かな" : "かな(").size(),
+                  std::string(trailing_function ? "かな" : "かな(").size());
+      candidate->inner_segment_boundary = builder.Build(candidate->key, candidate->value);
+      const auto original = *candidate;
+      const auto request = ConversionRequestBuilder()
+          .SetRequestType(ConversionRequest::CONVERSION).SetKey(candidate->key).Build();
+      converter->RewriteAsyncCandidates(request, &supplement);
+      const bool opt_out = attributes &
+          (Attribute::NO_VARIANTS_EXPANSION | Attribute::NO_EXTRA_DESCRIPTION);
+      ASSERT_EQ(segment->candidates_size(), opt_out ? 1 : 2);
+      for (int i = 0; i < segment->candidates_size(); ++i) {
+        const auto& result = segment->candidate(i);
+        EXPECT_EQ(result.value, !opt_out && i == 0 ? "私はかな（" : "私はかな(");
+        EXPECT_EQ(result.content_value, trailing_function ? "私はかな" : result.value);
+        EXPECT_EQ(result.key, original.key);
+        EXPECT_EQ(result.content_key, original.content_key);
+        EXPECT_EQ(result.consumed_key_size, original.consumed_key_size);
+        EXPECT_EQ(result.cost, original.cost);
+        EXPECT_EQ(result.wcost, original.wcost);
+        EXPECT_EQ(result.structure_cost, original.structure_cost);
+        EXPECT_EQ(result.lid, original.lid);
+        EXPECT_EQ(result.rid, original.rid);
+        EXPECT_TRUE(result.attributes & Attribute::NO_HISTORY_LEARNING);
+        EXPECT_EQ(result.attributes & attributes, attributes);
+        ASSERT_EQ(result.inner_segment_boundary.size(), 2);
+        EXPECT_EQ(result.inner_segment_boundary[0], original.inner_segment_boundary[0]);
+        const auto last = DecodeLengths(result.inner_segment_boundary[1]);
+        EXPECT_EQ(last.value_len, std::string(!opt_out && i == 0 ? "かな（" : "かな(").size());
+        EXPECT_EQ(last.content_value_len, trailing_function ? std::string("かな").size() : last.value_len);
+      }
+    }
+  }
+}
