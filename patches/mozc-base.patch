+  list.AddCandidate(2, "c");
+  list.AddCandidate(3, "d");
+  list.AddCandidateWithAttributes(4, "c", FULL_WIDTH);
+  ASSERT_TRUE(list.MoveCandidateAfterFocused(4));
+  EXPECT_FALSE(list.MoveCandidateAfterFocused(4));
+  const std::vector<int> expected = {0, 2, 1, 3};
+  ASSERT_EQ(list.size(), expected.size());
+  for (size_t i = 0; i < expected.size(); ++i)
+    EXPECT_EQ(list.candidate(i).id(), expected[i]);
+  EXPECT_EQ(list.focused_id(), 0);
+  EXPECT_EQ(list.next_available_id(), 5);
