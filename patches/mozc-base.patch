+// Private Rewriter-only policy probe. Actual Segment + D4 rewriter, no Session,
+// converter candidate generation, neural model or manual/UI cost claim.
+#include "rewriter/user_segment_history_rewriter.h"
+#include <array>
+#include <cstdint>
+#include <memory>
+#include <string>
+#include "absl/strings/string_view.h"
+#include "config/config_handler.h"
+#include "converter/attribute.h"
+#include "converter/segments.h"
+#include "data_manager/testing/mock_data_manager.h"
+#include "dictionary/pos_group.h"
+#include "dictionary/pos_matcher.h"
+#include "protocol/commands.pb.h"
+#include "protocol/config.pb.h"
+#include "request/conversion_request.h"
+#include "testing/gunit.h"
+#include "testing/mozctest.h"
+
+namespace mozc {
+namespace {
+struct Case {
+  const char* name;
+  bool single;
+  bool resized;
+  size_t target;
+  bool duplicate_reading;
+  bool changed_cross_neighbor;
+  bool missing_finish_context;
+  const char* legacy_cross_prediction;
+};
+constexpr std::array<Case, 9> kCases = {{
+    {"SingleNormalControl", true, false, 0, false, false, false, "箸"},
+    {"TwoTargetFirst", false, false, 0, false, false, false, "橋"},
+    {"TwoTargetLast", false, false, 1, false, false, false, "橋"},
+    {"TwoChangedCrossNeighbor", false, false, 0, false, true, false, "橋"},
+    {"TwoDuplicateReading", false, false, 0, true, false, false, "橋"},
+    {"ResizedSingle", true, true, 0, false, false, false, "橋"},
+    {"ResizedTwo", false, true, 0, false, false, false, "橋"},
+    {"ResizedTwoChangedCrossNeighbor", false, true, 0, false, true, false, "箸"},
+    {"TwoMissingFinishContext", false, false, 0, false, false, true, "橋"},
+}};
+
+class MultiSegmentPolicyTest : public testing::TestWithTempUserProfile,
+                               public ::testing::WithParamInterface<Case> {
+ protected:
+  MultiSegmentPolicyTest() : matcher_(data_.GetPosMatcherData()),
+                            group_(data_.GetPosGroupData()) {}
+  void SetUp() override {
+    config::ConfigHandler::GetDefaultConfig(&config_);
+    config_.set_history_learning_level(config::Config::DEFAULT_HISTORY);
+    config_.set_incognito_mode(false);
+    request_.set_mixed_conversion(false);
+    same_.set_preceding_text("朝ご飯を食べるために");
+    same_.set_following_text("を使います。");
+    different_.set_preceding_text("昼ご飯を食べるために");
+    different_.set_following_text("を使います。");
+    rewriter_ = std::make_unique<UserSegmentHistoryRewriter>(matcher_, group_);
+    rewriter_->Clear();  // Fresh TestWithTempUserProfile directory only.
+  }
+  ConversionRequest Request(const commands::Context& context) const {
+    ConversionRequest::Options options;
+    options.incognito_mode = false;
+    options.enable_user_history_for_conversion = true;
+    return ConversionRequestBuilder().SetConfig(config_).SetRequest(request_)
+        .SetContext(context).SetOptions(options)
+        .SetRequestType(ConversionRequest::CONVERSION).Build();
+  }
+  void Candidate(Segment* segment, absl::string_view value) const {
+    auto* c = segment->add_candidate();
+    c->key = segment->key(); c->content_key = c->key;
+    c->value = std::string(value); c->content_value = c->value;
+    c->lid = matcher_.GetGeneralNounId(); c->rid = c->lid;
+  }
+  Segments Input(bool changed_neighbor = false) const {
+    const Case& p = GetParam();
+    Segments segments;
+    for (size_t i = 0; i < (p.single ? 1 : 2); ++i) {
+      Segment* segment = segments.add_segment();
+      segment->set_segment_type(Segment::FREE);
+      if (i == p.target || p.duplicate_reading) {
+        segment->set_key("はし"); Candidate(segment, "箸"); Candidate(segment, "橋");
+      } else {
+        segment->set_key(changed_neighbor ? "おかし" : "ごはん");
+        Candidate(segment, changed_neighbor ? "お菓子" : "ご飯");
+      }
+    }
+    segments.set_resized(p.resized);
+    return segments;
+  }
+  static std::string Scope(const Segment& s) {
+    if (!s.context_history_scope_initialized()) return "UNINITIALIZED";
+    if (!s.context_history_scope()) return "LEGACY";
+    return s.context_history_scope()->empty() ? "BLOCKED" : "SCOPED";
+  }
+  std::string Top(const Segments& segments) const {
+    return segments.segment(GetParam().target).candidate(0).value;
+  }
+  bool CapturedCorrectly(const Segments& segments) const {
+    const std::string expected = "SCOPED";
+    for (const Segment& s : segments.conversion_segments())
+      if (Scope(s) != expected) return false;
+    return true;
+  }
+  testing::MockDataManager data_;
+  dictionary::PosMatcher matcher_;
+  dictionary::PosGroup group_;
+  config::Config config_;
+  commands::Request request_;
+  commands::Context same_, different_, empty_;
+  std::unique_ptr<UserSegmentHistoryRewriter> rewriter_;
+};
+
+TEST_P(MultiSegmentPolicyTest, SameAndDifferentContextPolicy) {
+  const Case& p = GetParam();
+  RecordProperty("fixture", p.name);
+  RecordProperty("API", "actual Rewriter; synthetic candidates; no Session/AI");
+  RecordProperty("legacy_cross_prediction_unmeasured", p.legacy_cross_prediction);
+  RecordProperty("fixture_ready", "false");
+  const auto same_request = Request(same_);
+  const auto different_request = Request(different_);
+  auto training = Input();
+  rewriter_->Rewrite(same_request, &training);
+  auto cold_cross = Input(p.changed_cross_neighbor);
+  rewriter_->Rewrite(different_request, &cold_cross);
+  RecordProperty("cold_same_actual", Top(training));
+  RecordProperty("cold_cross_actual", Top(cold_cross));
+  RecordProperty("cold_scope", Scope(training.segment(p.target)));
+  if (Top(training) != "箸" || Top(cold_cross) != "箸" ||
+      !CapturedCorrectly(training) || !CapturedCorrectly(cold_cross)) {
+    ADD_FAILURE() << "FIXTURE_INVALID: cold order/scope differs";
+    return;
+  }
+  auto* selected = training.mutable_segment(p.target);
+  selected->move_candidate(1, 0);
+  selected->mutable_candidate(0)->attributes |= converter::Attribute::RERANKED;
+  for (Segment& s : training.conversion_segments()) s.set_segment_type(Segment::FIXED_VALUE);
+  training.set_revert_id(1);  // Synthetic public Finish owner, not a Session claim.
+  RecordProperty("manual_selected", Top(training));
+  RecordProperty("finish_context", p.missing_finish_context ? "ABSENT" : "SAME");
+  rewriter_->Finish(p.missing_finish_context ? Request(empty_) : same_request, training);
+  auto same = Input(); rewriter_->Rewrite(same_request, &same);
+  auto cross = Input(p.changed_cross_neighbor); rewriter_->Rewrite(different_request, &cross);
+  RecordProperty("same_actual", Top(same)); RecordProperty("same_expected", "橋");
+  RecordProperty("different_actual", Top(cross)); RecordProperty("different_expected", "箸");
+  RecordProperty("same_scope", Scope(same.segment(p.target)));
+  RecordProperty("different_scope", Scope(cross.segment(p.target)));
+  RecordProperty("same_attributes", std::to_string(same.segment(p.target).candidate(0).attributes));
+  RecordProperty("different_attributes", std::to_string(cross.segment(p.target).candidate(0).attributes));
+  RecordProperty("fixture_ready", "true");
+  RecordProperty("policy_matches", Top(same) == "橋" && Top(cross) == "箸" ? "true" : "false");
+  EXPECT_TRUE(CapturedCorrectly(same)); EXPECT_TRUE(CapturedCorrectly(cross));
+  EXPECT_EQ(Top(same), "橋") << "Same normalized context must retain explicit selection";
+  EXPECT_EQ(Top(cross), "箸") << "POLICY_VIOLATION: different normalized context must preserve cold base";
+  if (p.duplicate_reading) {
+    RecordProperty("same_other_segment_actual", same.segment(1).candidate(0).value);
+    RecordProperty("different_other_segment_actual", cross.segment(1).candidate(0).value);
+    EXPECT_EQ(same.segment(1).candidate(0).value, "箸");
+    EXPECT_EQ(cross.segment(1).candidate(0).value, "箸");
+  }
+}
+INSTANTIATE_TEST_SUITE_P(Declared, MultiSegmentPolicyTest, ::testing::ValuesIn(kCases),
+                        [](const ::testing::TestParamInfo<Case>& info) { return info.param.name; });
+}  // namespace
+}  // namespace mozc
