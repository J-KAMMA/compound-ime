+constexpr char kReading[] = "はしをつかいます";
+constexpr char kRoman[] = "hashiwotsukaimasu";
+constexpr char kManual[] = "箸を使います";
+static_assert(sizeof(kReading) - 1 <= 255 && sizeof(kManual) - 1 <= 255);
+struct Gate {
+  std::mutex mutex;
+  std::condition_variable ready;
+  bool entered = false, released = false;
+  bool speculative = false;
+  uint16_t lid = 0, rid = 0;
+  void Release() {
+    std::lock_guard lock(mutex);
+    released = true;
+    ready.notify_all();
+  }
+  bool Wait() {
+    std::unique_lock lock(mutex);
+    return ready.wait_for(lock, std::chrono::seconds(5), [&] { return entered; });
+  }
+};
+class FullCandidate final : public ImmutableConverterInterface {
+ public:
+  explicit FullCandidate(std::shared_ptr<Gate> gate) : gate_(std::move(gate)) {}
+  bool Convert(const ConversionOptions& options, Segments* segments) const override {
+    return ConvertWithContext(options, segments, {}, {});
+  }
+  bool ConvertWithContext(const ConversionOptions& options, Segments* segments,
+                          std::string_view, std::string_view) const override {
+    std::unique_lock lock(gate_->mutex);
+    gate_->entered = true;
+    gate_->speculative = options.incognito_mode && !options.enable_user_history_for_conversion;
+    gate_->ready.notify_all();
+    if (!gate_->ready.wait_for(lock, std::chrono::seconds(5), [&] { return gate_->released; }) ||
+        segments->conversion_segments_size() != 1 ||
+        segments->conversion_segment(0).key() != kReading) return false;
+    auto* candidate = segments->mutable_conversion_segment(0)->add_candidate();
+    candidate->key = candidate->content_key = kReading;
+    candidate->value = candidate->content_value = kManual;
+    candidate->lid = gate_->lid;
+    candidate->rid = gate_->rid;
+    candidate->consumed_key_size = Util::CharsLen(kReading);
+    candidate->inner_segment_boundary = {
+        converter::EncodeLengths(sizeof(kReading)-1, sizeof(kManual)-1,
+                                 sizeof(kReading)-1, sizeof(kManual)-1).value()};
+    return true;
+  }
+ private:
+  const std::shared_ptr<Gate> gate_;
+};
+using Rows = std::vector<std::pair<uint64_t, std::string>>;
+class AsyncFullSpanHistory : public testing::TestWithTempUserProfile {
